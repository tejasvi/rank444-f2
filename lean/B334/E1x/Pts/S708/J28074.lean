/-! # Jobs 28074 … 28075 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J28074 "../data/j28074.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_28074 (k : Nat) : List Nat :=
  cond (Nat.blt k 28075) ([J28074.L0]) ([J28074.L1])
def JW_28074 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 28075) ([[]]) ([[]])

end

theorem jr_28074 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_28074 k) (JW_28074 k)) 28074 2 = true := by
  decide +kernel

theorem jm_28074 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_28074 k) (JW_28074 k)) 28074 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_28074 k) (JW_28074 k)) 28074 2 = true := jr_28074
  exact h0

end B334.E1x.Pts.S708
