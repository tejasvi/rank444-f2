import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 25618 … 25621 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J25618 "../data/j25618.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_25618 (k : Nat) : List Nat :=
  cond (Nat.blt k 25620) (cond (Nat.blt k 25619) ([J25618.L0]) ([J25618.L1])) (cond (Nat.blt k 25621) ([J25618.L2]) ([J25618.L3]))
def JW_25618 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 25620) (cond (Nat.blt k 25619) ([[]]) ([[]])) (cond (Nat.blt k 25621) ([[]]) ([[]]))

end

theorem jr_25618 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25618 k) (JW_25618 k)) 25618 4 = true := by
  decide +kernel

theorem jm_25618 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25618 k) (JW_25618 k)) 25618 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25618 k) (JW_25618 k)) 25618 4 = true := jr_25618
  exact h0

end B334.E1x.Pts.S708
