import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 245 … 247 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J245 "../data/j245.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_245 (k : Nat) : List Nat :=
  cond (Nat.blt k 246) ([J245.L0]) (cond (Nat.blt k 247) ([J245.L1]) ([J245.L2]))
def JW_245 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 246) ([[]]) (cond (Nat.blt k 247) ([[]]) ([[]]))

end

theorem jr_245 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_245 k) (JW_245 k)) 245 3 = true := by
  decide +kernel

theorem jm_245 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_245 k) (JW_245 k)) 245 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_245 k) (JW_245 k)) 245 3 = true := jr_245
  exact h0

end B334.E1x.Pts.S708
