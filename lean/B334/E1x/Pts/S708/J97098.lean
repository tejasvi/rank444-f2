import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 97098 … 97099 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J97098 "../data/j97098.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_97098 (k : Nat) : List Nat :=
  cond (Nat.blt k 97099) ([J97098.L0]) ([J97098.L1])
def JW_97098 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 97099) ([[]]) ([[]])

end

theorem jr_97098 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_97098 k) (JW_97098 k)) 97098 2 = true := by
  decide +kernel

theorem jm_97098 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_97098 k) (JW_97098 k)) 97098 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_97098 k) (JW_97098 k)) 97098 2 = true := jr_97098
  exact h0

end B334.E1x.Pts.S708
