/-! # Jobs 4539 … 4541 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J4539 "../data/j4539.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_4539 (k : Nat) : List Nat :=
  cond (Nat.blt k 4540) ([J4539.L0]) (cond (Nat.blt k 4541) ([J4539.L1]) ([J4539.L2]))
def JW_4539 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 4540) ([[]]) (cond (Nat.blt k 4541) ([[]]) ([[]]))

end

theorem jr_4539 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_4539 k) (JW_4539 k)) 4539 1 = true := by
  decide +kernel
theorem jr_4540 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_4539 k) (JW_4539 k)) 4540 1 = true := by
  decide +kernel
theorem jr_4541 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_4539 k) (JW_4539 k)) 4541 1 = true := by
  decide +kernel

end B334.E1x.Pts.S707
