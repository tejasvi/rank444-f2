/-! # Jobs 24251 … 24252 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J24251 "../data/j24251.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_24251 (k : Nat) : List Nat :=
  cond (Nat.blt k 24252) ([J24251.L0]) ([J24251.L1])
def JW_24251 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 24252) ([[]]) ([[]])

end

theorem jr_24251 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_24251 k) (JW_24251 k)) 24251 2 = true := by
  decide +kernel

theorem jm_24251 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_24251 k) (JW_24251 k)) 24251 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_24251 k) (JW_24251 k)) 24251 2 = true := jr_24251
  exact h0

end B334.E1x.Pts.S708
