import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 22054 … 22057 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J22054 "../data/j22054.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_22054 (k : Nat) : List Nat :=
  cond (Nat.blt k 22056) (cond (Nat.blt k 22055) ([J22054.L0]) ([J22054.L1])) (cond (Nat.blt k 22057) ([J22054.L2]) ([J22054.L3]))
def JW_22054 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 22056) (cond (Nat.blt k 22055) ([[]]) ([[]])) (cond (Nat.blt k 22057) ([[]]) ([[]]))

end

theorem jr_22054 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_22054 k) (JW_22054 k)) 22054 4 = true := by
  decide +kernel

theorem jm_22054 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_22054 k) (JW_22054 k)) 22054 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_22054 k) (JW_22054 k)) 22054 4 = true := jr_22054
  exact h0

end B334.E1x.Pts.S708
