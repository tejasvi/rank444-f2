/-! # Jobs 10251 … 10251 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J10251 "../data/j10251.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_10251 (k : Nat) : List Nat :=
  [J10251.L0]
def JW_10251 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_10251 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_10251 k) (JW_10251 k)) 10251 1 = true := by
  decide +kernel

theorem jm_10251 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_10251 k) (JW_10251 k)) 10251 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_10251 k) (JW_10251 k)) 10251 1 = true := jr_10251
  exact h0

end B334.E1x.Pts.S708
