/-! # Jobs 74808 … 74810 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J74808 "../data/j74808.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_74808 (k : Nat) : List Nat :=
  cond (Nat.blt k 74809) ([J74808.L0]) (cond (Nat.blt k 74810) ([J74808.L1, J74808.L2, J74808.L3, J74808.L4, J74808.L5, J74808.L6]) ([J74808.L7]))
def JW_74808 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 74809) ([[]]) (cond (Nat.blt k 74810) ([[1, 2, 3, 4, 5], [], [], [], [], []]) ([[]]))

end

theorem jr_74808 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_74808 k) (JW_74808 k)) 74808 3 = true := by
  decide +kernel

theorem jm_74808 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_74808 k) (JW_74808 k)) 74808 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_74808 k) (JW_74808 k)) 74808 3 = true := jr_74808
  exact h0

end B334.E1x.Pts.S708
