import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 294 … 297 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J294 "../data/j294.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_294 (k : Nat) : List Nat :=
  cond (Nat.blt k 296) (cond (Nat.blt k 295) ([J294.L0]) ([J294.L1])) (cond (Nat.blt k 297) ([J294.L2]) ([J294.L3]))
def JW_294 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 296) (cond (Nat.blt k 295) ([[]]) ([[]])) (cond (Nat.blt k 297) ([[]]) ([[]]))

end

theorem jr_294 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_294 k) (JW_294 k)) 294 4 = true := by
  decide +kernel

end B334.E1x.Pts.S707
