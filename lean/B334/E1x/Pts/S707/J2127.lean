/-! # Jobs 2127 … 2127 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J2127 "../data/j2127.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_2127 (k : Nat) : List Nat :=
  [J2127.L0]
def JW_2127 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_2127 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_2127 k) (JW_2127 k)) 2127 1 = true := by
  decide +kernel

end B334.E1x.Pts.S707
