# mk_lfb_kls.awk: the LfB module of a run whose T2 list T2.leaves_<c> is long, reading each leaf's
# record through the K-module lists instead of walking T2.leaves_<c> (for R619, whose leaf modules Lf43 and later needed more than 15 GB).
# Input: lines "name start len" in the order of T2.leaves_<c>'s concatenation (name = kl_<c>_<k> or nl_<c>).
# Variables: -v NS=R619 -v C=619 -v GEN="generated by a script" (the text in the docstring). Output: the Lean module on stdout.
BEGIN { n = 0 }
{ nm[n] = $1; st[n] = $2; ln[n] = $3; n++ }
function tree(lo, hi,   mid) {
  if (hi - lo == 1) return "(" lo ", i - " st[lo] ")"
  mid = int((lo + hi) / 2)
  return "cond (Nat.blt i " st[mid] ") (" tree(lo, mid) ") (" tree(mid, hi) ")"
}
END {
  print "import B334.E1x." NS ".Data"
  print "import B334.E1x.G.Bridge2"
  print "import B334.T2.Index"
  print "import B334.BCP.PermL"
  print "import B334.E1x.IPChk"
  print ""
  print "set_option maxRecDepth 100000"
  print ""
  print "/-! # The per-leaf check of `" NS "` (" GEN "): leaf `q = (pl, i)` is covered by record `i` of `T2.leaves_" C "`"
  print "with the identity permutation, read as record `j` of the `k`-th list of the concatenation that defines"
  print "`T2.leaves_" C "` (`kj i = (k, j)`; " n " lists). Walking `T2.leaves_" C "` itself costs the kernel up to `i` steps per"
  print "leaf (R619/Lf43 and later went over 15 GB); here a leaf costs at most about " n " + the longest list's length. -/"
  print ""
  print "namespace B334.E1x." NS
  print "open B334.E1x.E1GS"
  print ""
  print "/-- the lists of `T2.leaves_" C "`, in order -/"
  s = ""
  for (k = 0; k < n; k++) s = s (k ? ", " : "") "T2." nm[k]
  print "def KLS : List (List Nat) := [" s "]"
  print ""
  print "/-- leaf index `i` of `T2.leaves_" C "` as (list `k` of `KLS`, index inside it) -/"
  print "def kj (i : Nat) : Nat × Nat :="
  print "  " tree(0, n)
  print ""
  print "noncomputable def leafB (q : Nat × Nat) : Bool :="
  print "  Nat.blt (kj q.2).2 (KLS.getD (kj q.2).1 []).length &&"
  print "    B334.BCP.t2match ((KLS.getD (kj q.2).1 []).getD (kj q.2).2 0) (termsOf R VT q.1) R DOM (List.range R)"
  print ""
  print "theorem klsOK : ∀ L ∈ KLS, ∀ R ∈ L, B334.BC.leafS R = true := by"
  print "  unfold KLS"
  s = ""; e = ""
  for (k = 0; k < n; k++) { s = s "List.forall_mem_cons.mpr ⟨T2." nm[k] "_ok, "; e = e "⟩" }
  print "  exact " s "List.forall_mem_nil _" e
  print ""
  print "theorem klsGetOK (k : Nat) : ∀ R ∈ KLS.getD k [], B334.BC.leafS R = true := by"
  print "  intro R hR"
  print "  by_cases hk : k < KLS.length"
  print "  · rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hk, Option.getD_some] at hR"
  print "    exact klsOK _ (List.getElem_mem hk) R hR"
  print "  · rw [List.getD_eq_getElem?_getD, List.getElem?_eq_none (by omega), Option.getD_none] at hR"
  print "    simp at hR"
  print ""
  print "theorem getD_mem {L : List Nat} {j : Nat} (h : j < L.length) : L.getD j 0 ∈ L := by"
  print "  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h, Option.getD_some]"
  print "  exact List.getElem_mem h"
  print ""
  print "end B334.E1x." NS
}
