  cond (Nat.blt k 42003) (cond (Nat.blt k 42001) ([J42000.L0]) (cond (Nat.blt k 42002) ([J42000.L1]) ([J42000.L2, J42000.L3, J42000.L4, J42000.L5, J42000.L6, J42000.L7, J42000.L8]))) (cond (Nat.blt k 42005) (cond (Nat.blt k 42004) ([J42000.L9]) ([J42000.L10])) (cond (Nat.blt k 42006) ([J42000.L11]) ([J42000.L12])))
def JW_42000 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 42003) (cond (Nat.blt k 42001) ([[]]) (cond (Nat.blt k 42002) ([[]]) ([[1, 2, 3, 4, 5, 6], [], [], [], [], [], []]))) (cond (Nat.blt k 42005) (cond (Nat.blt k 42004) ([[]]) ([[]])) (cond (Nat.blt k 42006) ([[]]) ([[]])))

end

theorem jr_42000 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_42000 k) (JW_42000 k)) 42000 7 = true := by
