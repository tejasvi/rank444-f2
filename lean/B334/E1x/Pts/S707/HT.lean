import B334.E1x.Load

/-! # Tables of the point run `S707` (generated by a script; binary files in the stage's `data/`)

* `HT.entry k`: the `14 + 8 d`-bit header of job `k`'s first piece (7279 jobs; 27-byte entries).
* `Wf i j`: the glue witness of header record `j` of top-chain block `i` (`OF`: per block the offset of its first
  record in `WT`; a witness `w < 789` is a later top-chain block, `w - 789` a job). -/

#rttablew B334.E1x.Pts.S707.HT "../data707/ht.bin" 64 216
#rttablew B334.E1x.Pts.S707.OF "../data707/top_of.bin" 64 32
#rttablew B334.E1x.Pts.S707.WT "../data707/top_wt.bin" 64 32

namespace B334.E1x.Pts.S707

noncomputable section

def nJ : Nat := 7279
def NT : Nat := 789
def Wf (i j : Nat) : Nat := WT.entry (OF.entry i + j)

end

end B334.E1x.Pts.S707
