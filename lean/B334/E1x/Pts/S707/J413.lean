/-! # Jobs 413 … 418 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J413 "../data/j413.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_413 (k : Nat) : List Nat :=
  cond (Nat.blt k 416) (cond (Nat.blt k 414) ([J413.L0]) (cond (Nat.blt k 415) ([J413.L1]) ([J413.L2]))) (cond (Nat.blt k 417) ([J413.L3]) (cond (Nat.blt k 418) ([J413.L4]) ([J413.L5])))
def JW_413 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 416) (cond (Nat.blt k 414) ([[]]) (cond (Nat.blt k 415) ([[]]) ([[]]))) (cond (Nat.blt k 417) ([[]]) (cond (Nat.blt k 418) ([[]]) ([[]])))

end

theorem jr_413 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_413 k) (JW_413 k)) 413 6 = true := by
  decide +kernel

end B334.E1x.Pts.S707
