def JW_1557 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1559) (cond (Nat.blt k 1558) ([[]]) ([[]])) (cond (Nat.blt k 1560) ([[]]) (cond (Nat.blt k 1561) ([[]]) ([[]])))

end

theorem jr_1557 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1557 k) (JW_1557 k)) 1557 5 = true := by
  decide +kernel

theorem jm_1557 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1557 k) (JW_1557 k)) 1557 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1557 k) (JW_1557 k)) 1557 5 = true := jr_1557
