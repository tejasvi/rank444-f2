/-! # Jobs 102433 … 102437 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J102433 "../data/j102433.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_102433 (k : Nat) : List Nat :=
  cond (Nat.blt k 102435) (cond (Nat.blt k 102434) ([J102433.L0]) ([J102433.L1])) (cond (Nat.blt k 102436) ([J102433.L2]) (cond (Nat.blt k 102437) ([J102433.L3]) ([J102433.L4])))
def JW_102433 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 102435) (cond (Nat.blt k 102434) ([[]]) ([[]])) (cond (Nat.blt k 102436) ([[]]) (cond (Nat.blt k 102437) ([[]]) ([[]])))

end

theorem jr_102433 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_102433 k) (JW_102433 k)) 102433 5 = true := by
  decide +kernel

theorem jm_102433 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_102433 k) (JW_102433 k)) 102433 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_102433 k) (JW_102433 k)) 102433 5 = true := jr_102433
  exact h0

end B334.E1x.Pts.S708
