import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 21599 … 21602 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J21599 "../data/j21599.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_21599 (k : Nat) : List Nat :=
  cond (Nat.blt k 21601) (cond (Nat.blt k 21600) ([J21599.L0]) ([J21599.L1])) (cond (Nat.blt k 21602) ([J21599.L2]) ([J21599.L3]))
def JW_21599 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 21601) (cond (Nat.blt k 21600) ([[]]) ([[]])) (cond (Nat.blt k 21602) ([[]]) ([[]]))

end

theorem jr_21599 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_21599 k) (JW_21599 k)) 21599 4 = true := by
  decide +kernel

theorem jm_21599 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_21599 k) (JW_21599 k)) 21599 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_21599 k) (JW_21599 k)) 21599 4 = true := jr_21599
  exact h0

end B334.E1x.Pts.S708
