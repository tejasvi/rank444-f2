import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 122099 … 122101 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J122099 "../data/j122099.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_122099 (k : Nat) : List Nat :=
  cond (Nat.blt k 122100) ([J122099.L0]) (cond (Nat.blt k 122101) ([J122099.L1]) ([J122099.L2]))
def JW_122099 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 122100) ([[]]) (cond (Nat.blt k 122101) ([[]]) ([[]]))

end

theorem jr_122099 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_122099 k) (JW_122099 k)) 122099 3 = true := by
  decide +kernel

theorem jm_122099 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_122099 k) (JW_122099 k)) 122099 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_122099 k) (JW_122099 k)) 122099 3 = true := jr_122099
  exact h0

end B334.E1x.Pts.S708
