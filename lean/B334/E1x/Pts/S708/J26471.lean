/-! # Jobs 26471 … 26472 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J26471 "../data/j26471.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_26471 (k : Nat) : List Nat :=
  cond (Nat.blt k 26472) ([J26471.L0]) ([J26471.L1])
def JW_26471 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 26472) ([[]]) ([[]])

end

theorem jr_26471 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_26471 k) (JW_26471 k)) 26471 2 = true := by
  decide +kernel

theorem jm_26471 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_26471 k) (JW_26471 k)) 26471 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_26471 k) (JW_26471 k)) 26471 2 = true := jr_26471
  exact h0

end B334.E1x.Pts.S708
