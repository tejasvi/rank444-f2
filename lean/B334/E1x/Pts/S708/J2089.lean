import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2089 … 2092 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J2089 "../data/j2089.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_2089 (k : Nat) : List Nat :=
  cond (Nat.blt k 2091) (cond (Nat.blt k 2090) ([J2089.L0]) ([J2089.L1])) (cond (Nat.blt k 2092) ([J2089.L2]) ([J2089.L3]))
def JW_2089 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2091) (cond (Nat.blt k 2090) ([[]]) ([[]])) (cond (Nat.blt k 2092) ([[]]) ([[]]))

end

theorem jr_2089 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2089 k) (JW_2089 k)) 2089 4 = true := by
  decide +kernel

theorem jm_2089 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2089 k) (JW_2089 k)) 2089 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2089 k) (JW_2089 k)) 2089 4 = true := jr_2089
  exact h0

end B334.E1x.Pts.S708
