theorem jrJ_0 : ∀ k, 0 ≤ k → k < 24 → JobOK C sl UB (HT.entry k) :=
  GJ.jobs_of_allR C sl UB UBR UB_eq UBR_eq UB_le HT.entry JL_0 JW_0 0 24 jr_0
theorem jrJ_1 : ∀ k, 24 ≤ k → k < 25 → JobOK C sl UB (HT.entry k) := by
  have hb : IPChk.allR (fun i => E1G.block C sl UB UBR (K24.lits.getD i 0)) 0 4 = true := by
    have h0 : IPChk.allR (fun i => E1G.block C sl UB UBR (K24.lits.getD i 0)) 0 2 = true := kb_24_0
    have h1 : IPChk.allR (fun i => E1G.block C sl UB UBR (K24.lits.getD i 0)) 0 3 = true := IPChk.allR_join (fun i => E1G.block C sl UB UBR (K24.lits.getD i 0)) 0 2 1 h0 kb_24_2
    have h2 : IPChk.allR (fun i => E1G.block C sl UB UBR (K24.lits.getD i 0)) 0 4 = true := IPChk.allR_join (fun i => E1G.block C sl UB UBR (K24.lits.getD i 0)) 0 3 1 h1 kb_24_3
    exact h2
  have hg : IPChk.allR (GJ.glueIB K24.lits KW_24) 0 4 = true := by
    have h0 : IPChk.allR (GJ.glueIB K24.lits KW_24) 0 2 = true := kg_24_0
    have h1 : IPChk.allR (GJ.glueIB K24.lits KW_24) 0 3 = true := IPChk.allR_join (GJ.glueIB K24.lits KW_24) 0 2 1 h0 kg_24_2
    have h2 : IPChk.allR (GJ.glueIB K24.lits KW_24) 0 4 = true := IPChk.allR_join (GJ.glueIB K24.lits KW_24) 0 3 1 h1 kg_24_3
    exact h2
  have hlen : K24.lits.length = 4 := by decide +kernel
  intro k h1 h2
  obtain rfl : k = 24 := by omega
  exact GJ.jobOK_of_parts C sl UB UBR UB_eq UBR_eq UB_le (HT.entry 24) K24.lits KW_24
    (by rw [hlen]; decide +kernel) (by rw [hlen]; exact hb) (by rw [hlen]; exact hg) (by decide +kernel)
    (by decide +kernel)
