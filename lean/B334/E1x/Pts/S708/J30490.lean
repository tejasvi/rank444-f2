import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 30490 … 30493 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J30490 "../data/j30490.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_30490 (k : Nat) : List Nat :=
  cond (Nat.blt k 30492) (cond (Nat.blt k 30491) ([J30490.L0]) ([J30490.L1])) (cond (Nat.blt k 30493) ([J30490.L2]) ([J30490.L3]))
def JW_30490 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 30492) (cond (Nat.blt k 30491) ([[]]) ([[]])) (cond (Nat.blt k 30493) ([[]]) ([[]]))

end

theorem jr_30490 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_30490 k) (JW_30490 k)) 30490 4 = true := by
  decide +kernel

theorem jm_30490 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_30490 k) (JW_30490 k)) 30490 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_30490 k) (JW_30490 k)) 30490 4 = true := jr_30490
  exact h0

end B334.E1x.Pts.S708
