import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 28070 … 28072 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J28070 "../data/j28070.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_28070 (k : Nat) : List Nat :=
  cond (Nat.blt k 28071) ([J28070.L0]) (cond (Nat.blt k 28072) ([J28070.L1]) ([J28070.L2]))
def JW_28070 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 28071) ([[]]) (cond (Nat.blt k 28072) ([[]]) ([[]]))

end

theorem jr_28070 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_28070 k) (JW_28070 k)) 28070 3 = true := by
  decide +kernel

theorem jm_28070 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_28070 k) (JW_28070 k)) 28070 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_28070 k) (JW_28070 k)) 28070 3 = true := jr_28070
  exact h0

end B334.E1x.Pts.S708
