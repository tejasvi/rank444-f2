theorem enum : ∀ x : ℕ → ℕ, Glob C x → (∀ i < 2 ^ 15, SlotV x (sl i)) →
    (∀ l < 127, x l ≤ E1G.fld UB l) → (∃ l < 127, 0 < x l) → False :=
  enum_of_chain_w C sl UB UBR UB_eq UBR_eq UB_le Top.lits nJ HT.entry Wf (by rw [topLen]; decide) hroot
    (blkChk_spec C sl UB UBR Top.lits Top.lits.length (by rw [GJ.blk_eq, topLen]; exact topBlk))
    (by rw [GJ.glueChkW_eq, topLen]; exact topGlue) hjobs

theorem leafAll : IPChk.allR (fun k => leafB (LI.getD k (0, 0))) 0 259 = true := by
  have h0 : IPChk.allR (fun k => leafB (LI.getD k (0, 0))) 0 100 = true := lf_0
  have h1 : IPChk.allR (fun k => leafB (LI.getD k (0, 0))) 0 200 = true := IPChk.allR_join (fun k => leafB (LI.getD k (0, 0))) 0 100 100 h0 lf_100
  have h2 : IPChk.allR (fun k => leafB (LI.getD k (0, 0))) 0 259 = true := IPChk.allR_join (fun k => leafB (LI.getD k (0, 0))) 0 200 59 h1 lf_200
  exact h2

theorem hLF : ∀ pl, C.LF pl = true → B334.BCP.NoDecomp (termsOf C.R C.VT pl) C.R C.DOM := by
  intro pl h
  change LI.any (fun q => Nat.beq q.1 pl) = true at h
  obtain ⟨q, hq, hqe⟩ := List.any_eq_true.mp h
  obtain ⟨k, hk, hkq⟩ := List.mem_iff_getElem.mp hq
  have hlen : LI.length = 259 := by decide
  have hc : leafB (LI.getD k (0, 0)) = true := IPChk.allR_spec0 leafAll k (by rw [← hlen]; exact hk)
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hk, Option.getD_some, hkq] at hc
  unfold leafB at hc
  simp only [Bool.and_eq_true, Nat.blt_eq] at hc
  have hm : T2.leaves_680.getD q.2 0 ∈ T2.leaves_680 := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hc.1, Option.getD_some]
    exact List.getElem_mem hc.1
  rw [← Nat.eq_of_beq_eq_true hqe]
  exact B334.BCP.noDecomp_of_t2 (List.range R) hc.2 (T2.ok_680 _ hm)

theorem concl (hhi : Tab2.HighHyp 680) : E1Concl Em 23 :=
  GJ.e1_sound_enum C Em LB LBR UB UBR Ntab nrows sl tab GE ipok (rows hhi) hLF enum

theorem one_ok : oneOK Em 10 = true := by decide +kernel
theorem em_ok : emOK Em (Tab2.basisOf 680) = true := by decide +kernel
theorem lb_eq : Tab2.lbOf 680 = 23 + 1 := by decide

/-- **The run of class 680** -/
theorem run_680 (hhi : Tab2.HighHyp 680) : RowValid (Tab2.basisOf 680) (Tab2.lbOf 680) := by
  rw [lb_eq]
  exact rowValid_of_e1 (ClsChk.basis_lt 680 (by decide)) (concl hhi) one_ok em_ok

/-- the run in the dispatcher's list form -/
theorem runsFor : Tab2.RunsFor [680] := fun c hc hhi => by
  rw [List.mem_singleton] at hc
  subst hc
  exact run_680 hhi

end B334.E1x.R680
