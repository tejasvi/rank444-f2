/-! # Jobs 1260 … 1264 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J1260 "../data/j1260.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_1260 (k : Nat) : List Nat :=
  cond (Nat.blt k 1262) (cond (Nat.blt k 1261) ([J1260.L0]) ([J1260.L1])) (cond (Nat.blt k 1263) ([J1260.L2]) (cond (Nat.blt k 1264) ([J1260.L3]) ([J1260.L4])))
def JW_1260 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1262) (cond (Nat.blt k 1261) ([[]]) ([[]])) (cond (Nat.blt k 1263) ([[]]) (cond (Nat.blt k 1264) ([[]]) ([[]])))

end

theorem jr_1260 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_1260 k) (JW_1260 k)) 1260 5 = true := by
  decide +kernel

end B334.E1x.Pts.S707
