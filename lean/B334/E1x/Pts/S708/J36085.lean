import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 36085 … 36089 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J36085 "../data/j36085.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_36085 (k : Nat) : List Nat :=
  cond (Nat.blt k 36087) (cond (Nat.blt k 36086) ([J36085.L0]) ([J36085.L1])) (cond (Nat.blt k 36088) ([J36085.L2]) (cond (Nat.blt k 36089) ([J36085.L3]) ([J36085.L4])))
def JW_36085 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 36087) (cond (Nat.blt k 36086) ([[]]) ([[]])) (cond (Nat.blt k 36088) ([[]]) (cond (Nat.blt k 36089) ([[]]) ([[]])))

end

theorem jr_36085 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_36085 k) (JW_36085 k)) 36085 5 = true := by
  decide +kernel

theorem jm_36085 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_36085 k) (JW_36085 k)) 36085 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_36085 k) (JW_36085 k)) 36085 5 = true := jr_36085
  exact h0

end B334.E1x.Pts.S708
