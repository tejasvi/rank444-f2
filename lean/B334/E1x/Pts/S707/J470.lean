import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 470 … 470 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J470 "../data/j470.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_470 (k : Nat) : List Nat :=
  [J470.L0]
def JW_470 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_470 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_470 k) (JW_470 k)) 470 1 = true := by
  decide +kernel

end B334.E1x.Pts.S707
