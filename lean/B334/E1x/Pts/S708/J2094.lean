import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2094 … 2095 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J2094 "../data/j2094.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_2094 (k : Nat) : List Nat :=
  cond (Nat.blt k 2095) ([J2094.L0]) ([J2094.L1])
def JW_2094 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2095) ([[]]) ([[]])

end

theorem jr_2094 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2094 k) (JW_2094 k)) 2094 2 = true := by
  decide +kernel

theorem jm_2094 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2094 k) (JW_2094 k)) 2094 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2094 k) (JW_2094 k)) 2094 2 = true := jr_2094
  exact h0

end B334.E1x.Pts.S708
