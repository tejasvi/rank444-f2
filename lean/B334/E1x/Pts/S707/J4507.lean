/-! # Jobs 4507 … 4510 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J4507 "../data/j4507.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_4507 (k : Nat) : List Nat :=
  cond (Nat.blt k 4509) (cond (Nat.blt k 4508) ([J4507.L0]) ([J4507.L1])) (cond (Nat.blt k 4510) ([J4507.L2]) ([J4507.L3]))
def JW_4507 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 4509) (cond (Nat.blt k 4508) ([[]]) ([[]])) (cond (Nat.blt k 4510) ([[]]) ([[]]))

end

theorem jr_4507 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_4507 k) (JW_4507 k)) 4507 4 = true := by
  decide +kernel

end B334.E1x.Pts.S707
