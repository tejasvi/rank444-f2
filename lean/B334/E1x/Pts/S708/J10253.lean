/-! # Jobs 10253 … 10257 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J10253 "../data/j10253.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_10253 (k : Nat) : List Nat :=
  cond (Nat.blt k 10255) (cond (Nat.blt k 10254) ([J10253.L0]) ([J10253.L1])) (cond (Nat.blt k 10256) ([J10253.L2]) (cond (Nat.blt k 10257) ([J10253.L3]) ([J10253.L4])))
def JW_10253 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 10255) (cond (Nat.blt k 10254) ([[]]) ([[]])) (cond (Nat.blt k 10256) ([[]]) (cond (Nat.blt k 10257) ([[]]) ([[]])))

end

theorem jr_10253 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_10253 k) (JW_10253 k)) 10253 5 = true := by
  decide +kernel

theorem jm_10253 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_10253 k) (JW_10253 k)) 10253 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_10253 k) (JW_10253 k)) 10253 5 = true := jr_10253
  exact h0

end B334.E1x.Pts.S708
