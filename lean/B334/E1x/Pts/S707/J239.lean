import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 239 … 242 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J239 "../data/j239.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_239 (k : Nat) : List Nat :=
  cond (Nat.blt k 241) (cond (Nat.blt k 240) ([J239.L0]) ([J239.L1])) (cond (Nat.blt k 242) ([J239.L2]) ([J239.L3]))
def JW_239 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 241) (cond (Nat.blt k 240) ([[]]) ([[]])) (cond (Nat.blt k 242) ([[]]) ([[]]))

end

theorem jr_239 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_239 k) (JW_239 k)) 239 4 = true := by
  decide +kernel

end B334.E1x.Pts.S707
