/-! Joined form: `topBlk`, `topGlue`, `leafAll` and the job facts are the generated
proofs, moved into `TBJ`, `TGJ`, `LfJ` and `G0` … `G12`; plain `decide` is `decide +kernel` throughout. -/

theorem topBlk : IPChk.allR (fun i => E1G.block C sl UB UBR (Top.lits.getD i 0)) 0 NT = true := topBlkJ

theorem topGlue : IPChk.allR (GJ.glueWB Top.lits nJ HT.entry Wf) 0 NT = true := topGlueJ

theorem topLen : Top.lits.length = NT := by decide +kernel
theorem hroot : Top.lits.getD 0 0 % 2 ^ 13 = 0 := by decide +kernel

theorem hjobs : ∀ k < nJ, JobOK C sl UB (HT.entry k) := by
  have a0 := grpJ_0
  have a1 := GJ.fa_join a0 grpJ_1
  have a2 := GJ.fa_join a1 grpJ_2
  have a3 := GJ.fa_join a2 grpJ_3
  have a4 := GJ.fa_join a3 grpJ_4
  have a5 := GJ.fa_join a4 grpJ_5
  have a6 := GJ.fa_join a5 grpJ_6
  have a7 := GJ.fa_join a6 grpJ_7
  have a8 := GJ.fa_join a7 grpJ_8
  have a9 := GJ.fa_join a8 grpJ_9
  have a10 := GJ.fa_join a9 grpJ_10
  have a11 := GJ.fa_join a10 grpJ_11
  have a12 := GJ.fa_join a11 grpJ_12
  exact fun k hk => a12 k (Nat.zero_le k) hk

theorem enum : ∀ x : ℕ → ℕ, Glob C x → (∀ i < 2 ^ 15, SlotV x (sl i)) →
    (∀ l < 127, x l ≤ E1G.fld UB l) → (∃ l < 127, 0 < x l) → False :=
  enum_of_chain_w C sl UB UBR UB_eq UBR_eq UB_le Top.lits nJ HT.entry Wf (by rw [topLen]; decide +kernel) hroot
    (blkChk_spec C sl UB UBR Top.lits Top.lits.length (by rw [GJ.blk_eq, topLen]; exact topBlk))
    (by rw [GJ.glueChkW_eq, topLen]; exact topGlue) hjobs

theorem leafAll : IPChk.allR (fun k => leafB (LI.getD k (0, 0))) 0 5440 = true := leafAllJ

theorem hLF : ∀ pl, C.LF pl = true → B334.BCP.NoDecomp (termsOf C.R C.VT pl) C.R C.DOM := by
  intro pl h
  change LI.any (fun q => Nat.beq q.1 pl) = true at h
  obtain ⟨q, hq, hqe⟩ := List.any_eq_true.mp h
  obtain ⟨k, hk, hkq⟩ := List.mem_iff_getElem.mp hq
  have hlen : LI.length = 5440 := by decide +kernel
  have hc : leafB (LI.getD k (0, 0)) = true := IPChk.allR_spec0 leafAll k (by rw [← hlen]; exact hk)
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hk, Option.getD_some, hkq] at hc
  unfold leafB at hc
  simp only [Bool.and_eq_true, Nat.blt_eq] at hc
  have hm := getD_mem hc.1
  rw [← Nat.eq_of_beq_eq_true hqe]
  exact B334.BCP.noDecomp_of_t2 (List.range R) hc.2 (klsGetOK _ _ hm)

theorem concl (hhi : Tab2.HighHyp 619) : E1Concl Em 23 :=
  GJ.e1_sound_enum C Em LB LBR UB UBR Ntab nrows sl tab GE ipok (rows hhi) hLF enum

theorem one_ok : oneOK Em 4 = true := by decide +kernel
theorem em_ok : emOK Em (Tab2.basisOf 619) = true := by decide +kernel
theorem lb_eq : Tab2.lbOf 619 = 23 + 1 := by decide +kernel

/-- **The run of class 619** -/
theorem run_619 (hhi : Tab2.HighHyp 619) : RowValid (Tab2.basisOf 619) (Tab2.lbOf 619) := by
  rw [lb_eq]
  exact rowValid_of_e1 (ClsChk.basis_lt 619 (by decide +kernel)) (concl hhi) one_ok em_ok

/-- the run in the dispatcher's list form -/
theorem runsFor : Tab2.RunsFor [619] := fun c hc hhi => by
  rw [List.mem_singleton] at hc
  subst hc
  exact run_619 hhi

end B334.E1x.R619
