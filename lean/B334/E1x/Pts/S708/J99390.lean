#e1lits B334.E1x.Pts.S708.J99390 "../data/j99390.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_99390 (k : Nat) : List Nat :=
  cond (Nat.blt k 99391) ([J99390.L0]) ([J99390.L1])
def JW_99390 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 99391) ([[]]) ([[]])

end

theorem jr_99390 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_99390 k) (JW_99390 k)) 99390 2 = true := by
  decide +kernel

theorem jm_99390 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_99390 k) (JW_99390 k)) 99390 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_99390 k) (JW_99390 k)) 99390 2 = true := jr_99390
  exact h0

end B334.E1x.Pts.S708
