import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 6864 … 6864 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J6864 "../data/j6864.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_6864 (k : Nat) : List Nat :=
  [J6864.L0]
def JW_6864 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_6864 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_6864 k) (JW_6864 k)) 6864 1 = true := by
  decide +kernel

theorem jm_6864 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_6864 k) (JW_6864 k)) 6864 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_6864 k) (JW_6864 k)) 6864 1 = true := jr_6864
  exact h0

end B334.E1x.Pts.S708
