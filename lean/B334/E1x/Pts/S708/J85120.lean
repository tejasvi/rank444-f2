import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 85120 … 85122 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J85120 "../data/j85120.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_85120 (k : Nat) : List Nat :=
  cond (Nat.blt k 85121) ([J85120.L0]) (cond (Nat.blt k 85122) ([J85120.L1, J85120.L2, J85120.L3, J85120.L4, J85120.L5, J85120.L6, J85120.L7, J85120.L8, J85120.L9]) ([J85120.L10]))
def JW_85120 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 85121) ([[]]) (cond (Nat.blt k 85122) ([[1, 2, 3, 4, 5, 6, 7, 8], [], [], [], [], [], [], [], []]) ([[]]))

end

theorem jr_85120 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_85120 k) (JW_85120 k)) 85120 3 = true := by
  decide +kernel

theorem jm_85120 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_85120 k) (JW_85120 k)) 85120 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_85120 k) (JW_85120 k)) 85120 3 = true := jr_85120
  exact h0

end B334.E1x.Pts.S708
