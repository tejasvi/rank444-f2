/-! # Jobs 1568 … 1569 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1568 "../data/j1568.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1568 (k : Nat) : List Nat :=
  cond (Nat.blt k 1569) ([J1568.L0]) ([J1568.L1])
def JW_1568 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1569) ([[]]) ([[]])

end

theorem jr_1568 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1568 k) (JW_1568 k)) 1568 2 = true := by
  decide +kernel

theorem jm_1568 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1568 k) (JW_1568 k)) 1568 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1568 k) (JW_1568 k)) 1568 2 = true := jr_1568
  exact h0

end B334.E1x.Pts.S708
