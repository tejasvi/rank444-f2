/-! # Jobs 15991 … 15996 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J15991 "../data/j15991.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_15991 (k : Nat) : List Nat :=
  cond (Nat.blt k 15994) (cond (Nat.blt k 15992) ([J15991.L0]) (cond (Nat.blt k 15993) ([J15991.L1]) ([J15991.L2]))) (cond (Nat.blt k 15995) ([J15991.L3]) (cond (Nat.blt k 15996) ([J15991.L4]) ([J15991.L5])))
def JW_15991 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 15994) (cond (Nat.blt k 15992) ([[]]) (cond (Nat.blt k 15993) ([[]]) ([[]]))) (cond (Nat.blt k 15995) ([[]]) (cond (Nat.blt k 15996) ([[]]) ([[]])))

end

theorem jr_15991 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_15991 k) (JW_15991 k)) 15991 6 = true := by
  decide +kernel

theorem jm_15991 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_15991 k) (JW_15991 k)) 15991 6 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_15991 k) (JW_15991 k)) 15991 6 = true := jr_15991
  exact h0

end B334.E1x.Pts.S708
