import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 3001 … 3002 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J3001 "../data/j3001.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_3001 (k : Nat) : List Nat :=
  cond (Nat.blt k 3002) ([J3001.L0]) ([J3001.L1])
def JW_3001 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 3002) ([[]]) ([[]])

end

theorem jr_3001 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_3001 k) (JW_3001 k)) 3001 2 = true := by
  decide +kernel

theorem jm_3001 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_3001 k) (JW_3001 k)) 3001 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_3001 k) (JW_3001 k)) 3001 2 = true := jr_3001
  exact h0

end B334.E1x.Pts.S708
