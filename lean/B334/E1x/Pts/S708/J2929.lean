#e1lits B334.E1x.Pts.S708.J2929 "../data/j2929.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_2929 (k : Nat) : List Nat :=
  cond (Nat.blt k 2930) ([J2929.L0]) ([J2929.L1])
def JW_2929 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2930) ([[]]) ([[]])

end

theorem jr_2929 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2929 k) (JW_2929 k)) 2929 2 = true := by
  decide +kernel

theorem jm_2929 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2929 k) (JW_2929 k)) 2929 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2929 k) (JW_2929 k)) 2929 2 = true := jr_2929
  exact h0

end B334.E1x.Pts.S708
