import B334.E1x.Load

/-! # Tables of the E1G run `R681` (generated by a script; binary data files)

* `HT.entry k`: the `13 + 7 d`-bit header of job `k`'s first piece (3007 jobs; 24-byte entries).
* `Wf i j`: the glue witness of header record `j` of top-chain block `i` (`OF`: per block the offset of its first
  record in `WT`; a witness `w < 75` is a later top-chain block, `w - 75` a job). -/

#rttablew B334.E1x.R681.HT "../runs/runmulti2/R681_ht.bin" 64 192
#rttablew B334.E1x.R681.OF "../runs/runmulti2/R681_top_of.bin" 64 32
#rttablew B334.E1x.R681.WT "../runs/runmulti2/R681_top_wt.bin" 64 32

namespace B334.E1x.R681

noncomputable section

def nJ : Nat := 3007
def NT : Nat := 75
def Wf (i j : Nat) : Nat := WT.entry (OF.entry i + j)

end

end B334.E1x.R681
