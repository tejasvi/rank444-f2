import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1908 … 1911 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1908 "../data/j1908.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1908 (k : Nat) : List Nat :=
  cond (Nat.blt k 1910) (cond (Nat.blt k 1909) ([J1908.L0]) ([J1908.L1])) (cond (Nat.blt k 1911) ([J1908.L2]) ([J1908.L3]))
def JW_1908 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1910) (cond (Nat.blt k 1909) ([[]]) ([[]])) (cond (Nat.blt k 1911) ([[]]) ([[]]))

end

theorem jr_1908 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1908 k) (JW_1908 k)) 1908 4 = true := by
  decide +kernel

theorem jm_1908 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1908 k) (JW_1908 k)) 1908 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1908 k) (JW_1908 k)) 1908 4 = true := jr_1908
  exact h0

end B334.E1x.Pts.S708
