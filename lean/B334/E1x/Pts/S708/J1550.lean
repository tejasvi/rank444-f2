import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1550 … 1553 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1550 "../data/j1550.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1550 (k : Nat) : List Nat :=
  cond (Nat.blt k 1552) (cond (Nat.blt k 1551) ([J1550.L0]) ([J1550.L1])) (cond (Nat.blt k 1553) ([J1550.L2]) ([J1550.L3]))
def JW_1550 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1552) (cond (Nat.blt k 1551) ([[]]) ([[]])) (cond (Nat.blt k 1553) ([[]]) ([[]]))

end

theorem jr_1550 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1550 k) (JW_1550 k)) 1550 4 = true := by
  decide +kernel

theorem jm_1550 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1550 k) (JW_1550 k)) 1550 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1550 k) (JW_1550 k)) 1550 4 = true := jr_1550
  exact h0

end B334.E1x.Pts.S708
