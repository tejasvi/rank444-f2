import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 5100 … 5104 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J5100 "../data/j5100.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_5100 (k : Nat) : List Nat :=
  cond (Nat.blt k 5102) (cond (Nat.blt k 5101) ([J5100.L0]) ([J5100.L1])) (cond (Nat.blt k 5103) ([J5100.L2]) (cond (Nat.blt k 5104) ([J5100.L3]) ([J5100.L4])))
def JW_5100 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 5102) (cond (Nat.blt k 5101) ([[]]) ([[]])) (cond (Nat.blt k 5103) ([[]]) (cond (Nat.blt k 5104) ([[]]) ([[]])))

end

theorem jr_5100 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_5100 k) (JW_5100 k)) 5100 5 = true := by
  decide +kernel

theorem jm_5100 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_5100 k) (JW_5100 k)) 5100 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_5100 k) (JW_5100 k)) 5100 5 = true := jr_5100
  exact h0

end B334.E1x.Pts.S708
