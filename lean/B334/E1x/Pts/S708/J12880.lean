def JW_12880 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 12882) (cond (Nat.blt k 12881) ([[]]) ([[]])) (cond (Nat.blt k 12883) ([[]]) (cond (Nat.blt k 12884) ([[]]) ([[]])))

end

theorem jr_12880 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12880 k) (JW_12880 k)) 12880 5 = true := by
  decide +kernel

theorem jm_12880 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12880 k) (JW_12880 k)) 12880 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12880 k) (JW_12880 k)) 12880 5 = true := jr_12880
