end

theorem jr_3257 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_3257 k) (JW_3257 k)) 3257 2 = true := by
  decide +kernel

theorem jm_3257 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_3257 k) (JW_3257 k)) 3257 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_3257 k) (JW_3257 k)) 3257 2 = true := jr_3257
