import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2129 … 2130 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J2129 "../data/j2129.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_2129 (k : Nat) : List Nat :=
  cond (Nat.blt k 2130) ([J2129.L0]) ([J2129.L1])
def JW_2129 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2130) ([[]]) ([[]])

end

theorem jr_2129 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_2129 k) (JW_2129 k)) 2129 2 = true := by
  decide +kernel

end B334.E1x.Pts.S707
