import B334.E1x.I693t.OK
import B334.E1x.Rep693d
import B334.E1x.Bridge
import B334.Tab2.Dispatch

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # The run of class 693 (R = 23): `E1Concl Em 23` and its row (generated by a script)

The block literal is `Rep693d.S` (converter v0 on the run's trace: one block, no glue, no leaves). It is replayed here
against the IP's own slot function `sl` (slots from the row-table entries). With `ipok` and `rows`, `E1GS.e1_sound`
gives `E1Concl Em 23`; `rowValid_of_e1` (padding, `oneOK`, `emOK`) then gives the class's row at `lbOf 693 = 24`.
`run_693 : Tab2.HighHyp 693 → RowValid (Tab2.basisOf 693) (Tab2.lbOf 693)` is the form `Tab2/Dispatch.lean` takes. -/

namespace B334.E1x.I693t
open B334.E1x.E1GS

theorem blk : E1G.block C sl UB UBR Rep693d.S = true := by decide +kernel
theorem root : Rep693d.S % 2 ^ 13 = 0 := by decide +kernel
theorem noglue : E1G.rd 8 (E1G.bS2 Rep693d.S) = 0 := by decide +kernel

theorem concl (hhi : Tab2.HighHyp 693) : E1Concl Em 23 :=
  e1_sound C Em LB LBR UB UBR Ntab nrows sl tab GE ipok (rows hhi) (fun _ h => by simp [C, LFn] at h)
    [Rep693d.S] (by decide) root
    (fun i hi => by
      have hi0 : i = 0 := by simp at hi; omega
      subst hi0
      exact blk)
    (fun i hi j hj => by
      have hi0 : i = 0 := by simp at hi; omega
      subst hi0
      have h0 : E1G.rd 8 (E1G.bS2 ([Rep693d.S].getD 0 0)) = 0 := noglue
      exact absurd hj (by rw [h0]; exact Nat.not_lt_zero j))

theorem one_ok : oneOK Em 2 = true := by decide +kernel
theorem em_ok : emOK Em (Tab2.basisOf 693) = true := by decide +kernel
theorem lb_eq : Tab2.lbOf 693 = 23 + 1 := by decide

/-- **The run of class 693** -/
theorem run_693 (hhi : Tab2.HighHyp 693) : RowValid (Tab2.basisOf 693) (Tab2.lbOf 693) := by
  rw [lb_eq]
  exact rowValid_of_e1 (ClsChk.basis_lt 693 (by decide)) (concl hhi) one_ok em_ok

/-- the run in the dispatcher's list form -/
theorem runsFor : Tab2.RunsFor [693] := fun c hc hhi => by
  rw [List.mem_singleton] at hc
  subst hc
  exact run_693 hhi

end B334.E1x.I693t
