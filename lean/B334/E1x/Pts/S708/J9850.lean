import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 9850 … 9854 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J9850 "../data/j9850.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_9850 (k : Nat) : List Nat :=
  cond (Nat.blt k 9852) (cond (Nat.blt k 9851) ([J9850.L0]) ([J9850.L1])) (cond (Nat.blt k 9853) ([J9850.L2]) (cond (Nat.blt k 9854) ([J9850.L3]) ([J9850.L4])))
def JW_9850 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 9852) (cond (Nat.blt k 9851) ([[]]) ([[]])) (cond (Nat.blt k 9853) ([[]]) (cond (Nat.blt k 9854) ([[]]) ([[]])))

end

theorem jr_9850 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_9850 k) (JW_9850 k)) 9850 5 = true := by
  decide +kernel

theorem jm_9850 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_9850 k) (JW_9850 k)) 9850 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_9850 k) (JW_9850 k)) 9850 5 = true := jr_9850
  exact h0

end B334.E1x.Pts.S708
