import B334.E1x.R680.Data
import B334.E1x.R680.HT
import B334.E1x.GJ.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2680 … 2680 of `R680` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.R680.J2680 "../runs/runmulti2/R680_j2680.bin"

namespace B334.E1x.R680

noncomputable section

def JL_2680 (k : Nat) : List Nat :=
  [J2680.L0]
def JW_2680 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_2680 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_2680 k) (JW_2680 k)) 2680 1 = true := by
  decide +kernel

end B334.E1x.R680
