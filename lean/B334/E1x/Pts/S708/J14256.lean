import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 14256 … 14261 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J14256 "../data/j14256.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_14256 (k : Nat) : List Nat :=
  cond (Nat.blt k 14259) (cond (Nat.blt k 14257) ([J14256.L0]) (cond (Nat.blt k 14258) ([J14256.L1]) ([J14256.L2]))) (cond (Nat.blt k 14260) ([J14256.L3]) (cond (Nat.blt k 14261) ([J14256.L4]) ([J14256.L5])))
def JW_14256 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 14259) (cond (Nat.blt k 14257) ([[]]) (cond (Nat.blt k 14258) ([[]]) ([[]]))) (cond (Nat.blt k 14260) ([[]]) (cond (Nat.blt k 14261) ([[]]) ([[]])))

end

theorem jr_14256 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_14256 k) (JW_14256 k)) 14256 6 = true := by
  decide +kernel

theorem jm_14256 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_14256 k) (JW_14256 k)) 14256 6 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_14256 k) (JW_14256 k)) 14256 6 = true := jr_14256
  exact h0

end B334.E1x.Pts.S708
