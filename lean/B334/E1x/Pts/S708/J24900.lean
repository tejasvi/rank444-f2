set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 24900 … 24901 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J24900 "../data/j24900.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_24900 (k : Nat) : List Nat :=
  cond (Nat.blt k 24901) ([J24900.L0]) ([J24900.L1])
def JW_24900 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 24901) ([[]]) ([[]])

end

theorem jr_24900 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_24900 k) (JW_24900 k)) 24900 2 = true := by
  decide +kernel

theorem jm_24900 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_24900 k) (JW_24900 k)) 24900 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_24900 k) (JW_24900 k)) 24900 2 = true := jr_24900
  exact h0

end B334.E1x.Pts.S708
