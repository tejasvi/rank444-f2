import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 8095 … 8096 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J8095 "../data/j8095.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_8095 (k : Nat) : List Nat :=
  cond (Nat.blt k 8096) ([J8095.L0]) ([J8095.L1])
def JW_8095 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 8096) ([[]]) ([[]])

end

theorem jr_8095 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_8095 k) (JW_8095 k)) 8095 2 = true := by
  decide +kernel

theorem jm_8095 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_8095 k) (JW_8095 k)) 8095 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_8095 k) (JW_8095 k)) 8095 2 = true := jr_8095
  exact h0

end B334.E1x.Pts.S708
