import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 60093 … 60096 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J60093 "../data/j60093.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_60093 (k : Nat) : List Nat :=
  cond (Nat.blt k 60095) (cond (Nat.blt k 60094) ([J60093.L0]) ([J60093.L1])) (cond (Nat.blt k 60096) ([J60093.L2]) ([J60093.L3]))
def JW_60093 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 60095) (cond (Nat.blt k 60094) ([[]]) ([[]])) (cond (Nat.blt k 60096) ([[]]) ([[]]))

end

theorem jr_60093 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_60093 k) (JW_60093 k)) 60093 4 = true := by
  decide +kernel

theorem jm_60093 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_60093 k) (JW_60093 k)) 60093 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_60093 k) (JW_60093 k)) 60093 4 = true := jr_60093
  exact h0

end B334.E1x.Pts.S708
