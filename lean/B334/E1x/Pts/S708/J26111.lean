import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 26111 … 26112 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J26111 "../data/j26111.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_26111 (k : Nat) : List Nat :=
  cond (Nat.blt k 26112) ([J26111.L0]) ([J26111.L1])
def JW_26111 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 26112) ([[]]) ([[]])

end

theorem jr_26111 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_26111 k) (JW_26111 k)) 26111 2 = true := by
  decide +kernel

theorem jm_26111 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_26111 k) (JW_26111 k)) 26111 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_26111 k) (JW_26111 k)) 26111 2 = true := jr_26111
  exact h0

end B334.E1x.Pts.S708
