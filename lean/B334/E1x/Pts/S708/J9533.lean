  cond (Nat.blt k 9534) ([J9533.L0]) (cond (Nat.blt k 9535) ([J9533.L1]) ([J9533.L2]))
def JW_9533 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 9534) ([[]]) (cond (Nat.blt k 9535) ([[]]) ([[]]))

end

theorem jr_9533 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_9533 k) (JW_9533 k)) 9533 3 = true := by
  decide +kernel

theorem jm_9533 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_9533 k) (JW_9533 k)) 9533 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_9533 k) (JW_9533 k)) 9533 3 = true := jr_9533
