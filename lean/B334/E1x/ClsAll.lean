  have h1 : IPChk.allR clsF 0 178 = true := IPChk.allR_join clsF 0 89 89 h0 cls_89
  have h2 : IPChk.allR clsF 0 267 = true := IPChk.allR_join clsF 0 178 89 h1 cls_178
  have h3 : IPChk.allR clsF 0 356 = true := IPChk.allR_join clsF 0 267 89 h2 cls_267
  have h4 : IPChk.allR clsF 0 445 = true := IPChk.allR_join clsF 0 356 89 h3 cls_356
  have h5 : IPChk.allR clsF 0 534 = true := IPChk.allR_join clsF 0 445 89 h4 cls_445
  have h6 : IPChk.allR clsF 0 623 = true := IPChk.allR_join clsF 0 534 89 h5 cls_534
  have h7 : IPChk.allR clsF 0 1024 = true := IPChk.allR_join clsF 0 623 401 h6 cls_623
  exact h7

theorem cls_all : ∀ c < 1024, RT.classOK ClsTab.CL Tab2.basisOf Tab2.lbOf c = true := fun c hc => by
