import B334.E1x.R667.Data
import B334.E1x.R667.HT
import B334.E1x.GJ.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 0 … 1 of `R667` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.R667.J0 "../runs/runmulti2/R667_j0.bin"

namespace B334.E1x.R667

noncomputable section

def JL_0 (k : Nat) : List Nat :=
  cond (Nat.blt k 1) ([J0.L0]) ([J0.L1])
def JW_0 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1) ([[]]) ([[]])

end

theorem jr_0 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_0 k) (JW_0 k)) 0 2 = true := by
  decide +kernel

end B334.E1x.R667
