/-! # Jobs 908 … 908 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J908 "../data/j908.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_908 (k : Nat) : List Nat :=
  [J908.L0]
def JW_908 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_908 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_908 k) (JW_908 k)) 908 1 = true := by
  decide +kernel

theorem jm_908 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_908 k) (JW_908 k)) 908 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_908 k) (JW_908 k)) 908 1 = true := jr_908
  exact h0

end B334.E1x.Pts.S708
