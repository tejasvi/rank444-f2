/-! # Jobs 128800 … 128802 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J128800 "../data/j128800.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_128800 (k : Nat) : List Nat :=
  cond (Nat.blt k 128801) ([J128800.L0]) (cond (Nat.blt k 128802) ([J128800.L1]) ([J128800.L2]))
def JW_128800 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 128801) ([[]]) (cond (Nat.blt k 128802) ([[]]) ([[]]))

end

theorem jr_128800 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_128800 k) (JW_128800 k)) 128800 3 = true := by
  decide +kernel

theorem jm_128800 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_128800 k) (JW_128800 k)) 128800 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_128800 k) (JW_128800 k)) 128800 3 = true := jr_128800
  exact h0

end B334.E1x.Pts.S708
