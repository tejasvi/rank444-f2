import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1885 … 1888 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1885 "../data/j1885.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1885 (k : Nat) : List Nat :=
  cond (Nat.blt k 1887) (cond (Nat.blt k 1886) ([J1885.L0]) ([J1885.L1])) (cond (Nat.blt k 1888) ([J1885.L2]) ([J1885.L3]))
def JW_1885 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1887) (cond (Nat.blt k 1886) ([[]]) ([[]])) (cond (Nat.blt k 1888) ([[]]) ([[]]))

end

theorem jr_1885 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1885 k) (JW_1885 k)) 1885 4 = true := by
  decide +kernel

theorem jm_1885 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1885 k) (JW_1885 k)) 1885 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1885 k) (JW_1885 k)) 1885 4 = true := jr_1885
  exact h0

end B334.E1x.Pts.S708
