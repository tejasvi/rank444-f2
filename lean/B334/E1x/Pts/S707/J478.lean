import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 478 … 482 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J478 "../data/j478.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_478 (k : Nat) : List Nat :=
  cond (Nat.blt k 480) (cond (Nat.blt k 479) ([J478.L0]) ([J478.L1])) (cond (Nat.blt k 481) ([J478.L2]) (cond (Nat.blt k 482) ([J478.L3]) ([J478.L4])))
def JW_478 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 480) (cond (Nat.blt k 479) ([[]]) ([[]])) (cond (Nat.blt k 481) ([[]]) (cond (Nat.blt k 482) ([[]]) ([[]])))

end

theorem jr_478 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_478 k) (JW_478 k)) 478 5 = true := by
  decide +kernel

end B334.E1x.Pts.S707
