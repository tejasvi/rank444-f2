/-! # Jobs 53807 … 53809 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J53807 "../data/j53807.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_53807 (k : Nat) : List Nat :=
  cond (Nat.blt k 53808) ([J53807.L0]) (cond (Nat.blt k 53809) ([J53807.L1]) ([J53807.L2]))
def JW_53807 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 53808) ([[]]) (cond (Nat.blt k 53809) ([[]]) ([[]]))

end

theorem jr_53807 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_53807 k) (JW_53807 k)) 53807 3 = true := by
  decide +kernel

theorem jm_53807 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_53807 k) (JW_53807 k)) 53807 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_53807 k) (JW_53807 k)) 53807 3 = true := jr_53807
  exact h0

end B334.E1x.Pts.S708
