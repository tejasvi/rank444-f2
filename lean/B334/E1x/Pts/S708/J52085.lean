import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 52085 … 52087 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J52085 "../data/j52085.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_52085 (k : Nat) : List Nat :=
  cond (Nat.blt k 52086) ([J52085.L0]) (cond (Nat.blt k 52087) ([J52085.L1]) ([J52085.L2]))
def JW_52085 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 52086) ([[]]) (cond (Nat.blt k 52087) ([[]]) ([[]]))

end

theorem jr_52085 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_52085 k) (JW_52085 k)) 52085 3 = true := by
  decide +kernel

theorem jm_52085 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_52085 k) (JW_52085 k)) 52085 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_52085 k) (JW_52085 k)) 52085 3 = true := jr_52085
  exact h0

end B334.E1x.Pts.S708
