def JW_1788 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1790) (cond (Nat.blt k 1789) ([[]]) ([[]])) (cond (Nat.blt k 1791) ([[]]) (cond (Nat.blt k 1792) ([[]]) ([[]])))

end

theorem jr_1788 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1788 k) (JW_1788 k)) 1788 5 = true := by
  decide +kernel

theorem jm_1788 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1788 k) (JW_1788 k)) 1788 5 = true := by
