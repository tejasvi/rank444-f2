/-! # Jobs 56084 … 56087 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J56084 "../data/j56084.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_56084 (k : Nat) : List Nat :=
  cond (Nat.blt k 56086) (cond (Nat.blt k 56085) ([J56084.L0]) ([J56084.L1])) (cond (Nat.blt k 56087) ([J56084.L2]) ([J56084.L3]))
def JW_56084 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 56086) (cond (Nat.blt k 56085) ([[]]) ([[]])) (cond (Nat.blt k 56087) ([[]]) ([[]]))

end

theorem jr_56084 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_56084 k) (JW_56084 k)) 56084 4 = true := by
  decide +kernel

theorem jm_56084 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_56084 k) (JW_56084 k)) 56084 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_56084 k) (JW_56084 k)) 56084 4 = true := jr_56084
  exact h0

end B334.E1x.Pts.S708
