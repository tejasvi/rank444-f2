def JL_5012 (k : Nat) : List Nat :=
  cond (Nat.blt k 5014) (cond (Nat.blt k 5013) ([J5012.L0]) ([J5012.L1])) (cond (Nat.blt k 5015) ([J5012.L2]) (cond (Nat.blt k 5016) ([J5012.L3]) ([J5012.L4])))
def JW_5012 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 5014) (cond (Nat.blt k 5013) ([[]]) ([[]])) (cond (Nat.blt k 5015) ([[]]) (cond (Nat.blt k 5016) ([[]]) ([[]])))

end

theorem jr_5012 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_5012 k) (JW_5012 k)) 5012 5 = true := by
  decide +kernel

theorem jm_5012 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_5012 k) (JW_5012 k)) 5012 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_5012 k) (JW_5012 k)) 5012 5 = true := jr_5012
  exact h0

end B334.E1x.Pts.S708
