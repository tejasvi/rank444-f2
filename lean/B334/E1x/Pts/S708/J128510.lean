/-! # Jobs 128510 … 128511 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J128510 "../data/j128510.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_128510 (k : Nat) : List Nat :=
  cond (Nat.blt k 128511) ([J128510.L0, J128510.L1, J128510.L2]) ([J128510.L3])
def JW_128510 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 128511) ([[1, 2], [], []]) ([[]])

end

theorem jr_128510 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_128510 k) (JW_128510 k)) 128510 2 = true := by
  decide +kernel

theorem jm_128510 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_128510 k) (JW_128510 k)) 128510 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_128510 k) (JW_128510 k)) 128510 2 = true := jr_128510
  exact h0

end B334.E1x.Pts.S708
