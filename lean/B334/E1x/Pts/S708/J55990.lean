/-! # Jobs 55990 … 55993 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J55990 "../data/j55990.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_55990 (k : Nat) : List Nat :=
  cond (Nat.blt k 55992) (cond (Nat.blt k 55991) ([J55990.L0]) ([J55990.L1])) (cond (Nat.blt k 55993) ([J55990.L2]) ([J55990.L3]))
def JW_55990 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 55992) (cond (Nat.blt k 55991) ([[]]) ([[]])) (cond (Nat.blt k 55993) ([[]]) ([[]]))

end

theorem jr_55990 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_55990 k) (JW_55990 k)) 55990 4 = true := by
  decide +kernel

theorem jm_55990 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_55990 k) (JW_55990 k)) 55990 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_55990 k) (JW_55990 k)) 55990 4 = true := jr_55990
  exact h0

end B334.E1x.Pts.S708
