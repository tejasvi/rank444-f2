import B334.E1x.Load

/-! # Tables of the E1G run `R672` (generated by a script; binary data files)

* `HT.entry k`: the `13 + 7 d`-bit header of job `k`'s first piece (2709 jobs; 24-byte entries).
* `Wf i j`: the glue witness of header record `j` of top-chain block `i` (`OF`: per block the offset of its first
  record in `WT`; a witness `w < 52` is a later top-chain block, `w - 52` a job). -/

#rttablew B334.E1x.R672.HT "../runs/run672c/R672_ht.bin" 64 192
#rttablew B334.E1x.R672.OF "../runs/run672c/R672_top_of.bin" 64 32
#rttablew B334.E1x.R672.WT "../runs/run672c/R672_top_wt.bin" 64 32

namespace B334.E1x.R672

noncomputable section

def nJ : Nat := 2709
def NT : Nat := 52
def Wf (i j : Nat) : Nat := WT.entry (OF.entry i + j)

end

end B334.E1x.R672
