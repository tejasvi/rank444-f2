import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 22064 … 22066 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J22064 "../data/j22064.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_22064 (k : Nat) : List Nat :=
  cond (Nat.blt k 22065) ([J22064.L0]) (cond (Nat.blt k 22066) ([J22064.L1]) ([J22064.L2]))
def JW_22064 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 22065) ([[]]) (cond (Nat.blt k 22066) ([[]]) ([[]]))

end

theorem jr_22064 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_22064 k) (JW_22064 k)) 22064 3 = true := by
  decide +kernel

theorem jm_22064 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_22064 k) (JW_22064 k)) 22064 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_22064 k) (JW_22064 k)) 22064 3 = true := jr_22064
  exact h0

end B334.E1x.Pts.S708
