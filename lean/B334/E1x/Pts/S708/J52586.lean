import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 52586 … 52589 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J52586 "../data/j52586.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_52586 (k : Nat) : List Nat :=
  cond (Nat.blt k 52588) (cond (Nat.blt k 52587) ([J52586.L0]) ([J52586.L1])) (cond (Nat.blt k 52589) ([J52586.L2]) ([J52586.L3]))
def JW_52586 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 52588) (cond (Nat.blt k 52587) ([[]]) ([[]])) (cond (Nat.blt k 52589) ([[]]) ([[]]))

end

theorem jr_52586 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_52586 k) (JW_52586 k)) 52586 4 = true := by
  decide +kernel

theorem jm_52586 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_52586 k) (JW_52586 k)) 52586 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_52586 k) (JW_52586 k)) 52586 4 = true := jr_52586
  exact h0

end B334.E1x.Pts.S708
