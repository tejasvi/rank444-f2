import B334.E1x.R618.Data
import B334.E1x.R618.HT
import B334.E1x.GJ.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1050 … 1050 of `R618` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.R618.J1050 "../runs/runmulti2/R618_j1050.bin"

namespace B334.E1x.R618

noncomputable section

def JL_1050 (k : Nat) : List Nat :=
  [J1050.L0]
def JW_1050 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_1050 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_1050 k) (JW_1050 k)) 1050 1 = true := by
  decide +kernel

end B334.E1x.R618
