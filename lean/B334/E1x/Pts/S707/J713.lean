import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 713 … 717 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J713 "../data/j713.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_713 (k : Nat) : List Nat :=
  cond (Nat.blt k 715) (cond (Nat.blt k 714) ([J713.L0]) ([J713.L1])) (cond (Nat.blt k 716) ([J713.L2]) (cond (Nat.blt k 717) ([J713.L3]) ([J713.L4])))
def JW_713 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 715) (cond (Nat.blt k 714) ([[]]) ([[]])) (cond (Nat.blt k 716) ([[]]) (cond (Nat.blt k 717) ([[]]) ([[]])))

end

theorem jr_713 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_713 k) (JW_713 k)) 713 5 = true := by
  decide +kernel

end B334.E1x.Pts.S707
