#e1lits B334.E1x.Pts.S708.J51600 "../data/j51600.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_51600 (k : Nat) : List Nat :=
  cond (Nat.blt k 51601) ([J51600.L0]) (cond (Nat.blt k 51602) ([J51600.L1]) ([J51600.L2]))
def JW_51600 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 51601) ([[]]) (cond (Nat.blt k 51602) ([[]]) ([[]]))

end

theorem jr_51600 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_51600 k) (JW_51600 k)) 51600 3 = true := by
  decide +kernel

theorem jm_51600 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_51600 k) (JW_51600 k)) 51600 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_51600 k) (JW_51600 k)) 51600 3 = true := jr_51600
  exact h0

