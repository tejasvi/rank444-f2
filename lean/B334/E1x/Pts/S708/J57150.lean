/-! # Jobs 57150 … 57151 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J57150 "../data/j57150.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_57150 (k : Nat) : List Nat :=
  cond (Nat.blt k 57151) ([J57150.L0]) ([J57150.L1])
def JW_57150 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 57151) ([[]]) ([[]])

end

theorem jr_57150 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_57150 k) (JW_57150 k)) 57150 2 = true := by
  decide +kernel

theorem jm_57150 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_57150 k) (JW_57150 k)) 57150 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_57150 k) (JW_57150 k)) 57150 2 = true := jr_57150
  exact h0

end B334.E1x.Pts.S708
