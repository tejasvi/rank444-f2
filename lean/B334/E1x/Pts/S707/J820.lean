import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 820 … 824 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J820 "../data/j820.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_820 (k : Nat) : List Nat :=
  cond (Nat.blt k 822) (cond (Nat.blt k 821) ([J820.L0]) ([J820.L1])) (cond (Nat.blt k 823) ([J820.L2]) (cond (Nat.blt k 824) ([J820.L3]) ([J820.L4])))
def JW_820 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 822) (cond (Nat.blt k 821) ([[]]) ([[]])) (cond (Nat.blt k 823) ([[]]) (cond (Nat.blt k 824) ([[]]) ([[]])))

end

theorem jr_820 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_820 k) (JW_820 k)) 820 5 = true := by
  decide +kernel

end B334.E1x.Pts.S707
