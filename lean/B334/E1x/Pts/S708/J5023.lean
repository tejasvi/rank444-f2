set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 5023 … 5024 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J5023 "../data/j5023.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_5023 (k : Nat) : List Nat :=
  cond (Nat.blt k 5024) ([J5023.L0]) ([J5023.L1])
def JW_5023 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 5024) ([[]]) ([[]])

end

theorem jr_5023 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_5023 k) (JW_5023 k)) 5023 2 = true := by
  decide +kernel

theorem jm_5023 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_5023 k) (JW_5023 k)) 5023 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_5023 k) (JW_5023 k)) 5023 2 = true := jr_5023
  exact h0

end B334.E1x.Pts.S708
