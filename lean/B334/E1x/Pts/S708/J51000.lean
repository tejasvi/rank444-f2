import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 51000 … 51004 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J51000 "../data/j51000.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_51000 (k : Nat) : List Nat :=
  cond (Nat.blt k 51002) (cond (Nat.blt k 51001) ([J51000.L0]) ([J51000.L1])) (cond (Nat.blt k 51003) ([J51000.L2]) (cond (Nat.blt k 51004) ([J51000.L3]) ([J51000.L4])))
def JW_51000 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 51002) (cond (Nat.blt k 51001) ([[]]) ([[]])) (cond (Nat.blt k 51003) ([[]]) (cond (Nat.blt k 51004) ([[]]) ([[]])))

end

theorem jr_51000 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_51000 k) (JW_51000 k)) 51000 5 = true := by
  decide +kernel

theorem jm_51000 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_51000 k) (JW_51000 k)) 51000 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_51000 k) (JW_51000 k)) 51000 5 = true := jr_51000
  exact h0

end B334.E1x.Pts.S708
