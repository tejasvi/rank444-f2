set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2864 … 2866 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J2864 "../data/j2864.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_2864 (k : Nat) : List Nat :=
  cond (Nat.blt k 2865) ([J2864.L0]) (cond (Nat.blt k 2866) ([J2864.L1]) ([J2864.L2]))
def JW_2864 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2865) ([[]]) (cond (Nat.blt k 2866) ([[]]) ([[]]))

end

theorem jr_2864 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2864 k) (JW_2864 k)) 2864 3 = true := by
  decide +kernel

theorem jm_2864 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2864 k) (JW_2864 k)) 2864 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2864 k) (JW_2864 k)) 2864 3 = true := jr_2864
  exact h0

end B334.E1x.Pts.S708
