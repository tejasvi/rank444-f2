/-! # Jobs 8751 … 8756 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J8751 "../data/j8751.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_8751 (k : Nat) : List Nat :=
  cond (Nat.blt k 8754) (cond (Nat.blt k 8752) ([J8751.L0]) (cond (Nat.blt k 8753) ([J8751.L1]) ([J8751.L2]))) (cond (Nat.blt k 8755) ([J8751.L3]) (cond (Nat.blt k 8756) ([J8751.L4]) ([J8751.L5])))
def JW_8751 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 8754) (cond (Nat.blt k 8752) ([[]]) (cond (Nat.blt k 8753) ([[]]) ([[]]))) (cond (Nat.blt k 8755) ([[]]) (cond (Nat.blt k 8756) ([[]]) ([[]])))

end

theorem jr_8751 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_8751 k) (JW_8751 k)) 8751 6 = true := by
  decide +kernel

theorem jm_8751 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_8751 k) (JW_8751 k)) 8751 6 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_8751 k) (JW_8751 k)) 8751 6 = true := jr_8751
  exact h0

end B334.E1x.Pts.S708
