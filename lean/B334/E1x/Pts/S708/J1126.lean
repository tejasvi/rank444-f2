end

theorem jr_1126 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1126 k) (JW_1126 k)) 1126 1 = true := by
  decide +kernel

theorem jm_1126 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1126 k) (JW_1126 k)) 1126 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1126 k) (JW_1126 k)) 1126 1 = true := jr_1126
