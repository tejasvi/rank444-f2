import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1780 … 1783 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1780 "../data/j1780.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1780 (k : Nat) : List Nat :=
  cond (Nat.blt k 1782) (cond (Nat.blt k 1781) ([J1780.L0]) ([J1780.L1])) (cond (Nat.blt k 1783) ([J1780.L2]) ([J1780.L3]))
def JW_1780 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1782) (cond (Nat.blt k 1781) ([[]]) ([[]])) (cond (Nat.blt k 1783) ([[]]) ([[]]))

end

theorem jr_1780 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1780 k) (JW_1780 k)) 1780 4 = true := by
  decide +kernel

theorem jm_1780 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1780 k) (JW_1780 k)) 1780 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1780 k) (JW_1780 k)) 1780 4 = true := jr_1780
  exact h0

end B334.E1x.Pts.S708
