import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 50400 … 50401 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J50400 "../data/j50400.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_50400 (k : Nat) : List Nat :=
  cond (Nat.blt k 50401) ([J50400.L0]) ([J50400.L1])
def JW_50400 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 50401) ([[]]) ([[]])

end

theorem jr_50400 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_50400 k) (JW_50400 k)) 50400 2 = true := by
  decide +kernel

theorem jm_50400 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_50400 k) (JW_50400 k)) 50400 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_50400 k) (JW_50400 k)) 50400 2 = true := jr_50400
  exact h0

end B334.E1x.Pts.S708
