/-! # Jobs 82010 … 82010 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J82010 "../data/j82010.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_82010 (k : Nat) : List Nat :=
  [J82010.L0]
def JW_82010 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_82010 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_82010 k) (JW_82010 k)) 82010 1 = true := by
  decide +kernel

theorem jm_82010 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_82010 k) (JW_82010 k)) 82010 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_82010 k) (JW_82010 k)) 82010 1 = true := jr_82010
  exact h0

end B334.E1x.Pts.S708
