import B334.E1x.R667.Data
import B334.E1x.R667.HT
import B334.E1x.GJ.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 50 … 50 of `R667` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.R667.J50 "../runs/runmulti2/R667_j50.bin"

namespace B334.E1x.R667

noncomputable section

def JL_50 (k : Nat) : List Nat :=
  [J50.L0]
def JW_50 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_50 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_50 k) (JW_50 k)) 50 1 = true := by
  decide +kernel

end B334.E1x.R667
