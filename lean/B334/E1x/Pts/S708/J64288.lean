/-! # Jobs 64288 … 64290 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J64288 "../data/j64288.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_64288 (k : Nat) : List Nat :=
  cond (Nat.blt k 64289) ([J64288.L0]) (cond (Nat.blt k 64290) ([J64288.L1, J64288.L2, J64288.L3, J64288.L4]) ([J64288.L5]))
def JW_64288 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 64289) ([[]]) (cond (Nat.blt k 64290) ([[1, 2, 3], [], [], []]) ([[]]))

end

theorem jr_64288 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_64288 k) (JW_64288 k)) 64288 3 = true := by
  decide +kernel

theorem jm_64288 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_64288 k) (JW_64288 k)) 64288 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_64288 k) (JW_64288 k)) 64288 3 = true := jr_64288
  exact h0

end B334.E1x.Pts.S708
