import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 119905 … 119906 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J119905 "../data/j119905.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_119905 (k : Nat) : List Nat :=
  cond (Nat.blt k 119906) ([J119905.L0]) ([J119905.L1])
def JW_119905 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 119906) ([[]]) ([[]])

end

theorem jr_119905 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_119905 k) (JW_119905 k)) 119905 2 = true := by
  decide +kernel

theorem jm_119905 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_119905 k) (JW_119905 k)) 119905 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_119905 k) (JW_119905 k)) 119905 2 = true := jr_119905
  exact h0

end B334.E1x.Pts.S708
