import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 25625 … 25631 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J25625 "../data/j25625.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_25625 (k : Nat) : List Nat :=
  cond (Nat.blt k 25628) (cond (Nat.blt k 25626) ([J25625.L0]) (cond (Nat.blt k 25627) ([J25625.L1]) ([J25625.L2]))) (cond (Nat.blt k 25630) (cond (Nat.blt k 25629) ([J25625.L3]) ([J25625.L4])) (cond (Nat.blt k 25631) ([J25625.L5]) ([J25625.L6])))
def JW_25625 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 25628) (cond (Nat.blt k 25626) ([[]]) (cond (Nat.blt k 25627) ([[]]) ([[]]))) (cond (Nat.blt k 25630) (cond (Nat.blt k 25629) ([[]]) ([[]])) (cond (Nat.blt k 25631) ([[]]) ([[]])))

end

theorem jr_25625 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25625 k) (JW_25625 k)) 25625 7 = true := by
  decide +kernel

theorem jm_25625 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25625 k) (JW_25625 k)) 25625 7 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25625 k) (JW_25625 k)) 25625 7 = true := jr_25625
  exact h0

end B334.E1x.Pts.S708
