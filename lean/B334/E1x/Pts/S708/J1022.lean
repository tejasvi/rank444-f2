/-! # Jobs 1022 … 1023 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1022 "../data/j1022.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1022 (k : Nat) : List Nat :=
  cond (Nat.blt k 1023) ([J1022.L0]) ([J1022.L1])
def JW_1022 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1023) ([[]]) ([[]])

end

theorem jr_1022 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1022 k) (JW_1022 k)) 1022 2 = true := by
  decide +kernel

theorem jm_1022 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1022 k) (JW_1022 k)) 1022 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1022 k) (JW_1022 k)) 1022 2 = true := jr_1022
  exact h0

end B334.E1x.Pts.S708
