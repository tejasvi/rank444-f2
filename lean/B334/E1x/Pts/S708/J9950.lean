import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 9950 … 9956 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J9950 "../data/j9950.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_9950 (k : Nat) : List Nat :=
  cond (Nat.blt k 9953) (cond (Nat.blt k 9951) ([J9950.L0]) (cond (Nat.blt k 9952) ([J9950.L1]) ([J9950.L2]))) (cond (Nat.blt k 9955) (cond (Nat.blt k 9954) ([J9950.L3]) ([J9950.L4])) (cond (Nat.blt k 9956) ([J9950.L5]) ([J9950.L6])))
def JW_9950 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 9953) (cond (Nat.blt k 9951) ([[]]) (cond (Nat.blt k 9952) ([[]]) ([[]]))) (cond (Nat.blt k 9955) (cond (Nat.blt k 9954) ([[]]) ([[]])) (cond (Nat.blt k 9956) ([[]]) ([[]])))

end

theorem jr_9950 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_9950 k) (JW_9950 k)) 9950 7 = true := by
  decide +kernel

theorem jm_9950 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_9950 k) (JW_9950 k)) 9950 7 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_9950 k) (JW_9950 k)) 9950 7 = true := jr_9950
  exact h0

end B334.E1x.Pts.S708
