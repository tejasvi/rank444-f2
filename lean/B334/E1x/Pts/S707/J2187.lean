set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2187 … 2187 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J2187 "../data/j2187.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_2187 (k : Nat) : List Nat :=
  [J2187.L0]
def JW_2187 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_2187 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_2187 k) (JW_2187 k)) 2187 1 = true := by
  decide +kernel

end B334.E1x.Pts.S707
