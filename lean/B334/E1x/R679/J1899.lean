pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.R679.J1899 "../runs/runmulti2/R679_j1899.bin"

namespace B334.E1x.R679

noncomputable section

def JL_1899 (k : Nat) : List Nat :=
  [J1899.L0]
def JW_1899 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_1899 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_1899 k) (JW_1899 k)) 1899 1 = true := by
  decide +kernel

end B334.E1x.R679
