import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 52580 … 52582 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J52580 "../data/j52580.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_52580 (k : Nat) : List Nat :=
  cond (Nat.blt k 52581) ([J52580.L0]) (cond (Nat.blt k 52582) ([J52580.L1]) ([J52580.L2]))
def JW_52580 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 52581) ([[]]) (cond (Nat.blt k 52582) ([[]]) ([[]]))

end

theorem jr_52580 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_52580 k) (JW_52580 k)) 52580 3 = true := by
  decide +kernel

theorem jm_52580 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_52580 k) (JW_52580 k)) 52580 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_52580 k) (JW_52580 k)) 52580 3 = true := jr_52580
  exact h0

end B334.E1x.Pts.S708
