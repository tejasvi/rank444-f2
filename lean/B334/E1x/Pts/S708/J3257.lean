#e1lits B334.E1x.Pts.S708.J3257 "../data/j3257.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_3257 (k : Nat) : List Nat :=
  cond (Nat.blt k 3258) ([J3257.L0]) ([J3257.L1])
def JW_3257 (k : Nat) : List (List Nat) :=
