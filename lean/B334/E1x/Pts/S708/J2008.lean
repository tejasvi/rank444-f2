import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2008 … 2011 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J2008 "../data/j2008.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_2008 (k : Nat) : List Nat :=
  cond (Nat.blt k 2010) (cond (Nat.blt k 2009) ([J2008.L0]) ([J2008.L1])) (cond (Nat.blt k 2011) ([J2008.L2]) ([J2008.L3]))
def JW_2008 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2010) (cond (Nat.blt k 2009) ([[]]) ([[]])) (cond (Nat.blt k 2011) ([[]]) ([[]]))

end

theorem jr_2008 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2008 k) (JW_2008 k)) 2008 4 = true := by
  decide +kernel

theorem jm_2008 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2008 k) (JW_2008 k)) 2008 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2008 k) (JW_2008 k)) 2008 4 = true := jr_2008
  exact h0

end B334.E1x.Pts.S708
