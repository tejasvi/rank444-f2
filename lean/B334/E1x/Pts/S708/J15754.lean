/-! # Jobs 15754 … 15756 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J15754 "../data/j15754.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_15754 (k : Nat) : List Nat :=
  cond (Nat.blt k 15755) ([J15754.L0]) (cond (Nat.blt k 15756) ([J15754.L1]) ([J15754.L2]))
def JW_15754 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 15755) ([[]]) (cond (Nat.blt k 15756) ([[]]) ([[]]))

end

theorem jr_15754 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_15754 k) (JW_15754 k)) 15754 3 = true := by
  decide +kernel

theorem jm_15754 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_15754 k) (JW_15754 k)) 15754 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_15754 k) (JW_15754 k)) 15754 3 = true := jr_15754
  exact h0

end B334.E1x.Pts.S708
