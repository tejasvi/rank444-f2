/-! # Jobs 986 … 987 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J986 "../data/j986.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_986 (k : Nat) : List Nat :=
  cond (Nat.blt k 987) ([J986.L0]) ([J986.L1])
def JW_986 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 987) ([[]]) ([[]])

end

theorem jr_986 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_986 k) (JW_986 k)) 986 2 = true := by
  decide +kernel

end B334.E1x.Pts.S707
