import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 74086 … 74088 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J74086 "../data/j74086.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_74086 (k : Nat) : List Nat :=
  cond (Nat.blt k 74087) ([J74086.L0]) (cond (Nat.blt k 74088) ([J74086.L1]) ([J74086.L2]))
def JW_74086 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 74087) ([[]]) (cond (Nat.blt k 74088) ([[]]) ([[]]))

end

theorem jr_74086 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_74086 k) (JW_74086 k)) 74086 3 = true := by
  decide +kernel

theorem jm_74086 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_74086 k) (JW_74086 k)) 74086 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_74086 k) (JW_74086 k)) 74086 3 = true := jr_74086
  exact h0

end B334.E1x.Pts.S708
