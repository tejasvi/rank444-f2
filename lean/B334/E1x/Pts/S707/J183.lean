/-! # Jobs 183 … 187 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J183 "../data/j183.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_183 (k : Nat) : List Nat :=
  cond (Nat.blt k 185) (cond (Nat.blt k 184) ([J183.L0]) ([J183.L1])) (cond (Nat.blt k 186) ([J183.L2]) (cond (Nat.blt k 187) ([J183.L3]) ([J183.L4])))
def JW_183 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 185) (cond (Nat.blt k 184) ([[]]) ([[]])) (cond (Nat.blt k 186) ([[]]) (cond (Nat.blt k 187) ([[]]) ([[]])))

end

theorem jr_183 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_183 k) (JW_183 k)) 183 5 = true := by
  decide +kernel

end B334.E1x.Pts.S707
