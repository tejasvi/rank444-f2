import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 65528 … 65529 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J65528 "../data/j65528.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_65528 (k : Nat) : List Nat :=
  cond (Nat.blt k 65529) ([J65528.L0]) ([J65528.L1])
def JW_65528 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 65529) ([[]]) ([[]])

end

theorem jr_65528 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_65528 k) (JW_65528 k)) 65528 2 = true := by
  decide +kernel

theorem jm_65528 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_65528 k) (JW_65528 k)) 65528 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_65528 k) (JW_65528 k)) 65528 2 = true := jr_65528
  exact h0

end B334.E1x.Pts.S708
