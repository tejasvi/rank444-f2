import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 253 … 256 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J253 "../data/j253.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_253 (k : Nat) : List Nat :=
  cond (Nat.blt k 255) (cond (Nat.blt k 254) ([J253.L0]) ([J253.L1])) (cond (Nat.blt k 256) ([J253.L2]) ([J253.L3]))
def JW_253 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 255) (cond (Nat.blt k 254) ([[]]) ([[]])) (cond (Nat.blt k 256) ([[]]) ([[]]))

end

theorem jr_253 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_253 k) (JW_253 k)) 253 4 = true := by
  decide +kernel

theorem jm_253 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_253 k) (JW_253 k)) 253 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_253 k) (JW_253 k)) 253 4 = true := jr_253
  exact h0

end B334.E1x.Pts.S708
