import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2052 … 2055 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J2052 "../data/j2052.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_2052 (k : Nat) : List Nat :=
  cond (Nat.blt k 2054) (cond (Nat.blt k 2053) ([J2052.L0]) ([J2052.L1])) (cond (Nat.blt k 2055) ([J2052.L2]) ([J2052.L3]))
def JW_2052 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2054) (cond (Nat.blt k 2053) ([[]]) ([[]])) (cond (Nat.blt k 2055) ([[]]) ([[]]))

end

theorem jr_2052 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_2052 k) (JW_2052 k)) 2052 4 = true := by
  decide +kernel

end B334.E1x.Pts.S707
