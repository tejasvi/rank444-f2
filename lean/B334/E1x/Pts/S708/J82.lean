import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 82 … 86 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J82 "../data/j82.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_82 (k : Nat) : List Nat :=
  cond (Nat.blt k 84) (cond (Nat.blt k 83) ([J82.L0]) ([J82.L1])) (cond (Nat.blt k 85) ([J82.L2]) (cond (Nat.blt k 86) ([J82.L3]) ([J82.L4])))
def JW_82 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 84) (cond (Nat.blt k 83) ([[]]) ([[]])) (cond (Nat.blt k 85) ([[]]) (cond (Nat.blt k 86) ([[]]) ([[]])))

end

theorem jr_82 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_82 k) (JW_82 k)) 82 5 = true := by
  decide +kernel

theorem jm_82 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_82 k) (JW_82 k)) 82 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_82 k) (JW_82 k)) 82 5 = true := jr_82
  exact h0

end B334.E1x.Pts.S708
