import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 50290 … 50290 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J50290 "../data/j50290.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_50290 (k : Nat) : List Nat :=
  [J50290.L0]
def JW_50290 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_50290 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_50290 k) (JW_50290 k)) 50290 1 = true := by
  decide +kernel

theorem jm_50290 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_50290 k) (JW_50290 k)) 50290 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_50290 k) (JW_50290 k)) 50290 1 = true := jr_50290
  exact h0

end B334.E1x.Pts.S708
