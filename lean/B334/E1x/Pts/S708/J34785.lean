import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 34785 … 34788 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J34785 "../data/j34785.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_34785 (k : Nat) : List Nat :=
  cond (Nat.blt k 34787) (cond (Nat.blt k 34786) ([J34785.L0]) ([J34785.L1])) (cond (Nat.blt k 34788) ([J34785.L2]) ([J34785.L3]))
def JW_34785 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 34787) (cond (Nat.blt k 34786) ([[]]) ([[]])) (cond (Nat.blt k 34788) ([[]]) ([[]]))

end

theorem jr_34785 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_34785 k) (JW_34785 k)) 34785 4 = true := by
  decide +kernel

theorem jm_34785 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_34785 k) (JW_34785 k)) 34785 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_34785 k) (JW_34785 k)) 34785 4 = true := jr_34785
  exact h0

end B334.E1x.Pts.S708
