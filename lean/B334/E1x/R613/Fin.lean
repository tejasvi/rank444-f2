    BLK.lits (by rw [nlits]; decide) root
    (fun i hi => blkChk_spec C sl UB UBR BLK.lits 1308 blks i (by rw [nlits] at hi; exact hi))
    (glueChk_spec BLK.lits W glues)

theorem one_ok : oneOK Em 4 = true := by decide +kernel
theorem em_ok : emOK Em (Tab2.basisOf 613) = true := by decide +kernel
theorem lb_eq : Tab2.lbOf 613 = 23 + 1 := by decide

/-- **The run of class 613** -/
theorem run_613 (hhi : Tab2.HighHyp 613) : RowValid (Tab2.basisOf 613) (Tab2.lbOf 613) := by
  rw [lb_eq]
  exact rowValid_of_e1 (ClsChk.basis_lt 613 (by decide)) (concl hhi) one_ok em_ok

/-- the run in the dispatcher's list form -/
theorem runsFor : Tab2.RunsFor [613] := fun c hc hhi => by
  rw [List.mem_singleton] at hc
  subst hc
  exact run_613 hhi

