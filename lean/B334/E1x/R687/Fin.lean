theorem run_687 (hhi : Tab2.HighHyp 687) : RowValid (Tab2.basisOf 687) (Tab2.lbOf 687) := by
  rw [lb_eq]
  exact rowValid_of_e1 (ClsChk.basis_lt 687 (by decide)) (concl hhi) one_ok em_ok

/-- the run in the dispatcher's list form -/
theorem runsFor : Tab2.RunsFor [687] := fun c hc hhi => by
  rw [List.mem_singleton] at hc
  subst hc
