import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1543 … 1545 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1543 "../data/j1543.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1543 (k : Nat) : List Nat :=
  cond (Nat.blt k 1544) ([J1543.L0]) (cond (Nat.blt k 1545) ([J1543.L1]) ([J1543.L2]))
def JW_1543 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1544) ([[]]) (cond (Nat.blt k 1545) ([[]]) ([[]]))

end

theorem jr_1543 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1543 k) (JW_1543 k)) 1543 3 = true := by
  decide +kernel

theorem jm_1543 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1543 k) (JW_1543 k)) 1543 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1543 k) (JW_1543 k)) 1543 3 = true := jr_1543
  exact h0

end B334.E1x.Pts.S708
