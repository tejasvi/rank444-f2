import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2001 … 2006 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J2001 "../data/j2001.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_2001 (k : Nat) : List Nat :=
  cond (Nat.blt k 2004) (cond (Nat.blt k 2002) ([J2001.L0]) (cond (Nat.blt k 2003) ([J2001.L1]) ([J2001.L2]))) (cond (Nat.blt k 2005) ([J2001.L3]) (cond (Nat.blt k 2006) ([J2001.L4]) ([J2001.L5])))
def JW_2001 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2004) (cond (Nat.blt k 2002) ([[]]) (cond (Nat.blt k 2003) ([[]]) ([[]]))) (cond (Nat.blt k 2005) ([[]]) (cond (Nat.blt k 2006) ([[]]) ([[]])))

end

theorem jr_2001 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2001 k) (JW_2001 k)) 2001 6 = true := by
  decide +kernel

theorem jm_2001 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2001 k) (JW_2001 k)) 2001 6 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2001 k) (JW_2001 k)) 2001 6 = true := jr_2001
  exact h0

end B334.E1x.Pts.S708
