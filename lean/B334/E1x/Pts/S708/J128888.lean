#e1lits B334.E1x.Pts.S708.J128888 "../data/j128888.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_128888 (k : Nat) : List Nat :=
  cond (Nat.blt k 128889) ([J128888.L0]) ([J128888.L1])
def JW_128888 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 128889) ([[]]) ([[]])

end

theorem jr_128888 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_128888 k) (JW_128888 k)) 128888 2 = true := by
  decide +kernel

theorem jm_128888 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_128888 k) (JW_128888 k)) 128888 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_128888 k) (JW_128888 k)) 128888 2 = true := jr_128888
  exact h0

end B334.E1x.Pts.S708
