import B334.E1x.R667.Data
import B334.E1x.R667.HT
import B334.E1x.GJ.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 195 … 197 of `R667` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.R667.J195 "../runs/runmulti2/R667_j195.bin"

namespace B334.E1x.R667

noncomputable section

def JL_195 (k : Nat) : List Nat :=
  cond (Nat.blt k 196) ([J195.L0]) (cond (Nat.blt k 197) ([J195.L1]) ([J195.L2]))
def JW_195 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 196) ([[]]) (cond (Nat.blt k 197) ([[]]) ([[]]))

end

theorem jr_195 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_195 k) (JW_195 k)) 195 3 = true := by
  decide +kernel

end B334.E1x.R667
