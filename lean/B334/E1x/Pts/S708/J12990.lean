set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 12990 … 12990 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J12990 "../data/j12990.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_12990 (k : Nat) : List Nat :=
  [J12990.L0]
def JW_12990 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_12990 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12990 k) (JW_12990 k)) 12990 1 = true := by
  decide +kernel

theorem jm_12990 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12990 k) (JW_12990 k)) 12990 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12990 k) (JW_12990 k)) 12990 1 = true := jr_12990
  exact h0

end B334.E1x.Pts.S708
