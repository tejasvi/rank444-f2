/-! # Jobs 1682 … 1682 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1682 "../data/j1682.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1682 (k : Nat) : List Nat :=
  [J1682.L0]
def JW_1682 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_1682 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1682 k) (JW_1682 k)) 1682 1 = true := by
  decide +kernel

theorem jm_1682 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1682 k) (JW_1682 k)) 1682 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1682 k) (JW_1682 k)) 1682 1 = true := jr_1682
  exact h0

end B334.E1x.Pts.S708
