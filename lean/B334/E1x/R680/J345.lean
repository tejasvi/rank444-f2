import B334.E1x.R680.Data
import B334.E1x.R680.HT
import B334.E1x.GJ.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 345 … 345 of `R680` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.R680.J345 "../runs/runmulti2/R680_j345.bin"

namespace B334.E1x.R680

noncomputable section

def JL_345 (k : Nat) : List Nat :=
  [J345.L0, J345.L1, J345.L2]
def JW_345 (k : Nat) : List (List Nat) :=
  [[1], [2], []]

end

theorem jr_345 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_345 k) (JW_345 k)) 345 1 = true := by
  decide +kernel

end B334.E1x.R680
