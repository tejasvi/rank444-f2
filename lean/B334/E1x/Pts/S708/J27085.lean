import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 27085 … 27086 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J27085 "../data/j27085.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_27085 (k : Nat) : List Nat :=
  cond (Nat.blt k 27086) ([J27085.L0]) ([J27085.L1])
def JW_27085 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 27086) ([[]]) ([[]])

end

theorem jr_27085 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_27085 k) (JW_27085 k)) 27085 2 = true := by
  decide +kernel

theorem jm_27085 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_27085 k) (JW_27085 k)) 27085 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_27085 k) (JW_27085 k)) 27085 2 = true := jr_27085
  exact h0

end B334.E1x.Pts.S708
