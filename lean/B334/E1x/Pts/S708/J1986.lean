import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1986 … 1988 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1986 "../data/j1986.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1986 (k : Nat) : List Nat :=
  cond (Nat.blt k 1987) ([J1986.L0]) (cond (Nat.blt k 1988) ([J1986.L1]) ([J1986.L2]))
def JW_1986 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1987) ([[]]) (cond (Nat.blt k 1988) ([[]]) ([[]]))

end

theorem jr_1986 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1986 k) (JW_1986 k)) 1986 3 = true := by
  decide +kernel

theorem jm_1986 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1986 k) (JW_1986 k)) 1986 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1986 k) (JW_1986 k)) 1986 3 = true := jr_1986
  exact h0

end B334.E1x.Pts.S708
