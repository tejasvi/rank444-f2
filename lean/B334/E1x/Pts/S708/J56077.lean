import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 56077 … 56080 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J56077 "../data/j56077.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_56077 (k : Nat) : List Nat :=
  cond (Nat.blt k 56079) (cond (Nat.blt k 56078) ([J56077.L0]) ([J56077.L1])) (cond (Nat.blt k 56080) ([J56077.L2]) ([J56077.L3]))
def JW_56077 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 56079) (cond (Nat.blt k 56078) ([[]]) ([[]])) (cond (Nat.blt k 56080) ([[]]) ([[]]))

end

theorem jr_56077 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_56077 k) (JW_56077 k)) 56077 4 = true := by
  decide +kernel

theorem jm_56077 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_56077 k) (JW_56077 k)) 56077 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_56077 k) (JW_56077 k)) 56077 4 = true := jr_56077
  exact h0

end B334.E1x.Pts.S708
