import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1677 … 1680 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1677 "../data/j1677.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1677 (k : Nat) : List Nat :=
  cond (Nat.blt k 1679) (cond (Nat.blt k 1678) ([J1677.L0]) ([J1677.L1])) (cond (Nat.blt k 1680) ([J1677.L2]) ([J1677.L3]))
def JW_1677 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1679) (cond (Nat.blt k 1678) ([[]]) ([[]])) (cond (Nat.blt k 1680) ([[]]) ([[]]))

end

theorem jr_1677 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1677 k) (JW_1677 k)) 1677 4 = true := by
  decide +kernel

theorem jm_1677 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1677 k) (JW_1677 k)) 1677 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1677 k) (JW_1677 k)) 1677 4 = true := jr_1677
  exact h0

end B334.E1x.Pts.S708
