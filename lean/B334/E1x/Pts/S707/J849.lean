set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 849 … 852 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J849 "../data/j849.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_849 (k : Nat) : List Nat :=
  cond (Nat.blt k 851) (cond (Nat.blt k 850) ([J849.L0]) ([J849.L1])) (cond (Nat.blt k 852) ([J849.L2]) ([J849.L3]))
def JW_849 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 851) (cond (Nat.blt k 850) ([[]]) ([[]])) (cond (Nat.blt k 852) ([[]]) ([[]]))

end

theorem jr_849 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_849 k) (JW_849 k)) 849 4 = true := by
  decide +kernel

end B334.E1x.Pts.S707
