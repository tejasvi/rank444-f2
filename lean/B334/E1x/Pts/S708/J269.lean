import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 269 … 269 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J269 "../data/j269.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_269 (k : Nat) : List Nat :=
  [J269.L0]
def JW_269 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_269 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_269 k) (JW_269 k)) 269 1 = true := by
  decide +kernel

theorem jm_269 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_269 k) (JW_269 k)) 269 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_269 k) (JW_269 k)) 269 1 = true := jr_269
  exact h0

end B334.E1x.Pts.S708
