#e1lits B334.E1x.Pts.S708.J31020 "../data/j31020.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_31020 (k : Nat) : List Nat :=
  cond (Nat.blt k 31021) ([J31020.L0]) ([J31020.L1])
def JW_31020 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 31021) ([[]]) ([[]])

end

theorem jr_31020 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_31020 k) (JW_31020 k)) 31020 2 = true := by
  decide +kernel

theorem jm_31020 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_31020 k) (JW_31020 k)) 31020 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_31020 k) (JW_31020 k)) 31020 2 = true := jr_31020
  exact h0

end B334.E1x.Pts.S708
