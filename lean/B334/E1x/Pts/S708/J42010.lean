def JL_42010 (k : Nat) : List Nat :=
  cond (Nat.blt k 42012) (cond (Nat.blt k 42011) ([J42010.L0]) ([J42010.L1])) (cond (Nat.blt k 42013) ([J42010.L2]) (cond (Nat.blt k 42014) ([J42010.L3]) ([J42010.L4])))
def JW_42010 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 42012) (cond (Nat.blt k 42011) ([[]]) ([[]])) (cond (Nat.blt k 42013) ([[]]) (cond (Nat.blt k 42014) ([[]]) ([[]])))

end

theorem jr_42010 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_42010 k) (JW_42010 k)) 42010 5 = true := by
  decide +kernel

theorem jm_42010 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_42010 k) (JW_42010 k)) 42010 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_42010 k) (JW_42010 k)) 42010 5 = true := jr_42010
  exact h0

