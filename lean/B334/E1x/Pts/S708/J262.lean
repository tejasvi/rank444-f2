import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 262 … 265 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J262 "../data/j262.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_262 (k : Nat) : List Nat :=
  cond (Nat.blt k 264) (cond (Nat.blt k 263) ([J262.L0]) ([J262.L1])) (cond (Nat.blt k 265) ([J262.L2]) ([J262.L3]))
def JW_262 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 264) (cond (Nat.blt k 263) ([[]]) ([[]])) (cond (Nat.blt k 265) ([[]]) ([[]]))

end

theorem jr_262 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_262 k) (JW_262 k)) 262 4 = true := by
  decide +kernel

theorem jm_262 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_262 k) (JW_262 k)) 262 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_262 k) (JW_262 k)) 262 4 = true := jr_262
  exact h0

end B334.E1x.Pts.S708
