import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 48140 … 48141 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J48140 "../data/j48140.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_48140 (k : Nat) : List Nat :=
  cond (Nat.blt k 48141) ([J48140.L0]) ([J48140.L1])
def JW_48140 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 48141) ([[]]) ([[]])

end

theorem jr_48140 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_48140 k) (JW_48140 k)) 48140 2 = true := by
  decide +kernel

theorem jm_48140 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_48140 k) (JW_48140 k)) 48140 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_48140 k) (JW_48140 k)) 48140 2 = true := jr_48140
  exact h0

end B334.E1x.Pts.S708
