set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 3580 … 3584 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J3580 "../data/j3580.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_3580 (k : Nat) : List Nat :=
  cond (Nat.blt k 3582) (cond (Nat.blt k 3581) ([J3580.L0]) ([J3580.L1])) (cond (Nat.blt k 3583) ([J3580.L2]) (cond (Nat.blt k 3584) ([J3580.L3]) ([J3580.L4])))
def JW_3580 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 3582) (cond (Nat.blt k 3581) ([[]]) ([[]])) (cond (Nat.blt k 3583) ([[]]) (cond (Nat.blt k 3584) ([[]]) ([[]])))

end

theorem jr_3580 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_3580 k) (JW_3580 k)) 3580 5 = true := by
  decide +kernel

theorem jm_3580 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_3580 k) (JW_3580 k)) 3580 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_3580 k) (JW_3580 k)) 3580 5 = true := jr_3580
  exact h0

end B334.E1x.Pts.S708
