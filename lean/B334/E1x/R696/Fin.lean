theorem glues : glueChk BLK.lits W = true := by decide +kernel
theorem root : BLK.lits.getD 0 0 % 2 ^ 13 = 0 := by decide +kernel

theorem concl (hhi : Tab2.HighHyp 696) : E1Concl Em 23 :=
  e1_sound C Em LB LBR UB UBR Ntab nrows sl tab GE ipok (rows hhi) (fun _ h => by simp [C, LFn] at h)
    BLK.lits (by rw [nlits]; decide) root
    (fun i hi => blkChk_spec C sl UB UBR BLK.lits 143 blks i (by rw [nlits] at hi; exact hi))
    (glueChk_spec BLK.lits W glues)

theorem one_ok : oneOK Em 2 = true := by decide +kernel
theorem em_ok : emOK Em (Tab2.basisOf 696) = true := by decide +kernel
theorem lb_eq : Tab2.lbOf 696 = 23 + 1 := by decide

/-- **The run of class 696** -/
theorem run_696 (hhi : Tab2.HighHyp 696) : RowValid (Tab2.basisOf 696) (Tab2.lbOf 696) := by
  rw [lb_eq]
  exact rowValid_of_e1 (ClsChk.basis_lt 696 (by decide)) (concl hhi) one_ok em_ok

/-- the run in the dispatcher's list form -/
theorem runsFor : Tab2.RunsFor [696] := fun c hc hhi => by
  rw [List.mem_singleton] at hc
  subst hc
  exact run_696 hhi

