import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 18507 … 18508 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J18507 "../data/j18507.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_18507 (k : Nat) : List Nat :=
  cond (Nat.blt k 18508) ([J18507.L0]) ([J18507.L1])
def JW_18507 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 18508) ([[]]) ([[]])

end

theorem jr_18507 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_18507 k) (JW_18507 k)) 18507 2 = true := by
  decide +kernel

theorem jm_18507 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_18507 k) (JW_18507 k)) 18507 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_18507 k) (JW_18507 k)) 18507 2 = true := jr_18507
  exact h0

end B334.E1x.Pts.S708
