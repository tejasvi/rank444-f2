theorem em_ok : emOK Em (Tab2.basisOf 618) = true := by decide +kernel
theorem lb_eq : Tab2.lbOf 618 = 23 + 1 := by decide

/-- **The run of class 618** -/
theorem run_618 (hhi : Tab2.HighHyp 618) : RowValid (Tab2.basisOf 618) (Tab2.lbOf 618) := by
  rw [lb_eq]
  exact rowValid_of_e1 (ClsChk.basis_lt 618 (by decide)) (concl hhi) one_ok em_ok

/-- the run in the dispatcher's list form -/
theorem runsFor : Tab2.RunsFor [618] := fun c hc hhi => by
  rw [List.mem_singleton] at hc
  subst hc
  exact run_618 hhi

