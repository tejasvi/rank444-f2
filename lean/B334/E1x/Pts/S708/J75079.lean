import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 75079 … 75080 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J75079 "../data/j75079.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_75079 (k : Nat) : List Nat :=
  cond (Nat.blt k 75080) ([J75079.L0]) ([J75079.L1])
def JW_75079 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 75080) ([[]]) ([[]])

end

theorem jr_75079 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_75079 k) (JW_75079 k)) 75079 2 = true := by
  decide +kernel

theorem jm_75079 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_75079 k) (JW_75079 k)) 75079 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_75079 k) (JW_75079 k)) 75079 2 = true := jr_75079
  exact h0

end B334.E1x.Pts.S708
