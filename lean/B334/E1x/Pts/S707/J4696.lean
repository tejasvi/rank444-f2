/-! # Jobs 4696 … 4697 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J4696 "../data/j4696.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_4696 (k : Nat) : List Nat :=
  cond (Nat.blt k 4697) ([J4696.L0]) ([J4696.L1])
def JW_4696 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 4697) ([[]]) ([[]])

end

theorem jr_4696 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_4696 k) (JW_4696 k)) 4696 2 = true := by
  decide +kernel

end B334.E1x.Pts.S707
