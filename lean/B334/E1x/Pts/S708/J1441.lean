import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1441 … 1444 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1441 "../data/j1441.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1441 (k : Nat) : List Nat :=
  cond (Nat.blt k 1443) (cond (Nat.blt k 1442) ([J1441.L0]) ([J1441.L1])) (cond (Nat.blt k 1444) ([J1441.L2]) ([J1441.L3]))
def JW_1441 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1443) (cond (Nat.blt k 1442) ([[]]) ([[]])) (cond (Nat.blt k 1444) ([[]]) ([[]]))

end

theorem jr_1441 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1441 k) (JW_1441 k)) 1441 4 = true := by
  decide +kernel

theorem jm_1441 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1441 k) (JW_1441 k)) 1441 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1441 k) (JW_1441 k)) 1441 4 = true := jr_1441
  exact h0

end B334.E1x.Pts.S708
