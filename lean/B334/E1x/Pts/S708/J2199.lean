import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2199 … 2204 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J2199 "../data/j2199.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_2199 (k : Nat) : List Nat :=
  cond (Nat.blt k 2202) (cond (Nat.blt k 2200) ([J2199.L0]) (cond (Nat.blt k 2201) ([J2199.L1]) ([J2199.L2]))) (cond (Nat.blt k 2203) ([J2199.L3]) (cond (Nat.blt k 2204) ([J2199.L4]) ([J2199.L5])))
def JW_2199 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2202) (cond (Nat.blt k 2200) ([[]]) (cond (Nat.blt k 2201) ([[]]) ([[]]))) (cond (Nat.blt k 2203) ([[]]) (cond (Nat.blt k 2204) ([[]]) ([[]])))

end

theorem jr_2199 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2199 k) (JW_2199 k)) 2199 6 = true := by
  decide +kernel

theorem jm_2199 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2199 k) (JW_2199 k)) 2199 6 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2199 k) (JW_2199 k)) 2199 6 = true := jr_2199
  exact h0

end B334.E1x.Pts.S708
