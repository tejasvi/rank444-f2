/-! # Jobs 746 … 750 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J746 "../data/j746.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_746 (k : Nat) : List Nat :=
  cond (Nat.blt k 748) (cond (Nat.blt k 747) ([J746.L0]) ([J746.L1])) (cond (Nat.blt k 749) ([J746.L2]) (cond (Nat.blt k 750) ([J746.L3]) ([J746.L4])))
def JW_746 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 748) (cond (Nat.blt k 747) ([[]]) ([[]])) (cond (Nat.blt k 749) ([[]]) (cond (Nat.blt k 750) ([[]]) ([[]])))

end

theorem jr_746 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_746 k) (JW_746 k)) 746 5 = true := by
  decide +kernel

end B334.E1x.Pts.S707
