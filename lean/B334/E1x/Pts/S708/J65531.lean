import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 65531 … 65534 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J65531 "../data/j65531.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_65531 (k : Nat) : List Nat :=
  cond (Nat.blt k 65533) (cond (Nat.blt k 65532) ([J65531.L0]) ([J65531.L1])) (cond (Nat.blt k 65534) ([J65531.L2]) ([J65531.L3]))
def JW_65531 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 65533) (cond (Nat.blt k 65532) ([[]]) ([[]])) (cond (Nat.blt k 65534) ([[]]) ([[]]))

end

theorem jr_65531 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_65531 k) (JW_65531 k)) 65531 4 = true := by
  decide +kernel

theorem jm_65531 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_65531 k) (JW_65531 k)) 65531 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_65531 k) (JW_65531 k)) 65531 4 = true := jr_65531
  exact h0

end B334.E1x.Pts.S708
