end

theorem jr_1883 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1883 k) (JW_1883 k)) 1883 1 = true := by
  decide +kernel

theorem jm_1883 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1883 k) (JW_1883 k)) 1883 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1883 k) (JW_1883 k)) 1883 1 = true := jr_1883
