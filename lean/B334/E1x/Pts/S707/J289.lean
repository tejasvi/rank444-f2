import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 289 … 292 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J289 "../data/j289.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_289 (k : Nat) : List Nat :=
  cond (Nat.blt k 291) (cond (Nat.blt k 290) ([J289.L0]) ([J289.L1])) (cond (Nat.blt k 292) ([J289.L2]) ([J289.L3]))
def JW_289 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 291) (cond (Nat.blt k 290) ([[]]) ([[]])) (cond (Nat.blt k 292) ([[]]) ([[]]))

end

theorem jr_289 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_289 k) (JW_289 k)) 289 2 = true := by
  decide +kernel
theorem jr_291 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_289 k) (JW_289 k)) 291 1 = true := by
  decide +kernel
theorem jr_292 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_289 k) (JW_289 k)) 292 1 = true := by
  decide +kernel

end B334.E1x.Pts.S707
