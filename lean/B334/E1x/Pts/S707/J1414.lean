import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1414 … 1414 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J1414 "../data/j1414.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_1414 (k : Nat) : List Nat :=
  [J1414.L0]
def JW_1414 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_1414 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_1414 k) (JW_1414 k)) 1414 1 = true := by
  decide +kernel

end B334.E1x.Pts.S707
