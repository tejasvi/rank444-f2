import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 167 … 169 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J167 "../data/j167.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_167 (k : Nat) : List Nat :=
  cond (Nat.blt k 168) ([J167.L0]) (cond (Nat.blt k 169) ([J167.L1]) ([J167.L2]))
def JW_167 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 168) ([[]]) (cond (Nat.blt k 169) ([[]]) ([[]]))

end

theorem jr_167 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_167 k) (JW_167 k)) 167 3 = true := by
  decide +kernel

theorem jm_167 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_167 k) (JW_167 k)) 167 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_167 k) (JW_167 k)) 167 3 = true := jr_167
  exact h0

end B334.E1x.Pts.S708
