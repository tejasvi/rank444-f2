import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 25808 … 25808 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J25808 "../data/j25808.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_25808 (k : Nat) : List Nat :=
  [J25808.L0]
def JW_25808 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_25808 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25808 k) (JW_25808 k)) 25808 1 = true := by
  decide +kernel

theorem jm_25808 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25808 k) (JW_25808 k)) 25808 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25808 k) (JW_25808 k)) 25808 1 = true := jr_25808
  exact h0

end B334.E1x.Pts.S708
