import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 112250 … 112252 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J112250 "../data/j112250.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_112250 (k : Nat) : List Nat :=
  cond (Nat.blt k 112251) ([J112250.L0]) (cond (Nat.blt k 112252) ([J112250.L1]) ([J112250.L2]))
def JW_112250 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 112251) ([[]]) (cond (Nat.blt k 112252) ([[]]) ([[]]))

end

theorem jr_112250 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_112250 k) (JW_112250 k)) 112250 3 = true := by
  decide +kernel

theorem jm_112250 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_112250 k) (JW_112250 k)) 112250 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_112250 k) (JW_112250 k)) 112250 3 = true := jr_112250
  exact h0

end B334.E1x.Pts.S708
