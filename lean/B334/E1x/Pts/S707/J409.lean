import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 409 … 411 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J409 "../data/j409.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_409 (k : Nat) : List Nat :=
  cond (Nat.blt k 410) ([J409.L0]) (cond (Nat.blt k 411) ([J409.L1]) ([J409.L2]))
def JW_409 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 410) ([[]]) (cond (Nat.blt k 411) ([[]]) ([[]]))

end

theorem jr_409 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_409 k) (JW_409 k)) 409 3 = true := by
  decide +kernel

end B334.E1x.Pts.S707
