theorem jr_42008 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_42008 k) (JW_42008 k)) 42008 1 = true := by
  decide +kernel

theorem jm_42008 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_42008 k) (JW_42008 k)) 42008 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_42008 k) (JW_42008 k)) 42008 1 = true := jr_42008
