set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 16089 … 16089 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J16089 "../data/j16089.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_16089 (k : Nat) : List Nat :=
  [J16089.L0]
def JW_16089 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_16089 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_16089 k) (JW_16089 k)) 16089 1 = true := by
  decide +kernel

theorem jm_16089 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_16089 k) (JW_16089 k)) 16089 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_16089 k) (JW_16089 k)) 16089 1 = true := jr_16089
  exact h0

end B334.E1x.Pts.S708
