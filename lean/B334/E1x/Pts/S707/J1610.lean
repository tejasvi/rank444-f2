set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1610 … 1614 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J1610 "../data/j1610.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_1610 (k : Nat) : List Nat :=
  cond (Nat.blt k 1612) (cond (Nat.blt k 1611) ([J1610.L0]) ([J1610.L1])) (cond (Nat.blt k 1613) ([J1610.L2]) (cond (Nat.blt k 1614) ([J1610.L3]) ([J1610.L4])))
def JW_1610 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1612) (cond (Nat.blt k 1611) ([[]]) ([[]])) (cond (Nat.blt k 1613) ([[]]) (cond (Nat.blt k 1614) ([[]]) ([[]])))

end

theorem jr_1610 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_1610 k) (JW_1610 k)) 1610 5 = true := by
  decide +kernel

end B334.E1x.Pts.S707
