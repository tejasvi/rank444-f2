import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1684 … 1687 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1684 "../data/j1684.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1684 (k : Nat) : List Nat :=
  cond (Nat.blt k 1686) (cond (Nat.blt k 1685) ([J1684.L0]) ([J1684.L1])) (cond (Nat.blt k 1687) ([J1684.L2]) ([J1684.L3]))
def JW_1684 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1686) (cond (Nat.blt k 1685) ([[]]) ([[]])) (cond (Nat.blt k 1687) ([[]]) ([[]]))

end

theorem jr_1684 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1684 k) (JW_1684 k)) 1684 4 = true := by
  decide +kernel

theorem jm_1684 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1684 k) (JW_1684 k)) 1684 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1684 k) (JW_1684 k)) 1684 4 = true := jr_1684
  exact h0

end B334.E1x.Pts.S708
