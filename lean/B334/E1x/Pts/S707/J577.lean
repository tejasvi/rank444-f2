def JW_577 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 579) (cond (Nat.blt k 578) ([[]]) ([[]])) (cond (Nat.blt k 580) ([[]]) (cond (Nat.blt k 581) ([[]]) ([[]])))

end

theorem jr_577 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_577 k) (JW_577 k)) 577 5 = true := by
