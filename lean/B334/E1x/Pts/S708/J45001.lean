/-! # Jobs 45001 … 45004 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J45001 "../data/j45001.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_45001 (k : Nat) : List Nat :=
  cond (Nat.blt k 45003) (cond (Nat.blt k 45002) ([J45001.L0]) ([J45001.L1])) (cond (Nat.blt k 45004) ([J45001.L2]) ([J45001.L3]))
def JW_45001 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 45003) (cond (Nat.blt k 45002) ([[]]) ([[]])) (cond (Nat.blt k 45004) ([[]]) ([[]]))

end

theorem jr_45001 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_45001 k) (JW_45001 k)) 45001 4 = true := by
  decide +kernel

theorem jm_45001 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_45001 k) (JW_45001 k)) 45001 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_45001 k) (JW_45001 k)) 45001 4 = true := jr_45001
  exact h0

end B334.E1x.Pts.S708
