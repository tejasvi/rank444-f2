import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 70707 … 70708 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J70707 "../data/j70707.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_70707 (k : Nat) : List Nat :=
  cond (Nat.blt k 70708) ([J70707.L0]) ([J70707.L1])
def JW_70707 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 70708) ([[]]) ([[]])

end

theorem jr_70707 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_70707 k) (JW_70707 k)) 70707 2 = true := by
  decide +kernel

theorem jm_70707 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_70707 k) (JW_70707 k)) 70707 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_70707 k) (JW_70707 k)) 70707 2 = true := jr_70707
  exact h0

end B334.E1x.Pts.S708
