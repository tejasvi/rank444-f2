import B334.E1x.Pts.H708.Data
import B334.E1x.RTE
import B334.E1x.ClsTab
import B334.E1x.IPChk
import B334.Tab2.Data

/-! # The per-slot check of `Pts.H708` (generated by a script): the slot function agrees with the entry's slot, the entry's
dual vectors lie in the domain, the entry passes `RT.entryOK` against the class table `ClsTab.CL`, and its class is one the
run's hypothesis covers (`c < nCls` and of larger dimension than the run's class 708, as in `RunHyp`,
`Tab2/Induct.lean`). -/

namespace B334.E1x.Pts.H708

noncomputable def entF (i : Nat) : Bool :=
  SlotP.dualIn DOM (tab i) && RT.entryOK R ClsTab.CL (tab i) && Nat.beq (sl i) (SlotP.slot LB LBR (tab i)) &&
    Nat.blt (RT.eCls (tab i)) Tab2.nCls &&
    Nat.blt (Tab2.basisOf 708).length (Tab2.basisOf (RT.eCls (tab i))).length

end B334.E1x.Pts.H708
