/-! # Jobs 52089 … 52090 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J52089 "../data/j52089.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_52089 (k : Nat) : List Nat :=
  cond (Nat.blt k 52090) ([J52089.L0]) ([J52089.L1])
def JW_52089 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 52090) ([[]]) ([[]])

end

theorem jr_52089 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_52089 k) (JW_52089 k)) 52089 2 = true := by
  decide +kernel

theorem jm_52089 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_52089 k) (JW_52089 k)) 52089 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_52089 k) (JW_52089 k)) 52089 2 = true := jr_52089
  exact h0

end B334.E1x.Pts.S708
