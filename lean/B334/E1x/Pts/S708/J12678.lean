import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 12678 … 12682 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J12678 "../data/j12678.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_12678 (k : Nat) : List Nat :=
  cond (Nat.blt k 12680) (cond (Nat.blt k 12679) ([J12678.L0]) ([J12678.L1])) (cond (Nat.blt k 12681) ([J12678.L2]) (cond (Nat.blt k 12682) ([J12678.L3]) ([J12678.L4])))
def JW_12678 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 12680) (cond (Nat.blt k 12679) ([[]]) ([[]])) (cond (Nat.blt k 12681) ([[]]) (cond (Nat.blt k 12682) ([[]]) ([[]])))

end

theorem jr_12678 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12678 k) (JW_12678 k)) 12678 5 = true := by
  decide +kernel

theorem jm_12678 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12678 k) (JW_12678 k)) 12678 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12678 k) (JW_12678 k)) 12678 5 = true := jr_12678
  exact h0

end B334.E1x.Pts.S708
