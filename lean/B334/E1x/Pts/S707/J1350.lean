set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1350 … 1351 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J1350 "../data707/j1350.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_1350 (k : Nat) : List Nat :=
  cond (Nat.blt k 1351) ([J1350.L0]) ([J1350.L1])
def JW_1350 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1351) ([[]]) ([[]])

end

theorem jr_1350 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_1350 k) (JW_1350 k)) 1350 2 = true := by
  decide +kernel

end B334.E1x.Pts.S707
