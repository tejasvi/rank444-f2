import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 56000 … 56005 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J56000 "../data/j56000.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_56000 (k : Nat) : List Nat :=
  cond (Nat.blt k 56003) (cond (Nat.blt k 56001) ([J56000.L0]) (cond (Nat.blt k 56002) ([J56000.L1]) ([J56000.L2]))) (cond (Nat.blt k 56004) ([J56000.L3]) (cond (Nat.blt k 56005) ([J56000.L4]) ([J56000.L5])))
def JW_56000 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 56003) (cond (Nat.blt k 56001) ([[]]) (cond (Nat.blt k 56002) ([[]]) ([[]]))) (cond (Nat.blt k 56004) ([[]]) (cond (Nat.blt k 56005) ([[]]) ([[]])))

end

theorem jr_56000 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_56000 k) (JW_56000 k)) 56000 6 = true := by
  decide +kernel

theorem jm_56000 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_56000 k) (JW_56000 k)) 56000 6 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_56000 k) (JW_56000 k)) 56000 6 = true := jr_56000
  exact h0

end B334.E1x.Pts.S708
