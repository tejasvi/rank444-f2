end

theorem jr_1693 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_1693 k) (JW_1693 k)) 1693 1 = true := by
  decide +kernel

end B334.E1x.Pts.S707
