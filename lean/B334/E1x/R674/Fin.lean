theorem glues : glueChk BLK.lits W = true := by decide +kernel
theorem root : BLK.lits.getD 0 0 % 2 ^ 13 = 0 := by decide +kernel

/-- every leaf of the run is covered by its T2 record (identity permutation) -/
theorem leafChk : LI.all (fun q => Nat.blt q.2 T2.leaves_674.length &&
    B334.BCP.t2match (T2.leaves_674.getD q.2 0) (termsOf R VT q.1) R DOM (List.range R)) = true := by
  decide +kernel

theorem hLF : ∀ pl, C.LF pl = true → B334.BCP.NoDecomp (termsOf C.R C.VT pl) C.R C.DOM := by
  intro pl h
  change LI.any (fun q => Nat.beq q.1 pl) = true at h
  obtain ⟨q, hq, hqe⟩ := List.any_eq_true.mp h
  have hc := List.all_eq_true.mp leafChk q hq
  simp only [Bool.and_eq_true, Nat.blt_eq] at hc
  have hm : T2.leaves_674.getD q.2 0 ∈ T2.leaves_674 := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hc.1, Option.getD_some]
    exact List.getElem_mem hc.1
  rw [← Nat.eq_of_beq_eq_true hqe]
  exact B334.BCP.noDecomp_of_t2 (List.range R) hc.2 (T2.ok_674 _ hm)

theorem concl (hhi : Tab2.HighHyp 674) : E1Concl Em 23 :=
  e1_sound C Em LB LBR UB UBR Ntab nrows sl tab GE ipok (rows hhi) hLF
    BLK.lits (by rw [nlits]; decide) root
    (fun i hi => blkChk_spec C sl UB UBR BLK.lits 711 blks i (by rw [nlits] at hi; exact hi))
    (glueChk_spec BLK.lits W glues)

theorem one_ok : oneOK Em 5 = true := by decide +kernel
theorem em_ok : emOK Em (Tab2.basisOf 674) = true := by decide +kernel
theorem lb_eq : Tab2.lbOf 674 = 23 + 1 := by decide

/-- **The run of class 674** -/
theorem run_674 (hhi : Tab2.HighHyp 674) : RowValid (Tab2.basisOf 674) (Tab2.lbOf 674) := by
  rw [lb_eq]
  exact rowValid_of_e1 (ClsChk.basis_lt 674 (by decide)) (concl hhi) one_ok em_ok

/-- the run in the dispatcher's list form -/
theorem runsFor : Tab2.RunsFor [674] := fun c hc hhi => by
  rw [List.mem_singleton] at hc
  subst hc
  exact run_674 hhi

