import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 159 … 163 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J159 "../data/j159.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_159 (k : Nat) : List Nat :=
  cond (Nat.blt k 161) (cond (Nat.blt k 160) ([J159.L0]) ([J159.L1])) (cond (Nat.blt k 162) ([J159.L2]) (cond (Nat.blt k 163) ([J159.L3]) ([J159.L4])))
def JW_159 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 161) (cond (Nat.blt k 160) ([[]]) ([[]])) (cond (Nat.blt k 162) ([[]]) (cond (Nat.blt k 163) ([[]]) ([[]])))

end

theorem jr_159 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_159 k) (JW_159 k)) 159 5 = true := by
  decide +kernel

end B334.E1x.Pts.S707
