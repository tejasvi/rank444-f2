import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 4998 … 5000 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J4998 "../data/j4998.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_4998 (k : Nat) : List Nat :=
  cond (Nat.blt k 4999) ([J4998.L0]) (cond (Nat.blt k 5000) ([J4998.L1]) ([J4998.L2]))
def JW_4998 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 4999) ([[]]) (cond (Nat.blt k 5000) ([[]]) ([[]]))

end

theorem jr_4998 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_4998 k) (JW_4998 k)) 4998 3 = true := by
  decide +kernel

theorem jm_4998 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_4998 k) (JW_4998 k)) 4998 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_4998 k) (JW_4998 k)) 4998 3 = true := jr_4998
  exact h0

end B334.E1x.Pts.S708
