theorem kb_40_0 : IPChk.allR (fun i => E1P.block CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (K40.lits.getD i 0)) 0 2 = true := by
  decide +kernel
theorem kg_40_0 : IPChk.allR (Pts.glueIB K40.lits KW_40) 0 2 = true := by decide +kernel
theorem kb_40_2 : IPChk.allR (fun i => E1P.block CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (K40.lits.getD i 0)) 2 2 = true := by
