/-! # Jobs 15044 … 15045 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J15044 "../data/j15044.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_15044 (k : Nat) : List Nat :=
  cond (Nat.blt k 15045) ([J15044.L0]) ([J15044.L1])
def JW_15044 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 15045) ([[]]) ([[]])

end

theorem jr_15044 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_15044 k) (JW_15044 k)) 15044 2 = true := by
  decide +kernel

theorem jm_15044 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_15044 k) (JW_15044 k)) 15044 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_15044 k) (JW_15044 k)) 15044 2 = true := jr_15044
  exact h0

end B334.E1x.Pts.S708
