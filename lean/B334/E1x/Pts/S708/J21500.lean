import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 21500 … 21501 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J21500 "../data/j21500.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_21500 (k : Nat) : List Nat :=
  cond (Nat.blt k 21501) ([J21500.L0]) ([J21500.L1])
def JW_21500 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 21501) ([[]]) ([[]])

end

theorem jr_21500 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_21500 k) (JW_21500 k)) 21500 2 = true := by
  decide +kernel

theorem jm_21500 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_21500 k) (JW_21500 k)) 21500 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_21500 k) (JW_21500 k)) 21500 2 = true := jr_21500
  exact h0

end B334.E1x.Pts.S708
