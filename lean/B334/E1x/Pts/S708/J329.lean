/-! # Jobs 329 … 333 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J329 "../data/j329.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_329 (k : Nat) : List Nat :=
  cond (Nat.blt k 331) (cond (Nat.blt k 330) ([J329.L0]) ([J329.L1])) (cond (Nat.blt k 332) ([J329.L2]) (cond (Nat.blt k 333) ([J329.L3]) ([J329.L4])))
def JW_329 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 331) (cond (Nat.blt k 330) ([[]]) ([[]])) (cond (Nat.blt k 332) ([[]]) (cond (Nat.blt k 333) ([[]]) ([[]])))

end

theorem jr_329 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_329 k) (JW_329 k)) 329 5 = true := by
  decide +kernel

theorem jm_329 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_329 k) (JW_329 k)) 329 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_329 k) (JW_329 k)) 329 5 = true := jr_329
  exact h0

end B334.E1x.Pts.S708
