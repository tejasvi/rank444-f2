import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 249 … 251 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J249 "../data/j249.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_249 (k : Nat) : List Nat :=
  cond (Nat.blt k 250) ([J249.L0]) (cond (Nat.blt k 251) ([J249.L1]) ([J249.L2]))
def JW_249 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 250) ([[]]) (cond (Nat.blt k 251) ([[]]) ([[]]))

end

theorem jr_249 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_249 k) (JW_249 k)) 249 3 = true := by
  decide +kernel

theorem jm_249 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_249 k) (JW_249 k)) 249 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_249 k) (JW_249 k)) 249 3 = true := jr_249
  exact h0

end B334.E1x.Pts.S708
