/-! # Jobs 53990 … 53993 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J53990 "../data/j53990.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_53990 (k : Nat) : List Nat :=
  cond (Nat.blt k 53992) (cond (Nat.blt k 53991) ([J53990.L0]) ([J53990.L1])) (cond (Nat.blt k 53993) ([J53990.L2]) ([J53990.L3]))
def JW_53990 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 53992) (cond (Nat.blt k 53991) ([[]]) ([[]])) (cond (Nat.blt k 53993) ([[]]) ([[]]))

end

theorem jr_53990 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_53990 k) (JW_53990 k)) 53990 4 = true := by
  decide +kernel

theorem jm_53990 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_53990 k) (JW_53990 k)) 53990 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_53990 k) (JW_53990 k)) 53990 4 = true := jr_53990
  exact h0

end B334.E1x.Pts.S708
