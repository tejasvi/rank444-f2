import B334.E1x.R610.OK
import B334.E1x.R610.B0
import B334.T2.Index
import B334.BCP.PermL
import B334.E1x.Bridge
import B334.Tab2.Dispatch

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # The run of class 610 (R = 23): `E1Concl Em 23` and its row (generated by a script)

The run is the list `BLK.lits` of 10 pieces (by a script: the trace block split into a mode-0 root and
mode-1 / restart pieces), checked in `B0` … `B0` (`blkChk`) and glued by the witness table `W` (`glueChk`). It is replayed here
against the IP's own slot function `sl` (slots from the row-table entries). With `ipok` and `rows`, `E1GS.e1_sound`
gives `E1Concl Em 23`; `rowValid_of_e1` (padding, `oneOK`, `emOK`) then gives the class's row at `lbOf 610 = 24`.
`run_610 : Tab2.HighHyp 610 → RowValid (Tab2.basisOf 610) (Tab2.lbOf 610)` is the form `Tab2/Dispatch.lean` takes. -/

namespace B334.E1x.R610
open B334.E1x.E1GS

/-- the glue witnesses: record `j` of piece `i` is glued to piece `W[i][j]` -/
def W : List (List Nat) := [[1, 2], [3], [4], [5, 6], [], [], [7, 8, 9], [], [], []]

theorem nlits : BLK.lits.length = 10 := by decide
theorem blks : blkChk C sl UB UBR BLK.lits 0 10 = true := by
  have h0 : blkChk C sl UB UBR BLK.lits 0 4 = true := blk_0
  have h1 : blkChk C sl UB UBR BLK.lits 0 5 = true :=
    blkChk_join C sl UB UBR BLK.lits 0 4 1 h0 blk_4
  have h2 : blkChk C sl UB UBR BLK.lits 0 8 = true :=
    blkChk_join C sl UB UBR BLK.lits 0 5 3 h1 blk_5
  have h3 : blkChk C sl UB UBR BLK.lits 0 10 = true :=
    blkChk_join C sl UB UBR BLK.lits 0 8 2 h2 blk_8
  exact h3
theorem glues : glueChk BLK.lits W = true := by decide +kernel
theorem root : BLK.lits.getD 0 0 % 2 ^ 13 = 0 := by decide +kernel

/-- every leaf of the run is covered by its T2 record (identity permutation) -/
theorem leafChk : LI.all (fun q => Nat.blt q.2 T2.leaves_610.length &&
    B334.BCP.t2match (T2.leaves_610.getD q.2 0) (termsOf R VT q.1) R DOM (List.range R)) = true := by
  decide +kernel

theorem hLF : ∀ pl, C.LF pl = true → B334.BCP.NoDecomp (termsOf C.R C.VT pl) C.R C.DOM := by
  intro pl h
  change LI.any (fun q => Nat.beq q.1 pl) = true at h
  obtain ⟨q, hq, hqe⟩ := List.any_eq_true.mp h
  have hc := List.all_eq_true.mp leafChk q hq
  simp only [Bool.and_eq_true, Nat.blt_eq] at hc
  have hm : T2.leaves_610.getD q.2 0 ∈ T2.leaves_610 := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hc.1, Option.getD_some]
    exact List.getElem_mem hc.1
  rw [← Nat.eq_of_beq_eq_true hqe]
  exact B334.BCP.noDecomp_of_t2 (List.range R) hc.2 (T2.ok_610 _ hm)

theorem concl (hhi : Tab2.HighHyp 610) : E1Concl Em 23 :=
  e1_sound C Em LB LBR UB UBR Ntab nrows sl tab GE ipok (rows hhi) hLF
    BLK.lits (by rw [nlits]; decide) root
    (fun i hi => blkChk_spec C sl UB UBR BLK.lits 10 blks i (by rw [nlits] at hi; exact hi))
    (glueChk_spec BLK.lits W glues)

theorem one_ok : oneOK Em 10 = true := by decide +kernel
theorem em_ok : emOK Em (Tab2.basisOf 610) = true := by decide +kernel
theorem lb_eq : Tab2.lbOf 610 = 23 + 1 := by decide

/-- **The run of class 610** -/
theorem run_610 (hhi : Tab2.HighHyp 610) : RowValid (Tab2.basisOf 610) (Tab2.lbOf 610) := by
  rw [lb_eq]
  exact rowValid_of_e1 (ClsChk.basis_lt 610 (by decide)) (concl hhi) one_ok em_ok

/-- the run in the dispatcher's list form -/
theorem runsFor : Tab2.RunsFor [610] := fun c hc hhi => by
  rw [List.mem_singleton] at hc
  subst hc
  exact run_610 hhi

end B334.E1x.R610
