set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 36091 … 36092 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J36091 "../data/j36091.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_36091 (k : Nat) : List Nat :=
  cond (Nat.blt k 36092) ([J36091.L0]) ([J36091.L1])
def JW_36091 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 36092) ([[]]) ([[]])

end

theorem jr_36091 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_36091 k) (JW_36091 k)) 36091 2 = true := by
  decide +kernel

theorem jm_36091 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_36091 k) (JW_36091 k)) 36091 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_36091 k) (JW_36091 k)) 36091 2 = true := jr_36091
  exact h0

end B334.E1x.Pts.S708
