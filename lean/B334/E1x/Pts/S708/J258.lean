import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 258 … 260 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J258 "../data/j258.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_258 (k : Nat) : List Nat :=
  cond (Nat.blt k 259) ([J258.L0]) (cond (Nat.blt k 260) ([J258.L1]) ([J258.L2]))
def JW_258 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 259) ([[]]) (cond (Nat.blt k 260) ([[]]) ([[]]))

end

theorem jr_258 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_258 k) (JW_258 k)) 258 3 = true := by
  decide +kernel

theorem jm_258 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_258 k) (JW_258 k)) 258 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_258 k) (JW_258 k)) 258 3 = true := jr_258
  exact h0

end B334.E1x.Pts.S708
