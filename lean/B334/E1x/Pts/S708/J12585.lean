set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 12585 … 12585 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J12585 "../data/j12585.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_12585 (k : Nat) : List Nat :=
  [J12585.L0]
def JW_12585 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_12585 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12585 k) (JW_12585 k)) 12585 1 = true := by
  decide +kernel

theorem jm_12585 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12585 k) (JW_12585 k)) 12585 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12585 k) (JW_12585 k)) 12585 1 = true := jr_12585
  exact h0

end B334.E1x.Pts.S708
