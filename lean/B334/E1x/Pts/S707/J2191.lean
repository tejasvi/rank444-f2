import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2191 … 2192 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J2191 "../data707/j2191.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_2191 (k : Nat) : List Nat :=
  cond (Nat.blt k 2192) ([J2191.L0]) ([J2191.L1])
def JW_2191 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2192) ([[]]) ([[]])

end

theorem jr_2191 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_2191 k) (JW_2191 k)) 2191 2 = true := by
  decide +kernel

end B334.E1x.Pts.S707
