/-! # Jobs 35084 … 35087 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J35084 "../data/j35084.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_35084 (k : Nat) : List Nat :=
  cond (Nat.blt k 35086) (cond (Nat.blt k 35085) ([J35084.L0]) ([J35084.L1])) (cond (Nat.blt k 35087) ([J35084.L2]) ([J35084.L3]))
def JW_35084 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 35086) (cond (Nat.blt k 35085) ([[]]) ([[]])) (cond (Nat.blt k 35087) ([[]]) ([[]]))

end

theorem jr_35084 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_35084 k) (JW_35084 k)) 35084 4 = true := by
  decide +kernel

theorem jm_35084 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_35084 k) (JW_35084 k)) 35084 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_35084 k) (JW_35084 k)) 35084 4 = true := jr_35084
  exact h0

end B334.E1x.Pts.S708
