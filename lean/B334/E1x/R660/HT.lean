import B334.E1x.Load

/-! # Tables of the E1G run `R660` (generated by a script; binary data files)

* `HT.entry k`: the `13 + 7 d`-bit header of job `k`'s first piece (2654 jobs; 24-byte entries).
* `Wf i j`: the glue witness of header record `j` of top-chain block `i` (`OF`: per block the offset of its first
  record in `WT`; a witness `w < 38` is a later top-chain block, `w - 38` a job). -/

#rttablew B334.E1x.R660.HT "../runs/runmulti2/R660_ht.bin" 64 192
#rttablew B334.E1x.R660.OF "../runs/runmulti2/R660_top_of.bin" 64 32
#rttablew B334.E1x.R660.WT "../runs/runmulti2/R660_top_wt.bin" 64 32

namespace B334.E1x.R660

noncomputable section

def nJ : Nat := 2654
def NT : Nat := 38
def Wf (i j : Nat) : Nat := WT.entry (OF.entry i + j)

end

end B334.E1x.R660
