import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 688 … 690 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J688 "../data/j688.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_688 (k : Nat) : List Nat :=
  cond (Nat.blt k 689) ([J688.L0]) (cond (Nat.blt k 690) ([J688.L1]) ([J688.L2]))
def JW_688 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 689) ([[]]) (cond (Nat.blt k 690) ([[]]) ([[]]))

end

theorem jr_688 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_688 k) (JW_688 k)) 688 3 = true := by
  decide +kernel

theorem jm_688 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_688 k) (JW_688 k)) 688 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_688 k) (JW_688 k)) 688 3 = true := jr_688
  exact h0

end B334.E1x.Pts.S708
