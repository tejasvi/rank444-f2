/-! # Jobs 4632 … 4635 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J4632 "../data/j4632.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_4632 (k : Nat) : List Nat :=
  cond (Nat.blt k 4634) (cond (Nat.blt k 4633) ([J4632.L0]) ([J4632.L1])) (cond (Nat.blt k 4635) ([J4632.L2]) ([J4632.L3]))
def JW_4632 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 4634) (cond (Nat.blt k 4633) ([[]]) ([[]])) (cond (Nat.blt k 4635) ([[]]) ([[]]))

end

theorem jr_4632 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_4632 k) (JW_4632 k)) 4632 4 = true := by
  decide +kernel

end B334.E1x.Pts.S707
