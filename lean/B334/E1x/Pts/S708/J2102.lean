import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2102 … 2102 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J2102 "../data/j2102.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_2102 (k : Nat) : List Nat :=
  [J2102.L0]
def JW_2102 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_2102 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2102 k) (JW_2102 k)) 2102 1 = true := by
  decide +kernel

theorem jm_2102 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2102 k) (JW_2102 k)) 2102 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2102 k) (JW_2102 k)) 2102 1 = true := jr_2102
  exact h0

end B334.E1x.Pts.S708
