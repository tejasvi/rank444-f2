import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 160 … 161 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J160 "../data/j160.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_160 (k : Nat) : List Nat :=
  cond (Nat.blt k 161) ([J160.L0]) ([J160.L1])
def JW_160 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 161) ([[]]) ([[]])

end

theorem jr_160 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_160 k) (JW_160 k)) 160 2 = true := by
  decide +kernel

theorem jm_160 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_160 k) (JW_160 k)) 160 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_160 k) (JW_160 k)) 160 2 = true := jr_160
  exact h0

end B334.E1x.Pts.S708
