import B334.E1x.R687.S0
import B334.E1x.R687.F
import B334.E1x.ClsAll

set_option maxRecDepth 100000

/-! # `E1GS.IPOK` and the row bounds of `R687` (generated by a script)

`ipok`: every field of `IPOK C Em LB LBR UB UBR Ntab nrows sl tab GE`. `rows`: the `hrow` of `E1GS.e1_sound`, from
the facts of the classes of larger dimension than the run's class 687 (`hhi`, the hypothesis of `RunHyp`,
`Tab2/Induct.lean`) through `RT.rows_of_classes'`. -/

namespace B334.E1x.R687
open B334.E1x.E1GS

theorem okAll : IPChk.allR entF 0 Ntab = true := by
  have h0 : IPChk.allR entF 0 512 = true := ok_0
  have h1 : IPChk.allR entF 0 1024 = true := IPChk.allR_join entF 0 512 512 h0 ok_512
  have h2 : IPChk.allR entF 0 1536 = true := IPChk.allR_join entF 0 1024 512 h1 ok_1024
  have h3 : IPChk.allR entF 0 2048 = true := IPChk.allR_join entF 0 1536 512 h2 ok_1536
  have h4 : IPChk.allR entF 0 2560 = true := IPChk.allR_join entF 0 2048 512 h3 ok_2048
  have h5 : IPChk.allR entF 0 2824 = true := IPChk.allR_join entF 0 2560 264 h4 ok_2560
  exact h5

theorem ent_all : ∀ i < Ntab, entF i = true := fun i hi => by
  have h := IPChk.allR_spec entF 0 Ntab okAll i hi
  rwa [Nat.zero_add] at h

theorem sl_spec : ∀ i < Ntab, sl i = SlotG.slot LB LBR (tab i) ∧ SlotG.dualIn DOM (tab i) = true := fun i hi => by
  have h := ent_all i hi
  unfold entF at h
  simp only [Bool.and_eq_true] at h
  exact ⟨Nat.eq_of_beq_eq_true h.1.1.2, h.1.1.1.1⟩

theorem sl_zero : ∀ i, Ntab ≤ i → i < 2 ^ 15 → sl i = 0 := fun i h1 _ => by
  unfold sl; exact if_neg (by omega)

theorem grp : ∀ g < 2048, GElt Em VT N (GP g) (GE g).1 (GE g).2 := by
  intro g _
  by_cases h : g < NG
  · exact gelt g h
  · have h0 : (0 : Nat) < NG := by decide
    have e1 : GP g = GP 0 := by unfold GP; rw [if_neg h, if_pos h0]
    have e2 : GE g = GE 0 := by unfold GE; rw [if_neg h, if_pos h0]
    rw [e1, e2]
    exact gelt 0 h0

theorem ipok : IPOK C Em LB LBR UB UBR Ntab nrows sl tab GE where
  N_le := N_le
  R_le := R_le
  R_pos := R_pos
  DOM_lt := DOM_lt
  cosets := cosets
  domperp := domperp
  planes := planes
  planesR := planesR
  sl_spec := sl_spec
  sl_zero := sl_zero
  Ntab_le := Ntab_le
  UB_eq := UB_eq
  UBR_eq := UBR_eq
  UB_le := UB_le
  capslot := capslot
  grp := grp

theorem hent : ∀ i < Ntab, RT.entryOK R ClsTab.CL (tab i) = true ∧
    RT.classOK ClsTab.CL Tab2.basisOf Tab2.lbOf (RT.eCls (tab i)) = true ∧
    (RT.eCls (tab i) < Tab2.nCls ∧ (Tab2.basisOf 687).length < (Tab2.basisOf (RT.eCls (tab i))).length) := by
  intro i hi
  have h := ent_all i hi
  unfold entF at h
  simp only [Bool.and_eq_true, Nat.blt_eq] at h
  exact ⟨h.1.1.1.2, ClsChk.cls_all _ (by unfold RT.eCls; exact Nat.mod_lt _ (by norm_num)), h.1.2, h.2⟩

/-- the row bounds of the IP from the classes above the run's class -/
theorem rows (hhi : ∀ c', c' < Tab2.nCls → (Tab2.basisOf 687).length < (Tab2.basisOf c').length →
      Tab2.lbOf c' ≠ 0 → RowValid (Tab2.basisOf c') (Tab2.lbOf c')) :
    ∀ i < Ntab, Fact (RT.dualM (tab i)) (R - RT.eCap (tab i)) :=
  RT.rows_of_classes' R ClsTab.CL Ntab tab Tab2.basisOf Tab2.lbOf
    (fun c => c < Tab2.nCls ∧ (Tab2.basisOf 687).length < (Tab2.basisOf c).length)
    (fun c hc => ClsChk.basis_lt c hc.1) (fun c hc _ hlb => hhi c hc.1 hc.2 hlb) hent

end B334.E1x.R687
