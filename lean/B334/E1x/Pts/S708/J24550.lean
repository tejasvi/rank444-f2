/-! # Jobs 24550 … 24551 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J24550 "../data/j24550.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_24550 (k : Nat) : List Nat :=
  cond (Nat.blt k 24551) ([J24550.L0]) ([J24550.L1])
def JW_24550 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 24551) ([[]]) ([[]])

end

theorem jr_24550 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_24550 k) (JW_24550 k)) 24550 2 = true := by
  decide +kernel

theorem jm_24550 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_24550 k) (JW_24550 k)) 24550 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_24550 k) (JW_24550 k)) 24550 2 = true := jr_24550
  exact h0

end B334.E1x.Pts.S708
