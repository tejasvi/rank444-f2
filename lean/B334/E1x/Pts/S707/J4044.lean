import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 4044 … 4045 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J4044 "../data/j4044.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_4044 (k : Nat) : List Nat :=
  cond (Nat.blt k 4045) ([J4044.L0]) ([J4044.L1])
def JW_4044 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 4045) ([[]]) ([[]])

end

theorem jr_4044 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_4044 k) (JW_4044 k)) 4044 2 = true := by
  decide +kernel

end B334.E1x.Pts.S707
