/-! # Jobs 4744 … 4745 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J4744 "../data/j4744.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_4744 (k : Nat) : List Nat :=
  cond (Nat.blt k 4745) ([J4744.L0]) ([J4744.L1])
def JW_4744 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 4745) ([[]]) ([[]])

end

theorem jr_4744 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_4744 k) (JW_4744 k)) 4744 2 = true := by
  decide +kernel

end B334.E1x.Pts.S707
