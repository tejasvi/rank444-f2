/-! # Jobs 1691 … 1691 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J1691 "../data/j1691.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_1691 (k : Nat) : List Nat :=
  [J1691.L0]
def JW_1691 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_1691 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_1691 k) (JW_1691 k)) 1691 1 = true := by
  decide +kernel

end B334.E1x.Pts.S707
