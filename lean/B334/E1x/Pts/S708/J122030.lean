import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 122030 … 122031 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J122030 "../data/j122030.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_122030 (k : Nat) : List Nat :=
  cond (Nat.blt k 122031) ([J122030.L0]) ([J122030.L1])
def JW_122030 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 122031) ([[]]) ([[]])

end

theorem jr_122030 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_122030 k) (JW_122030 k)) 122030 2 = true := by
  decide +kernel

theorem jm_122030 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_122030 k) (JW_122030 k)) 122030 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_122030 k) (JW_122030 k)) 122030 2 = true := jr_122030
  exact h0

end B334.E1x.Pts.S708
