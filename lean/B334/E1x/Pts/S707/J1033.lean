import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1033 … 1034 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J1033 "../data/j1033.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_1033 (k : Nat) : List Nat :=
  cond (Nat.blt k 1034) ([J1033.L0]) ([J1033.L1])
def JW_1033 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1034) ([[]]) ([[]])

end

theorem jr_1033 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_1033 k) (JW_1033 k)) 1033 2 = true := by
  decide +kernel

end B334.E1x.Pts.S707
