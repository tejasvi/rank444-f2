import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 789 … 793 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J789 "../data/j789.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_789 (k : Nat) : List Nat :=
  cond (Nat.blt k 791) (cond (Nat.blt k 790) ([J789.L0]) ([J789.L1])) (cond (Nat.blt k 792) ([J789.L2]) (cond (Nat.blt k 793) ([J789.L3]) ([J789.L4])))
def JW_789 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 791) (cond (Nat.blt k 790) ([[]]) ([[]])) (cond (Nat.blt k 792) ([[]]) (cond (Nat.blt k 793) ([[]]) ([[]])))

end

theorem jr_789 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_789 k) (JW_789 k)) 789 5 = true := by
  decide +kernel

end B334.E1x.Pts.S707
