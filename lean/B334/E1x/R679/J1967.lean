import B334.E1x.R679.Data
import B334.E1x.R679.HT
import B334.E1x.GJ.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1967 … 1968 of `R679` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.R679.J1967 "../runs/runmulti2/R679_j1967.bin"

namespace B334.E1x.R679

noncomputable section

def JL_1967 (k : Nat) : List Nat :=
  cond (Nat.blt k 1968) ([J1967.L0]) ([J1967.L1])
def JW_1967 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1968) ([[]]) ([[]])

end

theorem jr_1967 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_1967 k) (JW_1967 k)) 1967 1 = true := by
  decide +kernel
theorem jr_1968 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_1967 k) (JW_1967 k)) 1968 1 = true := by
  decide +kernel

end B334.E1x.R679
