import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 10046 … 10049 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J10046 "../data/j10046.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_10046 (k : Nat) : List Nat :=
  cond (Nat.blt k 10048) (cond (Nat.blt k 10047) ([J10046.L0]) ([J10046.L1])) (cond (Nat.blt k 10049) ([J10046.L2]) ([J10046.L3]))
def JW_10046 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 10048) (cond (Nat.blt k 10047) ([[]]) ([[]])) (cond (Nat.blt k 10049) ([[]]) ([[]]))

end

theorem jr_10046 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_10046 k) (JW_10046 k)) 10046 4 = true := by
  decide +kernel

theorem jm_10046 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_10046 k) (JW_10046 k)) 10046 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_10046 k) (JW_10046 k)) 10046 4 = true := jr_10046
  exact h0

end B334.E1x.Pts.S708
