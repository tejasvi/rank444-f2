import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 4508 … 4509 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J4508 "../data/j4508.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_4508 (k : Nat) : List Nat :=
  cond (Nat.blt k 4509) ([J4508.L0]) ([J4508.L1])
def JW_4508 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 4509) ([[]]) ([[]])

end

theorem jr_4508 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_4508 k) (JW_4508 k)) 4508 2 = true := by
  decide +kernel

theorem jm_4508 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_4508 k) (JW_4508 k)) 4508 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_4508 k) (JW_4508 k)) 4508 2 = true := jr_4508
  exact h0

end B334.E1x.Pts.S708
