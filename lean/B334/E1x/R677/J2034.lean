import B334.E1x.R677.Data
import B334.E1x.R677.HT
import B334.E1x.GJ.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2034 … 2036 of `R677` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.R677.J2034 "../runs/runmulti2/R677_j2034.bin"

namespace B334.E1x.R677

noncomputable section

def JL_2034 (k : Nat) : List Nat :=
  cond (Nat.blt k 2035) ([J2034.L0]) (cond (Nat.blt k 2036) ([J2034.L1]) ([J2034.L2, J2034.L3, J2034.L4, J2034.L5, J2034.L6]))
def JW_2034 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2035) ([[]]) (cond (Nat.blt k 2036) ([[]]) ([[1], [2, 3, 4], [], [], []]))

end

theorem jr_2034 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_2034 k) (JW_2034 k)) 2034 2 = true := by
  decide +kernel
theorem jr_2036 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_2034 k) (JW_2034 k)) 2036 1 = true := by
  decide +kernel

end B334.E1x.R677
