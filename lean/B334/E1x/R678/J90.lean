import B334.E1x.R678.Data
import B334.E1x.R678.HT
import B334.E1x.GJ.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 90 … 90 of `R678` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.R678.J90 "../runs/runmulti2/R678_j90.bin"

namespace B334.E1x.R678

noncomputable section

def JL_90 (k : Nat) : List Nat :=
  [J90.L0, J90.L1]
def JW_90 (k : Nat) : List (List Nat) :=
  [[1], []]

end

theorem jr_90 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_90 k) (JW_90 k)) 90 1 = true := by
  decide +kernel

end B334.E1x.R678
