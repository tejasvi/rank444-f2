set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 74090 … 74090 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J74090 "../data/j74090.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_74090 (k : Nat) : List Nat :=
  [J74090.L0]
def JW_74090 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_74090 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_74090 k) (JW_74090 k)) 74090 1 = true := by
  decide +kernel

theorem jm_74090 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_74090 k) (JW_74090 k)) 74090 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_74090 k) (JW_74090 k)) 74090 1 = true := jr_74090
  exact h0

end B334.E1x.Pts.S708
