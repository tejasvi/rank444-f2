import B334.E1x.Load

/-! # Tables of the E1G run `R618` (generated by a script; binary data files)

* `HT.entry k`: the `13 + 7 d`-bit header of job `k`'s first piece (1309 jobs; 24-byte entries).
* `Wf i j`: the glue witness of header record `j` of top-chain block `i` (`OF`: per block the offset of its first
  record in `WT`; a witness `w < 12` is a later top-chain block, `w - 12` a job). -/

#rttablew B334.E1x.R618.HT "../runs/runmulti2/R618_ht.bin" 64 192
#rttablew B334.E1x.R618.OF "../runs/runmulti2/R618_top_of.bin" 64 32
#rttablew B334.E1x.R618.WT "../runs/runmulti2/R618_top_wt.bin" 64 32

namespace B334.E1x.R618

noncomputable section

def nJ : Nat := 1309
def NT : Nat := 12
def Wf (i j : Nat) : Nat := WT.entry (OF.entry i + j)

end

end B334.E1x.R618
