import B334.E1x.R687.Data
import B334.E1x.R687.HT
import B334.E1x.GJ.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1853 … 1854 of `R687` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.R687.J1853 "../runs/runmulti2/R687_j1853.bin"

namespace B334.E1x.R687

noncomputable section

def JL_1853 (k : Nat) : List Nat :=
  cond (Nat.blt k 1854) ([J1853.L0, J1853.L1]) ([J1853.L2])
def JW_1853 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1854) ([[1], []]) ([[]])

end

theorem jr_1853 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_1853 k) (JW_1853 k)) 1853 1 = true := by
  decide +kernel
theorem jr_1854 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_1853 k) (JW_1853 k)) 1854 1 = true := by
  decide +kernel

end B334.E1x.R687
