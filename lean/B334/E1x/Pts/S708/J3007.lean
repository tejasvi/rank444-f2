import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 3007 … 3007 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J3007 "../data/j3007.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_3007 (k : Nat) : List Nat :=
  [J3007.L0]
def JW_3007 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_3007 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_3007 k) (JW_3007 k)) 3007 1 = true := by
  decide +kernel

theorem jm_3007 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_3007 k) (JW_3007 k)) 3007 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_3007 k) (JW_3007 k)) 3007 1 = true := jr_3007
  exact h0

end B334.E1x.Pts.S708
