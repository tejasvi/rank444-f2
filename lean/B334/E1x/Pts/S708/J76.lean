set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 76 … 78 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J76 "../data/j76.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_76 (k : Nat) : List Nat :=
  cond (Nat.blt k 77) ([J76.L0]) (cond (Nat.blt k 78) ([J76.L1]) ([J76.L2]))
def JW_76 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 77) ([[]]) (cond (Nat.blt k 78) ([[]]) ([[]]))

end

theorem jr_76 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_76 k) (JW_76 k)) 76 3 = true := by
  decide +kernel

theorem jm_76 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_76 k) (JW_76 k)) 76 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_76 k) (JW_76 k)) 76 3 = true := jr_76
  exact h0

end B334.E1x.Pts.S708
