/-! # Jobs 124090 … 124092 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J124090 "../data/j124090.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_124090 (k : Nat) : List Nat :=
  cond (Nat.blt k 124091) ([J124090.L0]) (cond (Nat.blt k 124092) ([J124090.L1]) ([J124090.L2]))
def JW_124090 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 124091) ([[]]) (cond (Nat.blt k 124092) ([[]]) ([[]]))

end

theorem jr_124090 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_124090 k) (JW_124090 k)) 124090 3 = true := by
  decide +kernel

theorem jm_124090 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_124090 k) (JW_124090 k)) 124090 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_124090 k) (JW_124090 k)) 124090 3 = true := jr_124090
  exact h0

end B334.E1x.Pts.S708
