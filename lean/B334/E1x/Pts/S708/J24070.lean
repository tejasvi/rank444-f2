set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 24070 … 24071 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J24070 "../data/j24070.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_24070 (k : Nat) : List Nat :=
  cond (Nat.blt k 24071) ([J24070.L0]) ([J24070.L1])
def JW_24070 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 24071) ([[]]) ([[]])

end

theorem jr_24070 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_24070 k) (JW_24070 k)) 24070 2 = true := by
  decide +kernel

theorem jm_24070 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_24070 k) (JW_24070 k)) 24070 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_24070 k) (JW_24070 k)) 24070 2 = true := jr_24070
  exact h0

end B334.E1x.Pts.S708
