#e1lits B334.E1x.Pts.S707.J1693 "../data/j1693.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_1693 (k : Nat) : List Nat :=
  [J1693.L0]
def JW_1693 (k : Nat) : List (List Nat) :=
