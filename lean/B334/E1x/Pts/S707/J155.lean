set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 155 … 155 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J155 "../data/j155.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_155 (k : Nat) : List Nat :=
  [J155.L0]
def JW_155 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_155 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_155 k) (JW_155 k)) 155 1 = true := by
  decide +kernel

end B334.E1x.Pts.S707
