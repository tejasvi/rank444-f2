/-! # Jobs 2964 … 2965 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J2964 "../data/j2964.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_2964 (k : Nat) : List Nat :=
  cond (Nat.blt k 2965) ([J2964.L0]) ([J2964.L1])
def JW_2964 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2965) ([[]]) ([[]])

end

theorem jr_2964 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_2964 k) (JW_2964 k)) 2964 2 = true := by
  decide +kernel

end B334.E1x.Pts.S707
