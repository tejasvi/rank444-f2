import B334.E1x.R291.OK
import B334.E1x.R291.B0
import B334.T2.Index
import B334.BCP.PermL
import B334.E1x.Bridge
import B334.Tab2.Dispatch

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # The run of class 291 (R = 20): `E1Concl Em 20` and its row (generated by a script)

The run is the list `BLK.lits` of 1 pieces (by a script: the trace block split into a mode-0 root and
mode-1 / restart pieces), checked in `B0` … `B0` (`blkChk`) and glued by the witness table `W` (`glueChk`). It is replayed here
against the IP's own slot function `sl` (slots from the row-table entries). With `ipok` and `rows`, `E1GS.e1_sound`
gives `E1Concl Em 20`; `rowValid_of_e1` (padding, `oneOK`, `emOK`) then gives the class's row at `lbOf 291 = 21`.
`run_291 : Tab2.HighHyp 291 → RowValid (Tab2.basisOf 291) (Tab2.lbOf 291)` is the form `Tab2/Dispatch.lean` takes. -/

namespace B334.E1x.R291
open B334.E1x.E1GS

/-- the glue witnesses: record `j` of piece `i` is glued to piece `W[i][j]` -/
def W : List (List Nat) := [[]]

theorem nlits : BLK.lits.length = 1 := by decide
theorem blks : blkChk C sl UB UBR BLK.lits 0 1 = true := by
  have h0 : blkChk C sl UB UBR BLK.lits 0 1 = true := blk_0
  exact h0
theorem glues : glueChk BLK.lits W = true := by decide +kernel
theorem root : BLK.lits.getD 0 0 % 2 ^ 13 = 0 := by decide +kernel

/-- every leaf of the run is covered by its T2 record (identity permutation) -/
theorem leafChk : LI.all (fun q => Nat.blt q.2 T2.leaves_291.length &&
    B334.BCP.t2match (T2.leaves_291.getD q.2 0) (termsOf R VT q.1) R DOM (List.range R)) = true := by
  decide +kernel

theorem hLF : ∀ pl, C.LF pl = true → B334.BCP.NoDecomp (termsOf C.R C.VT pl) C.R C.DOM := by
  intro pl h
  change LI.any (fun q => Nat.beq q.1 pl) = true at h
  obtain ⟨q, hq, hqe⟩ := List.any_eq_true.mp h
  have hc := List.all_eq_true.mp leafChk q hq
  simp only [Bool.and_eq_true, Nat.blt_eq] at hc
  have hm : T2.leaves_291.getD q.2 0 ∈ T2.leaves_291 := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hc.1, Option.getD_some]
    exact List.getElem_mem hc.1
  rw [← Nat.eq_of_beq_eq_true hqe]
  exact B334.BCP.noDecomp_of_t2 (List.range R) hc.2 (T2.ok_291 _ hm)

theorem concl (hhi : Tab2.HighHyp 291) : E1Concl Em 20 :=
  e1_sound C Em LB LBR UB UBR Ntab nrows sl tab GE ipok (rows hhi) hLF
    BLK.lits (by rw [nlits]; decide) root
    (fun i hi => blkChk_spec C sl UB UBR BLK.lits 1 blks i (by rw [nlits] at hi; exact hi))
    (glueChk_spec BLK.lits W glues)

theorem one_ok : oneOK Em 58 = true := by decide +kernel
theorem em_ok : emOK Em (Tab2.basisOf 291) = true := by decide +kernel
theorem lb_eq : Tab2.lbOf 291 = 20 + 1 := by decide

/-- **The run of class 291** -/
theorem run_291 (hhi : Tab2.HighHyp 291) : RowValid (Tab2.basisOf 291) (Tab2.lbOf 291) := by
  rw [lb_eq]
  exact rowValid_of_e1 (ClsChk.basis_lt 291 (by decide)) (concl hhi) one_ok em_ok

/-- the run in the dispatcher's list form -/
theorem runsFor : Tab2.RunsFor [291] := fun c hc hhi => by
  rw [List.mem_singleton] at hc
  subst hc
  exact run_291 hhi

end B334.E1x.R291
