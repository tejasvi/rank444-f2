import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1993 … 1997 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1993 "../data/j1993.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1993 (k : Nat) : List Nat :=
  cond (Nat.blt k 1995) (cond (Nat.blt k 1994) ([J1993.L0]) ([J1993.L1])) (cond (Nat.blt k 1996) ([J1993.L2]) (cond (Nat.blt k 1997) ([J1993.L3]) ([J1993.L4])))
def JW_1993 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1995) (cond (Nat.blt k 1994) ([[]]) ([[]])) (cond (Nat.blt k 1996) ([[]]) (cond (Nat.blt k 1997) ([[]]) ([[]])))

end

theorem jr_1993 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1993 k) (JW_1993 k)) 1993 5 = true := by
  decide +kernel

theorem jm_1993 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1993 k) (JW_1993 k)) 1993 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1993 k) (JW_1993 k)) 1993 5 = true := jr_1993
  exact h0

end B334.E1x.Pts.S708
