theorem em_ok : emOK Em (Tab2.basisOf 669) = true := by decide +kernel
theorem lb_eq : Tab2.lbOf 669 = 23 + 1 := by decide

/-- **The run of class 669** -/
theorem run_669 (hhi : Tab2.HighHyp 669) : RowValid (Tab2.basisOf 669) (Tab2.lbOf 669) := by
  rw [lb_eq]
  exact rowValid_of_e1 (ClsChk.basis_lt 669 (by decide)) (concl hhi) one_ok em_ok

/-- the run in the dispatcher's list form -/
theorem runsFor : Tab2.RunsFor [669] := fun c hc hhi => by
  rw [List.mem_singleton] at hc
  subst hc
  exact run_669 hhi

