import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 25615 … 25616 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J25615 "../data/j25615.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_25615 (k : Nat) : List Nat :=
  cond (Nat.blt k 25616) ([J25615.L0]) ([J25615.L1])
def JW_25615 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 25616) ([[]]) ([[]])

end

theorem jr_25615 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25615 k) (JW_25615 k)) 25615 2 = true := by
  decide +kernel

theorem jm_25615 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25615 k) (JW_25615 k)) 25615 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25615 k) (JW_25615 k)) 25615 2 = true := jr_25615
  exact h0

end B334.E1x.Pts.S708
