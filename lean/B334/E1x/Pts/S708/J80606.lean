import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 80606 … 80607 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J80606 "../data/j80606.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_80606 (k : Nat) : List Nat :=
  cond (Nat.blt k 80607) ([J80606.L0]) ([J80606.L1])
def JW_80606 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 80607) ([[]]) ([[]])

end

theorem jr_80606 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_80606 k) (JW_80606 k)) 80606 2 = true := by
  decide +kernel

theorem jm_80606 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_80606 k) (JW_80606 k)) 80606 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_80606 k) (JW_80606 k)) 80606 2 = true := jr_80606
  exact h0

end B334.E1x.Pts.S708
