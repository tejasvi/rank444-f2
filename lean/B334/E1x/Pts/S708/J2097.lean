import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2097 … 2100 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J2097 "../data/j2097.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_2097 (k : Nat) : List Nat :=
  cond (Nat.blt k 2099) (cond (Nat.blt k 2098) ([J2097.L0]) ([J2097.L1])) (cond (Nat.blt k 2100) ([J2097.L2]) ([J2097.L3]))
def JW_2097 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2099) (cond (Nat.blt k 2098) ([[]]) ([[]])) (cond (Nat.blt k 2100) ([[]]) ([[]]))

end

theorem jr_2097 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2097 k) (JW_2097 k)) 2097 4 = true := by
  decide +kernel

theorem jm_2097 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2097 k) (JW_2097 k)) 2097 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2097 k) (JW_2097 k)) 2097 4 = true := jr_2097
  exact h0

end B334.E1x.Pts.S708
