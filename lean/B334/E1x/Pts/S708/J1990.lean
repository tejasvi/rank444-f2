import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1990 … 1991 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1990 "../data/j1990.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1990 (k : Nat) : List Nat :=
  cond (Nat.blt k 1991) ([J1990.L0]) ([J1990.L1])
def JW_1990 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1991) ([[]]) ([[]])

end

theorem jr_1990 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1990 k) (JW_1990 k)) 1990 2 = true := by
  decide +kernel

theorem jm_1990 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1990 k) (JW_1990 k)) 1990 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1990 k) (JW_1990 k)) 1990 2 = true := jr_1990
  exact h0

end B334.E1x.Pts.S708
