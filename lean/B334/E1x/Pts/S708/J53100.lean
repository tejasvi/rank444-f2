#e1lits B334.E1x.Pts.S708.J53100 "../data/j53100.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_53100 (k : Nat) : List Nat :=
  cond (Nat.blt k 53101) ([J53100.L0]) (cond (Nat.blt k 53102) ([J53100.L1]) ([J53100.L2]))
def JW_53100 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 53101) ([[]]) (cond (Nat.blt k 53102) ([[]]) ([[]]))

end

theorem jr_53100 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_53100 k) (JW_53100 k)) 53100 3 = true := by
  decide +kernel

theorem jm_53100 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_53100 k) (JW_53100 k)) 53100 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_53100 k) (JW_53100 k)) 53100 3 = true := jr_53100
