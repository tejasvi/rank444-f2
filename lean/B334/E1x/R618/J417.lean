#e1lits B334.E1x.R618.J417 "../runs/runmulti2/R618_j417.bin"

namespace B334.E1x.R618

noncomputable section

def JL_417 (k : Nat) : List Nat :=
  cond (Nat.blt k 418) ([J417.L0]) ([J417.L1, J417.L2, J417.L3])
def JW_417 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 418) ([[]]) ([[1, 2], [], []])

end

theorem jr_417 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_417 k) (JW_417 k)) 417 1 = true := by
  decide +kernel
theorem jr_418 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_417 k) (JW_417 k)) 418 1 = true := by
  decide +kernel

end B334.E1x.R618
