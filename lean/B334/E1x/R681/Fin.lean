theorem run_681 (hhi : Tab2.HighHyp 681) : RowValid (Tab2.basisOf 681) (Tab2.lbOf 681) := by
  rw [lb_eq]
  exact rowValid_of_e1 (ClsChk.basis_lt 681 (by decide)) (concl hhi) one_ok em_ok

