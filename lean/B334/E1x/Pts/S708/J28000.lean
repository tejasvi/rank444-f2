import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 28000 … 28000 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J28000 "../data/j28000.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_28000 (k : Nat) : List Nat :=
  [J28000.L0]
def JW_28000 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_28000 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_28000 k) (JW_28000 k)) 28000 1 = true := by
  decide +kernel

theorem jm_28000 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_28000 k) (JW_28000 k)) 28000 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_28000 k) (JW_28000 k)) 28000 1 = true := jr_28000
  exact h0

end B334.E1x.Pts.S708
