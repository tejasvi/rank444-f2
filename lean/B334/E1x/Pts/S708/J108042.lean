import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 108042 … 108043 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J108042 "../data/j108042.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_108042 (k : Nat) : List Nat :=
  cond (Nat.blt k 108043) ([J108042.L0]) ([J108042.L1])
def JW_108042 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 108043) ([[]]) ([[]])

end

theorem jr_108042 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_108042 k) (JW_108042 k)) 108042 2 = true := by
  decide +kernel

theorem jm_108042 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_108042 k) (JW_108042 k)) 108042 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_108042 k) (JW_108042 k)) 108042 2 = true := jr_108042
  exact h0

end B334.E1x.Pts.S708
