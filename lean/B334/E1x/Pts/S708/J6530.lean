set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 6530 … 6531 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J6530 "../data/j6530.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_6530 (k : Nat) : List Nat :=
  cond (Nat.blt k 6531) ([J6530.L0]) ([J6530.L1])
def JW_6530 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 6531) ([[]]) ([[]])

end

theorem jr_6530 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_6530 k) (JW_6530 k)) 6530 2 = true := by
  decide +kernel

theorem jm_6530 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_6530 k) (JW_6530 k)) 6530 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_6530 k) (JW_6530 k)) 6530 2 = true := jr_6530
  exact h0

end B334.E1x.Pts.S708
