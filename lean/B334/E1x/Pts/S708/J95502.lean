import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 95502 … 95503 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J95502 "../data/j95502.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_95502 (k : Nat) : List Nat :=
  cond (Nat.blt k 95503) ([J95502.L0]) ([J95502.L1])
def JW_95502 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 95503) ([[]]) ([[]])

end

theorem jr_95502 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_95502 k) (JW_95502 k)) 95502 2 = true := by
  decide +kernel

theorem jm_95502 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_95502 k) (JW_95502 k)) 95502 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_95502 k) (JW_95502 k)) 95502 2 = true := jr_95502
  exact h0

end B334.E1x.Pts.S708
