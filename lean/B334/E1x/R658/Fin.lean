theorem run_658 (hhi : Tab2.HighHyp 658) : RowValid (Tab2.basisOf 658) (Tab2.lbOf 658) := by
  rw [lb_eq]
  exact rowValid_of_e1 (ClsChk.basis_lt 658 (by decide)) (concl hhi) one_ok em_ok

