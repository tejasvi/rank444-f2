import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 5005 … 5008 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J5005 "../data/j5005.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_5005 (k : Nat) : List Nat :=
  cond (Nat.blt k 5007) (cond (Nat.blt k 5006) ([J5005.L0]) ([J5005.L1])) (cond (Nat.blt k 5008) ([J5005.L2]) ([J5005.L3]))
def JW_5005 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 5007) (cond (Nat.blt k 5006) ([[]]) ([[]])) (cond (Nat.blt k 5008) ([[]]) ([[]]))

end

theorem jr_5005 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_5005 k) (JW_5005 k)) 5005 4 = true := by
  decide +kernel

theorem jm_5005 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_5005 k) (JW_5005 k)) 5005 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_5005 k) (JW_5005 k)) 5005 4 = true := jr_5005
  exact h0

end B334.E1x.Pts.S708
