import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1616 … 1616 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J1616 "../data/j1616.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_1616 (k : Nat) : List Nat :=
  [J1616.L0]
def JW_1616 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_1616 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_1616 k) (JW_1616 k)) 1616 1 = true := by
  decide +kernel

end B334.E1x.Pts.S707
