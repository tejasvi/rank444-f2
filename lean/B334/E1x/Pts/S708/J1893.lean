import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1893 … 1897 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J1893 "../data/j1893.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_1893 (k : Nat) : List Nat :=
  cond (Nat.blt k 1895) (cond (Nat.blt k 1894) ([J1893.L0]) ([J1893.L1])) (cond (Nat.blt k 1896) ([J1893.L2]) (cond (Nat.blt k 1897) ([J1893.L3]) ([J1893.L4])))
def JW_1893 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1895) (cond (Nat.blt k 1894) ([[]]) ([[]])) (cond (Nat.blt k 1896) ([[]]) (cond (Nat.blt k 1897) ([[]]) ([[]])))

end

theorem jr_1893 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1893 k) (JW_1893 k)) 1893 5 = true := by
  decide +kernel

theorem jm_1893 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1893 k) (JW_1893 k)) 1893 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_1893 k) (JW_1893 k)) 1893 5 = true := jr_1893
  exact h0

end B334.E1x.Pts.S708
