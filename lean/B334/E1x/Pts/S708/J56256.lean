import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 56256 … 56258 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J56256 "../data/j56256.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_56256 (k : Nat) : List Nat :=
  cond (Nat.blt k 56257) ([J56256.L0]) (cond (Nat.blt k 56258) ([J56256.L1]) ([J56256.L2]))
def JW_56256 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 56257) ([[]]) (cond (Nat.blt k 56258) ([[]]) ([[]]))

end

theorem jr_56256 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_56256 k) (JW_56256 k)) 56256 3 = true := by
  decide +kernel

theorem jm_56256 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_56256 k) (JW_56256 k)) 56256 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_56256 k) (JW_56256 k)) 56256 3 = true := jr_56256
  exact h0

end B334.E1x.Pts.S708
