theorem leafAll : IPChk.allR (fun k => leafB (LI.getD k (0, 0))) 0 90 = true := by
  have h0 : IPChk.allR (fun k => leafB (LI.getD k (0, 0))) 0 90 = true := lf_0
  exact h0

theorem hLF : ∀ pl, C.LF pl = true → B334.BCP.NoDecomp (termsOf C.R C.VT pl) C.R C.DOM := by
  intro pl h
  change LI.any (fun q => Nat.beq q.1 pl) = true at h
  obtain ⟨q, hq, hqe⟩ := List.any_eq_true.mp h
  obtain ⟨k, hk, hkq⟩ := List.mem_iff_getElem.mp hq
  have hlen : LI.length = 90 := by decide
  have hc : leafB (LI.getD k (0, 0)) = true := IPChk.allR_spec0 leafAll k (by rw [← hlen]; exact hk)
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hk, Option.getD_some, hkq] at hc
  unfold leafB at hc
  simp only [Bool.and_eq_true, Nat.blt_eq] at hc
  have hm : T2.leaves_686.getD q.2 0 ∈ T2.leaves_686 := by
    rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hc.1, Option.getD_some]
    exact List.getElem_mem hc.1
  rw [← Nat.eq_of_beq_eq_true hqe]
  exact B334.BCP.noDecomp_of_t2 (List.range R) hc.2 (T2.ok_686 _ hm)

theorem concl (hhi : Tab2.HighHyp 686) : E1Concl Em 23 :=
  GJ.e1_sound_enum C Em LB LBR UB UBR Ntab nrows sl tab GE ipok (rows hhi) hLF enum

theorem one_ok : oneOK Em 1 = true := by decide +kernel
theorem em_ok : emOK Em (Tab2.basisOf 686) = true := by decide +kernel
theorem lb_eq : Tab2.lbOf 686 = 23 + 1 := by decide

/-- **The run of class 686** -/
theorem run_686 (hhi : Tab2.HighHyp 686) : RowValid (Tab2.basisOf 686) (Tab2.lbOf 686) := by
  rw [lb_eq]
  exact rowValid_of_e1 (ClsChk.basis_lt 686 (by decide)) (concl hhi) one_ok em_ok

/-- the run in the dispatcher's list form -/
theorem runsFor : Tab2.RunsFor [686] := fun c hc hhi => by
  rw [List.mem_singleton] at hc
  subst hc
  exact run_686 hhi

