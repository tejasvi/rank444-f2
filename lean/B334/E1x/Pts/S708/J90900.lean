set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 90900 … 90900 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J90900 "../data/j90900.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_90900 (k : Nat) : List Nat :=
  [J90900.L0]
def JW_90900 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_90900 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_90900 k) (JW_90900 k)) 90900 1 = true := by
  decide +kernel

theorem jm_90900 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_90900 k) (JW_90900 k)) 90900 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_90900 k) (JW_90900 k)) 90900 1 = true := jr_90900
  exact h0

end B334.E1x.Pts.S708
