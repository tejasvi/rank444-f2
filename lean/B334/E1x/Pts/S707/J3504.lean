set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 3504 … 3508 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J3504 "../data/j3504.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_3504 (k : Nat) : List Nat :=
  cond (Nat.blt k 3506) (cond (Nat.blt k 3505) ([J3504.L0]) ([J3504.L1])) (cond (Nat.blt k 3507) ([J3504.L2]) (cond (Nat.blt k 3508) ([J3504.L3]) ([J3504.L4])))
def JW_3504 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 3506) (cond (Nat.blt k 3505) ([[]]) ([[]])) (cond (Nat.blt k 3507) ([[]]) (cond (Nat.blt k 3508) ([[]]) ([[]])))

end

theorem jr_3504 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_3504 k) (JW_3504 k)) 3504 5 = true := by
  decide +kernel

end B334.E1x.Pts.S707
