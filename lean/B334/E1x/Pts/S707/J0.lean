import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 0 … 7 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J0 "../data/j0.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_0 (k : Nat) : List Nat :=
  cond (Nat.blt k 4) (cond (Nat.blt k 2) (cond (Nat.blt k 1) ([J0.L0]) ([J0.L1, J0.L2, J0.L3])) (cond (Nat.blt k 3) ([J0.L4]) ([J0.L5]))) (cond (Nat.blt k 6) (cond (Nat.blt k 5) ([J0.L6]) ([J0.L7])) (cond (Nat.blt k 7) ([J0.L8]) ([J0.L9])))
def JW_0 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 4) (cond (Nat.blt k 2) (cond (Nat.blt k 1) ([[]]) ([[1, 2], [], []])) (cond (Nat.blt k 3) ([[]]) ([[]]))) (cond (Nat.blt k 6) (cond (Nat.blt k 5) ([[]]) ([[]])) (cond (Nat.blt k 7) ([[]]) ([[]])))

end

theorem jr_0 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_0 k) (JW_0 k)) 0 8 = true := by
  decide +kernel

end B334.E1x.Pts.S707
