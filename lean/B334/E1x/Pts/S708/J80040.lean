import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 80040 … 80041 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J80040 "../data/j80040.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_80040 (k : Nat) : List Nat :=
  cond (Nat.blt k 80041) ([J80040.L0]) ([J80040.L1])
def JW_80040 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 80041) ([[]]) ([[]])

end

theorem jr_80040 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_80040 k) (JW_80040 k)) 80040 2 = true := by
  decide +kernel

theorem jm_80040 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_80040 k) (JW_80040 k)) 80040 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_80040 k) (JW_80040 k)) 80040 2 = true := jr_80040
  exact h0

end B334.E1x.Pts.S708
