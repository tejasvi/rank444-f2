#e1lits B334.E1x.Pts.S707.J5451 "../data/j5451.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_5451 (k : Nat) : List Nat :=
  [J5451.L0]
def JW_5451 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_5451 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_5451 k) (JW_5451 k)) 5451 1 = true := by
  decide +kernel

end B334.E1x.Pts.S707
