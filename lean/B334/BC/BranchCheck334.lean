import B334.BC.Tables334

/-! # BranchCheck334: the checker of completion-refutation certificates for ⟨3,3,4⟩ (stream format v5c-334)

The code is a port of the ⟨3,3,3⟩ checker v5 (`rank333-f2`,
`lean/BranchCheck5.lean`, Apache-2.0) plus v7's CORB filter at `sym` nodes (`BranchCheck7.lean`, `candB7`), with:
* 12-bit second and third factors: packed matrices have 12 slots of 24 bits (data in the low 12 bits, the identity half
  above), and masks over B or C are 4096-bit; first factors and functionals stay 9-bit;
* no Lemma G and no rank-1 fast path; v5's unused record tables (XL, XH, GL, GH) are dropped;
* `nperp` and `perp` by two-part tables (64 + 64 entries, specified by the doubling recursion `nperpD`), and the lowest
  set bit by `Nat.log2` (evaluated by the kernel on literals);
* the hard `sym` rule: a `sym` node needs Asg = ∅ and cdir = false;
* leaf records with dom mode exactly 01 (a 512-bit dom mask follows), and no nonzero stream bits after the certificate.
The code is computable (structural recursion, no recursor applications), so the same definitions serve kernel
`decide` and native tests. Tables: `B334.BCT` (`Tables334.lean`, generated by a script). -/

namespace B334.BC
open B334.BCT

/-- bit `i` of `n` -/
@[inline] def bit (n i : Nat) : Bool := Nat.beq (Nat.land (Nat.shiftRight n i) 1) 1
/-- parity of a 9-bit `v` -/
@[inline] def par (v : Nat) : Bool := bit PAR v
/-- `T(X)` packed by columns (slot `z` = column `z`) -/
@[inline] def txc24 (X : Nat) : Nat := Nat.land (Nat.shiftRight TXC24 (Nat.mul 288 X)) M288
/-- `T(X)` packed by rows (slot `y` = row `y`) -/
@[inline] def txr24 (X : Nat) : Nat := Nat.land (Nat.shiftRight TXR24 (Nat.mul 288 X)) M288
/-- `∑_{z ∈ c} 2^(24z)` (the 12 copies of `c` at offsets `23i` do not overlap) -/
@[inline] def spr24 (c : Nat) : Nat := Nat.land (Nat.mul c C23) REP24

/-- the doubling loop of `nperp`: from the mask `N` of `{w < 2^k : parity(v &&& w) = 1}`, the mask for `w < 2^(k+1)`
is `N ||| ((N ^^^ [bit k of v] · (2^(2^k) - 1)) <<< 2^k)` -/
def nperpAux (v : Nat) : Nat → Nat → Nat → Nat
  | 0, _, N => N
  | fuel + 1, k, N =>
    nperpAux v fuel (Nat.succ k)
      (Nat.lor N (Nat.shiftLeft (Nat.xor N (Nat.mul (Nat.land (Nat.shiftRight v k) 1)
        (Nat.pred (Nat.shiftLeft 1 (Nat.shiftLeft 1 k))))) (Nat.shiftLeft 1 k)))
/-- `{w < 4096 : parity(v &&& w) = 1}` by the doubling recursion: the specification of the tables -/
def nperpD (v : Nat) : Nat := nperpAux v 12 0 0
/-- `{w < 4096 : parity(v &&& w) = 0}` by the doubling recursion -/
def perpD (v : Nat) : Nat := Nat.xor M4096 (nperpD v)
/-- `{w < 4096 : parity(v &&& w) = 1}` as a 4096-bit mask (`v < 4096`), from the tables (`nperp_eq` in
`B334/BCP/PerpTab.lean`: equal to `nperpD`): two table entries and one XOR, so the kernel builds one new mask per call -/
@[inline] def nperp (v : Nat) : Nat := Nat.xor (npl (Nat.land v 63)) (nph (Nat.shiftRight v 6))
/-- `{w < 4096 : parity(v &&& w) = 0}` (`v < 4096`), from the tables (`perp_eq`: equal to `perpD`) -/
@[inline] def perp (v : Nat) : Nat := Nat.xor (pl (Nat.land v 63)) (nph (Nat.shiftRight v 6))

/-- `∑_{i ∈ x} 2^(32i)` for a 9-bit `x` -/
@[inline] def dep32 (x : Nat) : Nat := Nat.land (Nat.mul x C31) M32B
@[inline] def pop11 (x : Nat) : Nat := Nat.land (Nat.shiftRight POP11 (Nat.mul 4 x)) 15
/-- the set of terms `s` with `parity(a_s &&& X) = 1`, as a 32-bit mask (word `i` of `SS` = the terms with bit `i`) -/
@[inline] def hx (SS X : Nat) : Nat :=
  let y0 := Nat.land SS (Nat.mul (dep32 X) M32)
  let y1 := Nat.xor y0 (Nat.shiftRight y0 128)
  let y2 := Nat.xor y1 (Nat.shiftRight y1 64)
  let y3 := Nat.xor y2 (Nat.shiftRight y2 32)
  Nat.land (Nat.xor y3 (Nat.shiftRight y3 256)) M32
@[inline] def pop32 (x : Nat) : Nat :=
  Nat.add (pop11 (Nat.land x 2047)) (Nat.add (pop11 (Nat.land (Nat.shiftRight x 11) 2047)) (pop11 (Nat.shiftRight x 22)))
/-- `u(X)`: the number of active terms hit by `X` -/
@[inline] def ucnt (SS ACT X : Nat) : Nat := pop32 (Nat.land (hx SS X) ACT)

def mkSSAux : List Nat → Nat → Nat
  | [], _ => 0
  | a :: as, s => Nat.lor (Nat.shiftLeft (dep32 a) s) (mkSSAux as (Nat.succ s))
/-- the packed hit table of a list of first factors -/
def mkSS (terms : List Nat) : Nat := mkSSAux terms 0
/-- the first factors packed 9 bits each -/
def packT : List Nat → Nat
  | [] => 0
  | a :: as => Nat.lor a (Nat.shiftLeft (packT as) 9)

/-- assigned terms `(a, b, c)` -/
abbrev Asg := List (Nat × Nat × Nat)

/-- `R(X)` packed by columns, with the identity half: `T(X)` plus `b cᵀ` for every assigned term hit by `X` -/
def resC (X : Nat) : Asg → Nat
  | [] => Nat.xor (txc24 X) ID24
  | e :: asg => cond (par (Nat.land e.1 X)) (Nat.xor (Nat.mul (spr24 e.2.2) e.2.1) (resC X asg)) (resC X asg)
/-- `R(X)` packed by rows, with the identity half -/
def resR (X : Nat) : Asg → Nat
  | [] => Nat.xor (txr24 X) ID24
  | e :: asg => cond (par (Nat.land e.1 X)) (Nat.xor (Nat.mul (spr24 e.2.1) e.2.2) (resR X asg)) (resR X asg)
/-- no assigned term is hit by `X` (then `R(X) = T(X)`) -/
def noasg (X : Nat) : Asg → Bool
  | [] => true
  | e :: asg => !(par (Nat.land e.1 X)) && noasg X asg

/-- elimination state: pivot rows `P` (slot `h` = the row with pivot `h`), pivot mask `PM`, rank, the diagonal bits
`DG` (bit `25h`), the slot markers `D24` (bit `24h`), and the rest `M` -/
structure ES where
  P : Nat
  PM : Nat
  rk : Nat
  DG : Nat
  D24 : Nat
  M : Nat

/-- one elimination step at data bit `h`: the first slot of `M` with bit `h` becomes the pivot row of slot `h` of `P`;
it is added to every other slot of `M` and `P` with bit `h` -/
@[inline] def stepE (h : Nat) (s : ES) : ES :=
  let cand := Nat.land (Nat.shiftRight s.M h) REP24
  cond (Nat.beq cand 0) s
    (let p := Nat.land (Nat.div s.M (Nat.xor cand (Nat.land cand (Nat.pred cand)))) M24
     { P := Nat.lor (Nat.xor s.P (Nat.mul (Nat.land (Nat.shiftRight s.P h) REP24) p)) (Nat.shiftLeft p (Nat.mul 24 h)),
       PM := Nat.lor s.PM (Nat.shiftLeft 1 h), rk := Nat.succ s.rk,
       DG := Nat.lor s.DG (Nat.shiftLeft 1 (Nat.mul 25 h)), D24 := Nat.lor s.D24 (Nat.shiftLeft 1 (Nat.mul 24 h)),
       M := Nat.xor s.M (Nat.mul cand p) })
def elimAux : Nat → ES → ES
  | 0, s => s
  | k + 1, s => elimAux k (stepE k s)
/-- steps at bits 11, 10, …, 0 -/
def elim (M : Nat) : ES := elimAux 12 ⟨0, 0, 0, 0, 0, M⟩

/-- the structure the soundness proof needs: no data left in `M`, `P` in reduced echelon form -/
@[inline] def elimOk (s : ES) : Bool :=
  Nat.beq (Nat.land s.M LEFT12) 0 && Nat.beq (Nat.land s.P HM12) 0 &&
  Nat.beq (Nat.land s.P (Nat.mul s.PM REP24)) s.DG && Nat.beq (Nat.land s.P (Nat.mul s.D24 M24)) s.P

/-- bit `j` of every slot, as a 12-bit vector -/
@[inline] def gather (P j : Nat) : Nat :=
  Nat.land (Nat.shiftRight (Nat.mul (Nat.land (Nat.shiftRight P j) REP24) MAGIC24) 253) 4095
def lmCAux (P PM : Nat) : Nat → Nat → Nat
  | 0, acc => acc
  | j + 1, acc => lmCAux P PM j (cond (bit PM j) acc (Nat.land acc (perp (Nat.lor (gather P j) (Nat.shiftLeft 1 j)))))
/-- the column space of the eliminated matrix, as a 4096-bit mask -/
def lmC (P PM : Nat) : Nat := lmCAux P PM 12 M4096
def kerMAux (M : Nat) : Nat → Nat → Nat
  | 0, acc => acc
  | z + 1, acc => kerMAux M z
      (cond (Nat.beq (Nat.land (Nat.shiftRight M (Nat.mul 24 z)) M24) 0) acc
        (Nat.land acc (perp (Nat.shiftRight (Nat.land (Nat.shiftRight M (Nat.mul 24 z)) M24) 12))))
/-- the orthogonal complement of the kernel (from the identity halves of the zero rows of `M`), as a mask -/
def kerM (M : Nat) : Nat := kerMAux M 12 M4096

/-- `x(b)`: the XOR of the identity halves of the pivot rows `h` with `b_h = 1` -/
@[inline] def xof (P b : Nat) : Nat :=
  let y0 := Nat.land P (Nat.mul (spr24 b) RH12)
  let y1 := Nat.xor y0 (Nat.shiftRight y0 192)
  let y2 := Nat.xor y1 (Nat.shiftRight y1 96)
  let y3 := Nat.xor y2 (Nat.shiftRight y2 48)
  Nat.land (Nat.shiftRight (Nat.xor y3 (Nat.shiftRight y3 24)) 12) 4095
/-- `g(c)`: bit `h` is the parity of `c` against the identity half of pivot row `h` (the adjoint of `x`) -/
@[inline] def gof (P c : Nat) : Nat :=
  let q := Nat.land P (Nat.mul c REPR24)
  let q1 := Nat.xor q (Nat.shiftRight q 1)
  let q2 := Nat.xor q1 (Nat.shiftRight q1 2)
  let q3 := Nat.xor q2 (Nat.shiftRight q2 4)
  gather (Nat.xor q3 (Nat.shiftRight q2 8)) 12

/-- root records (`R(X) = T(X)`): pivot rows, pivot mask, rank, column and row space -/
@[inline] def rptP (X : Nat) : Nat := Nat.land (Nat.shiftRight RPT (Nat.mul 304 X)) M288
@[inline] def rptPM (X : Nat) : Nat := Nat.land (Nat.shiftRight RPT (Nat.add (Nat.mul 304 X) 288)) 4095
@[inline] def rkt (X : Nat) : Nat := Nat.land (Nat.shiftRight RKT (Nat.mul 4 X)) 15
@[inline] def rlm (X : Nat) : Nat :=
  Nat.land (Nat.shiftRight LMV (Nat.mul 4096 (Nat.land (Nat.shiftRight LIDX (Nat.mul 4 X)) 15))) M4096
@[inline] def rrm (X : Nat) : Nat :=
  Nat.land (Nat.shiftRight RMV (Nat.mul 4096 (Nat.land (Nat.shiftRight RIDX (Nat.mul 4 X)) 15))) M4096

/-- a tight record: functional, pivot rows, pivot mask, and the masks `lm` (column space) and `rm` (row space) -/
structure Rec where
  X : Nat
  P : Nat
  PM : Nat
  lm : Nat
  rm : Nat

/-- an NT claim: validity (`u(X) ≤ rank R(X)`, elimination accepted) and the record -/
@[inline] def mkRec (SS ACT : Nat) (asg : Asg) (X : Nat) : Bool × Rec :=
  cond (noasg X asg)
    (Nat.ble (ucnt SS ACT X) (rkt X), ⟨X, rptP X, rptPM X, rlm X, rrm X⟩)
    (let s := elim (resC X asg)
     (elimOk s && Nat.ble (ucnt SS ACT X) s.rk, ⟨X, s.P, s.PM, lmC s.P s.PM, kerM s.M⟩))
/-- an SL claim: validity (`u(X) ≤ rank R(X) + 1`) and `(col R(X), row R(X))` -/
@[inline] def mkSl (SS ACT : Nat) (asg : Asg) (X : Nat) : Bool × Nat × Nat :=
  cond (noasg X asg)
    (Nat.ble (ucnt SS ACT X) (Nat.succ (rkt X)), rlm X, rrm X)
    (let s := elim (resC X asg)
     let s2 := elim (resR X asg)
     (elimOk s && elimOk s2 && Nat.ble (ucnt SS ACT X) (Nat.succ s.rk), kerM s2.M, kerM s.M))

/-- rule (I): after `t ↦ (b, c)` (first factor `a`), the records through `a` get `lm ∧ perp(g(c))`, `rm ∧ perp(x(b))` -/
def updRecs (a b c : Nat) : List Rec → List Rec
  | [] => []
  | r :: l => cond (par (Nat.land r.X a))
      (⟨r.X, r.P, r.PM, Nat.land r.lm (perp (gof r.P c)), Nat.land r.rm (perp (xof r.P b))⟩ :: updRecs a b c l)
      (r :: updRecs a b c l)
/-- the records of `l` through `a`, prepended to `tail` -/
def thru (a : Nat) : List Rec → List Rec → List Rec
  | [], tail => tail
  | r :: l, tail => cond (par (Nat.land r.X a)) (r :: thru a l tail) (thru a l tail)
def app : List Rec → List Rec → List Rec
  | [], tail => tail
  | r :: l, tail => r :: app l tail
def andLm : List Rec → Nat → Nat
  | [], m => m
  | r :: l, m => andLm l (Nat.land m r.lm)
def andRm : List Rec → Nat → Nat
  | [], m => m
  | r :: l, m => andRm l (Nat.land m r.rm)
/-- `m ∩ {c : ⟨c, x_r(b)⟩ = 1 for every r}` -/
def cmT (b : Nat) : List Rec → Nat → Nat
  | [], m => m
  | r :: l, m => cmT b l (Nat.land m (nperp (xof r.P b)))
/-- `m ∩ {b : ⟨g_r(c), b⟩ = 1 for every r}` -/
def bmT (c : Nat) : List Rec → Nat → Nat
  | [], m => m
  | r :: l, m => bmT c l (Nat.land m (nperp (gof r.P c)))
/-- slack records `(ok, col, row)`: `b ∉ col ⇒ c ∈ row` -/
def cmS (b : Nat) : List (Bool × Nat × Nat) → Nat → Nat
  | [], m => m
  | s :: l, m => cmS b l (cond (bit s.2.1 b) m (Nat.land m s.2.2))
/-- `c ∉ row ⇒ b ∈ col` -/
def bmS (c : Nat) : List (Bool × Nat × Nat) → Nat → Nat
  | [], m => m
  | s :: l, m => bmS c l (cond (bit s.2.2 c) m (Nat.land m s.2.1))

/-- the index of the lowest set bit of `m ≠ 0` -/
@[inline] def lowIdx (m : Nat) : Nat := Nat.log2 (Nat.xor m (Nat.land m (Nat.pred m)))
/-- the pairs `(f, x)` (`bfirst`) or `(x, f)` for the set bits `x` of `m`, ascending, prepended to `tail` -/
def pairs (bfirst : Bool) (f : Nat) : Nat → Nat → List (Nat × Nat) → List (Nat × Nat)
  | 0, _, tail => tail
  | fuel + 1, m, tail => cond (Nat.beq m 0) tail
      (cond bfirst (f, lowIdx m) (lowIdx m, f) :: pairs bfirst f fuel (Nat.land m (Nat.pred m)) tail)
def bitsOfAux : Nat → Nat → List Nat
  | 0, _ => []
  | fuel + 1, m => cond (Nat.beq m 0) [] (lowIdx m :: bitsOfAux fuel (Nat.land m (Nat.pred m)))
/-- the set bits of a 4096-bit mask, ascending -/
def bitsOf (m : Nat) : List Nat := bitsOfAux 4096 m

/-- candidates with `cdir = false`: for `b` ascending, `c` ascending in the filtered mask (at a `sym` node the c-mask
starts from `cb ∧ CORB[b]`) -/
def candsB (sym : Bool) (part : List Rec) (ss : List (Bool × Nat × Nat)) (cb : Nat) : List Nat → List (Nat × Nat)
  | [] => []
  | b :: bs => pairs true b 4096 (cmS b ss (cmT b part (cond sym (Nat.land cb (corbM b)) cb))) (candsB sym part ss cb bs)
/-- candidates with `cdir = true`: for `c` ascending, `b` ascending -/
def candsC (part : List Rec) (ss : List (Bool × Nat × Nat)) (bm : Nat) : List Nat → List (Nat × Nat)
  | [] => []
  | c :: cs => pairs false c 4096 (bmS c ss (bmT c part bm)) (candsC part ss bm cs)

def allDom (dom : Nat) : List Nat → Bool
  | [] => true
  | X :: l => bit dom X && allDom dom l
def allThru (a : Nat) : List Nat → Bool
  | [] => true
  | X :: l => par (Nat.land a X) && allThru a l

/-- new records: validity of all, and the records prepended to `tail` -/
def mkRecs (SS ACT : Nat) (asg : Asg) : List Nat → List Rec → Bool × List Rec
  | [], tail => (true, tail)
  | X :: l, tail =>
    let r := mkRec SS ACT asg X
    let ih := mkRecs SS ACT asg l tail
    (r.1 && ih.1, r.2 :: ih.2)
def mkSls (SS ACT : Nat) (asg : Asg) : List Nat → Bool × List (Bool × Nat × Nat)
  | [] => (true, [])
  | X :: l =>
    let s := mkSl SS ACT asg X
    let ih := mkSls SS ACT asg l
    (s.1 && ih.1, s :: ih.2)

/-- the abstract certificate -/
inductive Cert where
  | over (X : Nat)
  | br (t : Nat) (nt sl : List Nat) (sym cdir : Bool) (kids : List Cert)

/-- one subtree per candidate, in candidate order, each checked by `f` in the child state -/
def kidsOk (f : Asg → List Rec → Cert → Bool) (a : Nat) (asg : Asg) (allr : List Rec) :
    List (Nat × Nat) → List Cert → Bool
  | [], ks => ks.isEmpty
  | _ :: _, [] => false
  | p :: cs, k :: ks => f ((a, p.1, p.2) :: asg) (updRecs a p.1 p.2 allr) k && kidsOk f a asg allr cs ks

/-- the node conditions at a `br` node (everything except the subtrees) and the candidate list -/
@[inline] def brData (SS ACT : Nat) (asg : Asg) (recs : List Rec) (dom a : Nat) (nt sl : List Nat) (sym cdir : Bool) (t : Nat) :
    Bool × List Rec × List (Nat × Nat) :=
  let nr := mkRecs SS ACT asg nt []
  let part := thru a recs (thru a nr.2 [])
  let ss := mkSls SS ACT asg sl
  let B := andLm part (Nat.land ALLNZ (cond sym ORBM M4096))
  let Cb := andRm part ALLNZ
  let cs : List (Nat × Nat) := cond cdir
    (cond (Nat.beq Cb 0) [] (cond (Nat.beq B 0) [] (candsC part ss.2 B (bitsOf Cb))))
    (cond (Nat.beq B 0) [] (candsB sym part ss.2 Cb (bitsOf B)))
  (bit ACT t && (!sym || (asg.isEmpty && !cdir)) && allDom dom nt && nr.1 && allDom dom sl && allThru a sl && ss.1,
   app recs nr.2, cs)

/-- the checker on `Cert` terms at fuel `n` (state: packed first factors, hit table, active mask, assignment, records,
domain) -/
def check : Nat → Nat → Nat → Nat → Asg → List Rec → Nat → Cert → Bool
  | 0, _, _, _, _, _, _, _ => false
  | _ + 1, _, SS, ACT, asg, _, dom, .over X =>
    let s := elim (resC X asg)
    bit dom X && elimOk s && Nat.blt (ucnt SS ACT X) s.rk
  | fuel + 1, TERMS, SS, ACT, asg, recs, dom, .br t nt sl sym cdir kids =>
    let a := Nat.land (Nat.shiftRight TERMS (Nat.mul 9 t)) 511
    let d := brData SS ACT asg recs dom a nt sl sym cdir t
    d.1 && kidsOk (fun asg' recs' k => check fuel TERMS SS (Nat.xor ACT (Nat.shiftLeft 1 t)) asg' recs' dom k)
      a asg d.2.1 d.2.2 kids

/-- a leaf (at most 31 first factors) is refuted on the domain mask `dom` by `c` -/
def leaf (terms : List Nat) (dom : Nat) (c : Cert) : Bool :=
  Nat.ble terms.length 31 && check 64 (packT terms) (mkSS terms) (Nat.pred (Nat.shiftLeft 1 terms.length)) [] [] dom c

/-! ## The stream format v5c-334: leaves and certificates in one natural number, read from the low end
* batch: `1` + leaf record, or `0` + 24-bit length `L` + left batch (`L` bits) + right batch;
* leaf record: `n` (6 bits, n ≤ 31), the `n` first factors (9 bits each), dom mode (2 bits, exactly 01), the 512-bit
  dom mask, then the certificate in preorder; nothing nonzero may follow the certificate;
* node: tag `0` + `X` (9 bits) = `over X`; tag `1` + `t` (5) + `sym` (1) + `cdir` (1) + `#nt` (4) + `nt` (9 each) +
  `#sl` (3) + `sl` (9 each), then one subtree per candidate (the checker computes the candidates). -/

@[inline] def rd (k S : Nat) : Nat := Nat.land S (Nat.pred (Nat.shiftLeft 1 k))
@[inline] def sk (k S : Nat) : Nat := Nat.shiftRight S k

/-- `m` 9-bit values and the rest of the stream -/
def rdList : Nat → Nat → List Nat × Nat
  | 0, S => ([], S)
  | m + 1, S => let r := rdList m (sk 9 S); (rd 9 S :: r.1, r.2)

/-- the subtrees of the candidates, read in order from the stream -/
def kidsS (f : Asg → List Rec → Nat → Bool × Nat) (a : Nat) (asg : Asg) (allr : List Rec) :
    List (Nat × Nat) → Nat → Bool × Nat
  | [], S => (true, S)
  | p :: cs, S =>
    let r := f ((a, p.1, p.2) :: asg) (updRecs a p.1 p.2 allr) S
    cond r.1 (kidsS f a asg allr cs r.2) (false, r.2)

/-- the checker on a stream at fuel `n`: the verdict and the rest of the stream -/
def checkS : Nat → Nat → Nat → Nat → Asg → List Rec → Nat → Nat → Bool × Nat
  | 0, _, _, _, _, _, _, S => (false, S)
  | fuel + 1, TERMS, SS, ACT, asg, recs, dom, S =>
    cond (Nat.beq (rd 1 S) 0)
      (let X := rd 9 (sk 1 S)
       let s := elim (resC X asg)
       (bit dom X && elimOk s && Nat.blt (ucnt SS ACT X) s.rk, sk 10 S))
      (let S1 := sk 1 S
       let t := rd 5 S1
       let sym := Nat.beq (rd 1 (sk 5 S1)) 1
       let cdir := Nat.beq (rd 1 (sk 6 S1)) 1
       let ntr := rdList (rd 4 (sk 7 S1)) (sk 11 S1)
       let slr := rdList (rd 3 ntr.2) (sk 3 ntr.2)
       let a := Nat.land (Nat.shiftRight TERMS (Nat.mul 9 t)) 511
       let d := brData SS ACT asg recs dom a ntr.1 slr.1 sym cdir t
       let kr := kidsS (fun asg' recs' S' => checkS fuel TERMS SS (Nat.xor ACT (Nat.shiftLeft 1 t)) asg' recs' dom S')
         a asg d.2.1 d.2.2 slr.2
       (d.1 && kr.1, kr.2))

/-- the hit table from packed first factors -/
def mkSSP (T : Nat) : Nat → Nat
  | 0 => 0
  | s + 1 => Nat.lor (mkSSP T s) (Nat.shiftLeft (dep32 (Nat.land (Nat.shiftRight T (Nat.mul 9 s)) 511)) s)

/-- one leaf record -/
def leafS (R : Nat) : Bool :=
  let n := rd 6 R
  let T := rd (Nat.mul 9 n) (sk 6 R)
  let R1 := sk (Nat.add 6 (Nat.mul 9 n)) R
  let r := checkS 64 T (mkSSP T n) (Nat.pred (Nat.shiftLeft 1 n)) [] [] (rd 512 (sk 2 R1)) (sk 514 R1)
  Nat.ble n 31 && Nat.beq (rd 2 R1) 1 && r.1 && Nat.beq r.2 0

/-- a batch tree of leaf records -/
def batch : Nat → Nat → Bool
  | 0, _ => false
  | fuel + 1, D => cond (Nat.beq (rd 1 D) 1) (leafS (sk 1 D))
      (let L := rd 24 (sk 1 D)
       batch fuel (rd L (sk 25 D)) && batch fuel (sk (Nat.add 25 L) D))

end B334.BC
