  have h0 : IPChk.allR (Pts.glueIB K40.lits KW_40) 0 2 = true := kg_40_0
  have h1 : IPChk.allR (Pts.glueIB K40.lits KW_40) 0 4 = true := IPChk.allR_join (Pts.glueIB K40.lits KW_40) 0 2 2 h0 kg_40_2
  exact h1

end B334.E1x.Pts.S708
