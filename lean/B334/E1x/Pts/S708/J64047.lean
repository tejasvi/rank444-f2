import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 64047 … 64050 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J64047 "../data/j64047.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_64047 (k : Nat) : List Nat :=
  cond (Nat.blt k 64049) (cond (Nat.blt k 64048) ([J64047.L0]) ([J64047.L1])) (cond (Nat.blt k 64050) ([J64047.L2]) ([J64047.L3]))
def JW_64047 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 64049) (cond (Nat.blt k 64048) ([[]]) ([[]])) (cond (Nat.blt k 64050) ([[]]) ([[]]))

end

theorem jr_64047 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_64047 k) (JW_64047 k)) 64047 4 = true := by
  decide +kernel

theorem jm_64047 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_64047 k) (JW_64047 k)) 64047 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_64047 k) (JW_64047 k)) 64047 4 = true := jr_64047
  exact h0

end B334.E1x.Pts.S708
