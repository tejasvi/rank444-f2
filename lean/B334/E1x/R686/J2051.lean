import B334.E1x.R686.Data
import B334.E1x.R686.HT
import B334.E1x.GJ.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 2051 … 2053 of `R686` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.R686.J2051 "../runs/runmulti2/R686_j2051.bin"

namespace B334.E1x.R686

noncomputable section

def JL_2051 (k : Nat) : List Nat :=
  cond (Nat.blt k 2052) ([J2051.L0]) (cond (Nat.blt k 2053) ([J2051.L1]) ([J2051.L2]))
def JW_2051 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2052) ([[]]) (cond (Nat.blt k 2053) ([[]]) ([[]]))

end

theorem jr_2051 : IPChk.allR (fun k => GJ.jobB C sl UB UBR (HT.entry k) (JL_2051 k) (JW_2051 k)) 2051 3 = true := by
  decide +kernel

end B334.E1x.R686
