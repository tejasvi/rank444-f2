set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 80958 … 80959 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J80958 "../data/j80958.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_80958 (k : Nat) : List Nat :=
  cond (Nat.blt k 80959) ([J80958.L0]) ([J80958.L1])
def JW_80958 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 80959) ([[]]) ([[]])

end

theorem jr_80958 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_80958 k) (JW_80958 k)) 80958 2 = true := by
  decide +kernel

theorem jm_80958 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_80958 k) (JW_80958 k)) 80958 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_80958 k) (JW_80958 k)) 80958 2 = true := jr_80958
  exact h0

end B334.E1x.Pts.S708
