/-! # Jobs 2191 … 2195 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J2191 "../data/j2191.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_2191 (k : Nat) : List Nat :=
  cond (Nat.blt k 2193) (cond (Nat.blt k 2192) ([J2191.L0]) ([J2191.L1])) (cond (Nat.blt k 2194) ([J2191.L2]) (cond (Nat.blt k 2195) ([J2191.L3]) ([J2191.L4])))
def JW_2191 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 2193) (cond (Nat.blt k 2192) ([[]]) ([[]])) (cond (Nat.blt k 2194) ([[]]) (cond (Nat.blt k 2195) ([[]]) ([[]])))

end

theorem jr_2191 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2191 k) (JW_2191 k)) 2191 5 = true := by
  decide +kernel

theorem jm_2191 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2191 k) (JW_2191 k)) 2191 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_2191 k) (JW_2191 k)) 2191 5 = true := jr_2191
  exact h0

end B334.E1x.Pts.S708
