import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 25547 … 25549 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J25547 "../data/j25547.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_25547 (k : Nat) : List Nat :=
  cond (Nat.blt k 25548) ([J25547.L0]) (cond (Nat.blt k 25549) ([J25547.L1]) ([J25547.L2]))
def JW_25547 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 25548) ([[]]) (cond (Nat.blt k 25549) ([[]]) ([[]]))

end

theorem jr_25547 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25547 k) (JW_25547 k)) 25547 3 = true := by
  decide +kernel

theorem jm_25547 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25547 k) (JW_25547 k)) 25547 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_25547 k) (JW_25547 k)) 25547 3 = true := jr_25547
  exact h0

end B334.E1x.Pts.S708
