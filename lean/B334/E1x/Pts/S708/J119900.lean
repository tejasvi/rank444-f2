import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 119900 … 119903 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J119900 "../data/j119900.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_119900 (k : Nat) : List Nat :=
  cond (Nat.blt k 119902) (cond (Nat.blt k 119901) ([J119900.L0]) ([J119900.L1])) (cond (Nat.blt k 119903) ([J119900.L2]) ([J119900.L3]))
def JW_119900 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 119902) (cond (Nat.blt k 119901) ([[]]) ([[]])) (cond (Nat.blt k 119903) ([[]]) ([[]]))

end

theorem jr_119900 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_119900 k) (JW_119900 k)) 119900 4 = true := by
  decide +kernel

theorem jm_119900 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_119900 k) (JW_119900 k)) 119900 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_119900 k) (JW_119900 k)) 119900 4 = true := jr_119900
  exact h0

end B334.E1x.Pts.S708
