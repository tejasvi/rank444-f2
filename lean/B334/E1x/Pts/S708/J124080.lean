import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 124080 … 124080 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J124080 "../data/j124080.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_124080 (k : Nat) : List Nat :=
  [J124080.L0]
def JW_124080 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_124080 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_124080 k) (JW_124080 k)) 124080 1 = true := by
  decide +kernel

theorem jm_124080 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_124080 k) (JW_124080 k)) 124080 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_124080 k) (JW_124080 k)) 124080 1 = true := jr_124080
  exact h0

end B334.E1x.Pts.S708
