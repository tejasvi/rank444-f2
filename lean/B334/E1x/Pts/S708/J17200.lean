import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 17200 … 17200 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J17200 "../data/j17200.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_17200 (k : Nat) : List Nat :=
  [J17200.L0]
def JW_17200 (k : Nat) : List (List Nat) :=
  [[]]

end

theorem jr_17200 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_17200 k) (JW_17200 k)) 17200 1 = true := by
  decide +kernel

theorem jm_17200 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_17200 k) (JW_17200 k)) 17200 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_17200 k) (JW_17200 k)) 17200 1 = true := jr_17200
  exact h0

end B334.E1x.Pts.S708
