import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 5066 … 5067 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J5066 "../data/j5066.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_5066 (k : Nat) : List Nat :=
  cond (Nat.blt k 5067) ([J5066.L0]) ([J5066.L1])
def JW_5066 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 5067) ([[]]) ([[]])

end

theorem jr_5066 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_5066 k) (JW_5066 k)) 5066 2 = true := by
  decide +kernel

end B334.E1x.Pts.S707
