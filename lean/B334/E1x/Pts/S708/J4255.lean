import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 4255 … 4257 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J4255 "../data/j4255.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_4255 (k : Nat) : List Nat :=
  cond (Nat.blt k 4256) ([J4255.L0]) (cond (Nat.blt k 4257) ([J4255.L1]) ([J4255.L2]))
def JW_4255 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 4256) ([[]]) (cond (Nat.blt k 4257) ([[]]) ([[]]))

end

theorem jr_4255 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_4255 k) (JW_4255 k)) 4255 3 = true := by
  decide +kernel

theorem jm_4255 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_4255 k) (JW_4255 k)) 4255 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_4255 k) (JW_4255 k)) 4255 3 = true := jr_4255
  exact h0

end B334.E1x.Pts.S708
