import B334.E1x.Pts.S707.Ctx
import B334.E1x.Pts.S707.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 1735 … 1737 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J1735 "../data/j1735.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_1735 (k : Nat) : List Nat :=
  cond (Nat.blt k 1736) ([J1735.L0]) (cond (Nat.blt k 1737) ([J1735.L1]) ([J1735.L2]))
def JW_1735 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 1736) ([[]]) (cond (Nat.blt k 1737) ([[]]) ([[]]))

end

theorem jr_1735 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_1735 k) (JW_1735 k)) 1735 3 = true := by
  decide +kernel

end B334.E1x.Pts.S707
