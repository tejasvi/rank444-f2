import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 65523 … 65526 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J65523 "../data/j65523.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_65523 (k : Nat) : List Nat :=
  cond (Nat.blt k 65525) (cond (Nat.blt k 65524) ([J65523.L0]) ([J65523.L1])) (cond (Nat.blt k 65526) ([J65523.L2]) ([J65523.L3]))
def JW_65523 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 65525) (cond (Nat.blt k 65524) ([[]]) ([[]])) (cond (Nat.blt k 65526) ([[]]) ([[]]))

end

theorem jr_65523 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_65523 k) (JW_65523 k)) 65523 4 = true := by
  decide +kernel

theorem jm_65523 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_65523 k) (JW_65523 k)) 65523 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_65523 k) (JW_65523 k)) 65523 4 = true := jr_65523
  exact h0

end B334.E1x.Pts.S708
