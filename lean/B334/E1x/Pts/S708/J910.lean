import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 910 … 914 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J910 "../data/j910.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_910 (k : Nat) : List Nat :=
  cond (Nat.blt k 912) (cond (Nat.blt k 911) ([J910.L0]) ([J910.L1])) (cond (Nat.blt k 913) ([J910.L2]) (cond (Nat.blt k 914) ([J910.L3]) ([J910.L4])))
def JW_910 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 912) (cond (Nat.blt k 911) ([[]]) ([[]])) (cond (Nat.blt k 913) ([[]]) (cond (Nat.blt k 914) ([[]]) ([[]])))

end

theorem jr_910 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_910 k) (JW_910 k)) 910 5 = true := by
  decide +kernel

theorem jm_910 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_910 k) (JW_910 k)) 910 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_910 k) (JW_910 k)) 910 5 = true := jr_910
  exact h0

end B334.E1x.Pts.S708
