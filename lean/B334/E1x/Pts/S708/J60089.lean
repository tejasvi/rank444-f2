import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 60089 … 60091 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J60089 "../data/j60089.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_60089 (k : Nat) : List Nat :=
  cond (Nat.blt k 60090) ([J60089.L0]) (cond (Nat.blt k 60091) ([J60089.L1]) ([J60089.L2]))
def JW_60089 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 60090) ([[]]) (cond (Nat.blt k 60091) ([[]]) ([[]]))

end

theorem jr_60089 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_60089 k) (JW_60089 k)) 60089 3 = true := by
  decide +kernel

theorem jm_60089 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_60089 k) (JW_60089 k)) 60089 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_60089 k) (JW_60089 k)) 60089 3 = true := jr_60089
  exact h0

end B334.E1x.Pts.S708
