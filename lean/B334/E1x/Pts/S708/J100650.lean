def JW_100650 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 100652) (cond (Nat.blt k 100651) ([[]]) ([[]])) (cond (Nat.blt k 100653) ([[]]) (cond (Nat.blt k 100654) ([[]]) ([[]])))

end

theorem jr_100650 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_100650 k) (JW_100650 k)) 100650 5 = true := by
  decide +kernel

theorem jm_100650 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_100650 k) (JW_100650 k)) 100650 5 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_100650 k) (JW_100650 k)) 100650 5 = true := jr_100650
  exact h0

