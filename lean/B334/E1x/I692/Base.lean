import B334.E1x.I692.Data
import B334.E1x.RTE
import B334.E1x.ClsTab
import B334.E1x.IPChk
import B334.Tab2.Data

/-! # The per-slot check of `I692` (generated by a script): the entry's dual vectors lie in the domain, the entry
passes `RT.entryOK` against the class table `ClsTab.CL`, and its class is one the run's hypothesis covers (`c < nCls`
and of larger dimension than the run's class 692, as in `RunHyp`, `Tab2/Induct.lean`). -/

namespace B334.E1x.I692

noncomputable def entF (i : Nat) : Bool :=
  SlotG.dualIn DOM (tab i) && RT.entryOK R ClsTab.CL (tab i) && Nat.blt (RT.eCls (tab i)) Tab2.nCls &&
    Nat.blt (Tab2.basisOf 692).length (Tab2.basisOf (RT.eCls (tab i))).length

end B334.E1x.I692
