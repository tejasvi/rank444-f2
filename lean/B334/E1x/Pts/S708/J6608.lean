import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 6608 … 6609 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J6608 "../data/j6608.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_6608 (k : Nat) : List Nat :=
  cond (Nat.blt k 6609) ([J6608.L0]) ([J6608.L1])
def JW_6608 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 6609) ([[]]) ([[]])

end

theorem jr_6608 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_6608 k) (JW_6608 k)) 6608 2 = true := by
  decide +kernel

theorem jm_6608 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_6608 k) (JW_6608 k)) 6608 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_6608 k) (JW_6608 k)) 6608 2 = true := jr_6608
  exact h0

end B334.E1x.Pts.S708
