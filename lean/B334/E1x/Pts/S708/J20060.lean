import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 20060 … 20063 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J20060 "../data/j20060.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_20060 (k : Nat) : List Nat :=
  cond (Nat.blt k 20062) (cond (Nat.blt k 20061) ([J20060.L0]) ([J20060.L1])) (cond (Nat.blt k 20063) ([J20060.L2]) ([J20060.L3]))
def JW_20060 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 20062) (cond (Nat.blt k 20061) ([[]]) ([[]])) (cond (Nat.blt k 20063) ([[]]) ([[]]))

end

theorem jr_20060 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_20060 k) (JW_20060 k)) 20060 4 = true := by
  decide +kernel

theorem jm_20060 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_20060 k) (JW_20060 k)) 20060 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_20060 k) (JW_20060 k)) 20060 4 = true := jr_20060
  exact h0

end B334.E1x.Pts.S708
