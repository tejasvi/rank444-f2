#e1lits B334.E1x.Pts.S708.J128502 "../data/j128502.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_128502 (k : Nat) : List Nat :=
  [J128502.L0]
def JW_128502 (k : Nat) : List (List Nat) :=
