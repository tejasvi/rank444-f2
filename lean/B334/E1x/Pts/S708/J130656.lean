def JL_130656 (k : Nat) : List Nat :=
  cond (Nat.blt k 130658) (cond (Nat.blt k 130657) ([J130656.L0]) ([J130656.L1])) (cond (Nat.blt k 130659) ([J130656.L2]) ([J130656.L3]))
def JW_130656 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 130658) (cond (Nat.blt k 130657) ([[]]) ([[]])) (cond (Nat.blt k 130659) ([[]]) ([[]]))

end

theorem jr_130656 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_130656 k) (JW_130656 k)) 130656 4 = true := by
  decide +kernel

theorem jm_130656 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_130656 k) (JW_130656 k)) 130656 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_130656 k) (JW_130656 k)) 130656 4 = true := jr_130656
