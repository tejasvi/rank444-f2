/-! # Jobs 992 … 993 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J992 "../data/j992.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_992 (k : Nat) : List Nat :=
  cond (Nat.blt k 993) ([J992.L0]) ([J992.L1])
def JW_992 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 993) ([[]]) ([[]])

end

theorem jr_992 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_992 k) (JW_992 k)) 992 2 = true := by
  decide +kernel

end B334.E1x.Pts.S707
