import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 71399 … 71401 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J71399 "../data/j71399.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_71399 (k : Nat) : List Nat :=
  cond (Nat.blt k 71400) ([J71399.L0]) (cond (Nat.blt k 71401) ([J71399.L1]) ([J71399.L2]))
def JW_71399 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 71400) ([[]]) (cond (Nat.blt k 71401) ([[]]) ([[]]))

end

theorem jr_71399 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_71399 k) (JW_71399 k)) 71399 3 = true := by
  decide +kernel

theorem jm_71399 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_71399 k) (JW_71399 k)) 71399 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_71399 k) (JW_71399 k)) 71399 3 = true := jr_71399
  exact h0

end B334.E1x.Pts.S708
