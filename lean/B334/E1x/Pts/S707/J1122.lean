/-! # Jobs 1122 … 1122 of `S707` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S707.J1122 "../data/j1122.bin"

namespace B334.E1x.Pts.S707

noncomputable section

def JL_1122 (k : Nat) : List Nat :=
  [J1122.L0, J1122.L1, J1122.L2]
def JW_1122 (k : Nat) : List (List Nat) :=
  [[1, 2], [], []]

end

theorem jr_1122 : IPChk.allR (fun k => Pts.jobB CL Pts.H707.sl Pts.H707.UB Pts.H707.UBR (HT.entry k) (JL_1122 k) (JW_1122 k)) 1122 1 = true := by
  decide +kernel

end B334.E1x.Pts.S707
