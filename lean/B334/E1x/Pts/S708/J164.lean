import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 164 … 165 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J164 "../data/j164.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_164 (k : Nat) : List Nat :=
  cond (Nat.blt k 165) ([J164.L0]) ([J164.L1])
def JW_164 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 165) ([[]]) ([[]])

end

theorem jr_164 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_164 k) (JW_164 k)) 164 2 = true := by
  decide +kernel

theorem jm_164 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_164 k) (JW_164 k)) 164 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_164 k) (JW_164 k)) 164 2 = true := jr_164
  exact h0

end B334.E1x.Pts.S708
