import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 30012 … 30015 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J30012 "../data/j30012.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_30012 (k : Nat) : List Nat :=
  cond (Nat.blt k 30014) (cond (Nat.blt k 30013) ([J30012.L0]) ([J30012.L1])) (cond (Nat.blt k 30015) ([J30012.L2]) ([J30012.L3]))
def JW_30012 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 30014) (cond (Nat.blt k 30013) ([[]]) ([[]])) (cond (Nat.blt k 30015) ([[]]) ([[]]))

end

theorem jr_30012 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_30012 k) (JW_30012 k)) 30012 4 = true := by
  decide +kernel

theorem jm_30012 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_30012 k) (JW_30012 k)) 30012 4 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_30012 k) (JW_30012 k)) 30012 4 = true := jr_30012
  exact h0

end B334.E1x.Pts.S708
