import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 108037 … 108039 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J108037 "../data/j108037.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_108037 (k : Nat) : List Nat :=
  cond (Nat.blt k 108038) ([J108037.L0]) (cond (Nat.blt k 108039) ([J108037.L1]) ([J108037.L2]))
def JW_108037 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 108038) ([[]]) (cond (Nat.blt k 108039) ([[]]) ([[]]))

end

theorem jr_108037 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_108037 k) (JW_108037 k)) 108037 3 = true := by
  decide +kernel

theorem jm_108037 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_108037 k) (JW_108037 k)) 108037 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_108037 k) (JW_108037 k)) 108037 3 = true := jr_108037
  exact h0

end B334.E1x.Pts.S708
