/-! # Jobs 90995 … 90996 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J90995 "../data/j90995.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_90995 (k : Nat) : List Nat :=
  cond (Nat.blt k 90996) ([J90995.L0]) ([J90995.L1])
def JW_90995 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 90996) ([[]]) ([[]])

end

theorem jr_90995 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_90995 k) (JW_90995 k)) 90995 2 = true := by
  decide +kernel

theorem jm_90995 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_90995 k) (JW_90995 k)) 90995 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_90995 k) (JW_90995 k)) 90995 2 = true := jr_90995
  exact h0

end B334.E1x.Pts.S708
