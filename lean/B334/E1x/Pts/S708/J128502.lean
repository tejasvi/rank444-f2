end

theorem jr_128502 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_128502 k) (JW_128502 k)) 128502 1 = true := by
  decide +kernel

theorem jm_128502 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_128502 k) (JW_128502 k)) 128502 1 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_128502 k) (JW_128502 k)) 128502 1 = true := jr_128502
  exact h0

end B334.E1x.Pts.S708
