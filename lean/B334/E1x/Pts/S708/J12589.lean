/-! # Jobs 12589 … 12591 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J12589 "../data/j12589.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_12589 (k : Nat) : List Nat :=
  cond (Nat.blt k 12590) ([J12589.L0]) (cond (Nat.blt k 12591) ([J12589.L1]) ([J12589.L2]))
def JW_12589 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 12590) ([[]]) (cond (Nat.blt k 12591) ([[]]) ([[]]))

end

theorem jr_12589 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12589 k) (JW_12589 k)) 12589 3 = true := by
  decide +kernel

theorem jm_12589 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12589 k) (JW_12589 k)) 12589 3 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_12589 k) (JW_12589 k)) 12589 3 = true := jr_12589
  exact h0

end B334.E1x.Pts.S708
