import B334.E1x.Pts.S708.Ctx
import B334.E1x.Pts.S708.HT
import B334.E1x.Pts.ChkB

set_option maxHeartbeats 0
set_option maxRecDepth 100000

/-! # Jobs 9840 … 9841 of `S708` (generated by a script; core Lean, `decide +kernel`): each job's
pieces pass, are glued inside, and its first piece has the job's header `HT.entry k` -/

#e1lits B334.E1x.Pts.S708.J9840 "../data/j9840.bin"

namespace B334.E1x.Pts.S708

noncomputable section

def JL_9840 (k : Nat) : List Nat :=
  cond (Nat.blt k 9841) ([J9840.L0]) ([J9840.L1])
def JW_9840 (k : Nat) : List (List Nat) :=
  cond (Nat.blt k 9841) ([[]]) ([[]])

end

theorem jr_9840 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_9840 k) (JW_9840 k)) 9840 2 = true := by
  decide +kernel

theorem jm_9840 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_9840 k) (JW_9840 k)) 9840 2 = true := by
  have h0 : IPChk.allR (fun k => Pts.jobB CL Pts.H708.sl Pts.H708.UB Pts.H708.UBR (HT.entry k) (JL_9840 k) (JW_9840 k)) 9840 2 = true := jr_9840
  exact h0

end B334.E1x.Pts.S708
